------------------------------------------------------------
ENG.breakout = function(w, g)
	local cfg, W, H = g.cfg, g.W, g.H
	local pf, pw, ph = spr(w, "paddle", 5 + g.skin, skc(g))
	g.mkPadLR()
	local py, px = H - ph - 14, W / 2
	g.lives = 3 + g.extra + (g.skin >= 2 and 1 or 0)
	g.setLives()
	local r = 6
	local bf = new("Frame", { Size = UDim2.fromOffset(r * 2, r * 2), BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0 }, w)
	new("UICorner", { CornerRadius = UDim.new(1, 0) }, bf)
	local bx, by, vx, vy = W / 2, py - r - 2, 0, 0
	local launched, launchT = false, 1.0
	local level, score, spd = 1, 0, 250
	local bricks = {}
	local rowCols = { C(225, 60, 60), C(245, 140, 40), C(245, 205, 50), C(70, 190, 90), C(70, 120, 235) }

	local function build()
		for _, b in ipairs(bricks) do b.f:Destroy() end
		bricks = {}
		local cols = 9
		local bwid = math.floor((W - 20) / cols)
		local bh = 16
		for rr = 1, 5 do
			for cc = 1, cols do
				local x, y = 10 + (cc - 1) * bwid, 40 + (rr - 1) * (bh + 2)
				local f = new("Frame", { Position = UDim2.fromOffset(x, y), Size = UDim2.fromOffset(bwid - 2, bh), BackgroundColor3 = rowCols[rr], BorderSizePixel = 0 }, w)
				new("UIStroke", { Color = C(0, 0, 0), Thickness = 1.5, LineJoinMode = Enum.LineJoinMode.Miter }, f)
				bricks[#bricks + 1] = { f = f, x = x, y = y, w = bwid - 2, h = bh }
			end
		end
	end
	build()

	local function launch()
		if launched then return end
		launched = true
		local a = math.rad(math.random(-30, 30))
		vx, vy = spd * math.sin(a), -spd * math.cos(a)
	end
	g.onPress(launch)

	g.tick(function(dt)
		local dir = g.dir()
		if dir ~= 0 then
			px = px + dir * 400 * dt
		elseif not g.ptrLock then
			px = px + math.clamp(g.ptr.x - px, -450 * dt, 450 * dt)
		end
		px = math.clamp(px, pw / 2, W - pw / 2)
		pf.Position = UDim2.fromOffset(px - pw / 2, py)

		if not launched then
			bx, by = px, py - r - 2
			launchT = launchT - dt
			if launchT <= 0 then launch() end
		else
			local s = math.sqrt(vx * vx + vy * vy)
			if s > 0 then
				vx, vy = vx / s * spd, vy / s * spd
			end
			bx = bx + vx * dt
			by = by + vy * dt
			if bx < r then bx, vx = r, math.abs(vx) elseif bx > W - r then bx, vx = W - r, -math.abs(vx) end
			if by < r then by, vy = r, math.abs(vy) end
			if vy > 0 and by + r >= py and by + r <= py + ph + 8 and bx > px - pw / 2 - r and bx < px + pw / 2 + r then
				local off = math.clamp((bx - px) / (pw / 2), -0.9, 0.9)
				local a = off * 1.1
				vx, vy = spd * math.sin(a), -spd * math.cos(a)
				by = py - r
			end
			for i = #bricks, 1, -1 do
				local b = bricks[i]
				if bx + r > b.x and bx - r < b.x + b.w and by + r > b.y and by - r < b.y + b.h then
					local ox = math.min(bx + r - b.x, b.x + b.w - (bx - r))
					local oy = math.min(by + r - b.y, b.y + b.h - (by - r))
					if ox < oy then vx = -vx else vy = -vy end
					b.f:Destroy()
					table.remove(bricks, i)
					score = score + 1
					g.setScore(score)
					break
				end
			end
			if by > H + 10 then
				g.lives = g.lives - 1
				g.setLives()
				if g.lives <= 0 then
					g.finish(score)
					return
				end
				launched, launchT, vx, vy = false, 0.8, 0, 0
			end
		end
		bf.Position = UDim2.fromOffset(bx - r, by - r)

		if #bricks == 0 then
			level = level + 1
			spd = math.min(420, 250 + level * 25)
			score = score + 20
			g.setScore(score)
			build()
			launched, launchT, vx, vy = false, 0.8, 0, 0
		end
	end)
end

