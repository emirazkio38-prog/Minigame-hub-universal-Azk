	local mage = cfg.mage == true
	local foes = cfg.foes
	g.lives = 1 + g.extra + (g.skin >= 3 and 1 or 0)
	g.setLives()
	local gyR = ground(w, g, 64)

	local hero = {
		lvl = 1, xp = 0, maxhp = 60 + 10 * g.skin, atk = 9 + 2 * g.skin + 3 * g.weapon,
