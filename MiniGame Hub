ENG.lane = function(w, g)
	local cfg, W, H = g.cfg, g.W, g.H
	local cs, top = 34, 30
	local rows = math.min(11, math.max(6, math.floor((H - top) / cs)))
	local baseY = H - cs
	g.mkPad4()
	g.lives = 3 + g.extra + (g.skin >= 2 and 1 or 0)
	g.setLives()
	local pbox, pw, ph = spr(w, cfg.spr, 3, skc(g))
	pbox.ZIndex = 6
	local lanes, bg = {}, {}
	local lvl, score = 1, 0
	local pr, fxp, best = 0, W / 2 - pw / 2, 0
	local inv, hopT = 0, 0
	local prev = { l = false, r = false, u = false, d = false }
	local CARCOL = { COL.r, COL.b, COL.y, COL.o, COL.m, COL.c }
	local function laneY(r) return baseY - r * cs end

	local function buildLanes()
		for _, o in ipairs(bg) do o:Destroy() end
		bg, lanes = {}, {}
		local sp = 1 + (lvl - 1) * 0.1
		local roadN = math.floor((rows - 2) / 2)
		for r = 0, rows - 1 do
			local kind = "safe"
			if r > 0 and r < rows - 1 then
				if cfg.river then
					if r <= roadN then
						kind = "road"
					elseif r == roadN + 1 then
						kind = "safe"
					else
						kind = "water"
					end
				elseif math.random() < 0.82 then
					kind = "road"
				end
			end
			local bcol = C(85, 185, 85)
			if kind == "road" then bcol = C(70, 70, 82) elseif kind == "water" then bcol = C(50, 110, 220) end
			local bgf = new("Frame", {
				Position = UDim2.fromOffset(0, laneY(r)), Size = UDim2.fromOffset(W, cs),
				BackgroundColor3 = bcol, BorderSizePixel = 0, ZIndex = 1,
			}, w)
			bg[#bg + 1] = bgf
			local ln = { kind = kind, dir = math.random(0, 1) * 2 - 1, items = {}, speed = 0 }
			lanes[r] = ln
			if kind ~= "safe" then
				ln.speed = (45 + math.random(0, 45) + r * 4) * sp * (cfg.fast and 1.35 or 1)
				local x = math.random(0, 60)
				while x < W + 60 do
					local f, iw, ih
					if kind == "road" then
						local truck = math.random() < 0.3
						f, iw, ih = spr(w, truck and "truck" or "car", 3, CARCOL[math.random(#CARCOL)], ln.dir < 0)
					else
						iw, ih = cs * math.random(2, 4), cs - 10
						f = new("Frame", { Size = UDim2.fromOffset(iw, ih), BackgroundColor3 = C(150, 100, 50), BorderSizePixel = 0 }, w)
						new("UIStroke", { Color = Color3.new(0, 0, 0), Thickness = 2, LineJoinMode = Enum.LineJoinMode.Miter }, f)
					end
					f.ZIndex = 2
					bg[#bg + 1] = f
					ln.items[#ln.items + 1] = { f = f, x = x, w = iw, h = ih }
					x = x + iw + (kind == "road" and math.random(110, 240) or math.random(60, 120))
				end
			end
		end
	end
	buildLanes()

	local function die()
		g.lives = g.lives - 1
		g.setLives()
		if g.lives <= 0 then
			g.finish(score)
			return
		end
		pr, fxp, best, inv = 0, W / 2 - pw / 2, 0, 1.2
	end

	g.tick(function(dt)
		inv = math.max(0, inv - dt)
		hopT = hopT - dt
		for r = 1, rows - 2 do
			local ln = lanes[r]
			if ln and ln.kind ~= "safe" then
				for _, it in ipairs(ln.items) do
					it.x = it.x + ln.dir * ln.speed * dt
					if ln.dir > 0 and it.x > W + 10 then
						it.x = -it.w - math.random(0, 80)
					elseif ln.dir < 0 and it.x < -it.w - 10 then
						it.x = W + math.random(0, 80)
					end
					it.f.Position = UDim2.fromOffset(it.x, laneY(r) + (cs - it.h) / 2)
				end
			end
		end

		-- loncat: D-Pad / stik / WASD / tombol layar
		local l, r2, u, d = g.dir4()
		if hopT <= 0 then
			local hx, hy = 0, 0
			if l and not prev.l then
				hx = -1
			elseif r2 and not prev.r then
				hx = 1
			elseif u and not prev.u then
				hy = 1
			elseif d and not prev.d then
				hy = -1
			end
			if hx ~= 0 or hy ~= 0 then
				hopT = 0.09
				fxp = math.clamp(fxp + hx * cs, 0, W - pw)
				pr = math.clamp(pr + hy, 0, rows - 1)
				if pr > best then
					best = pr
					score = score + 1
					g.setScore(score)
				end
			end
		end
		prev.l, prev.r, prev.u, prev.d = l, r2, u, d

		local ln = lanes[pr]
		local hit = false
		if ln and inv <= 0 then
			if ln.kind == "road" then
				for _, it in ipairs(ln.items) do
					if fxp + pw - 5 > it.x + 3 and fxp + 5 < it.x + it.w - 3 then hit = true end
				end
			elseif ln.kind == "water" then
				local onLog = nil
				for _, it in ipairs(ln.items) do
					if fxp + pw / 2 > it.x and fxp + pw / 2 < it.x + it.w then
						onLog = it
						break
					end
				end
				if onLog then
					fxp = fxp + ln.dir * ln.speed * dt
					if fxp < -pw / 2 or fxp > W - pw / 2 then hit = true end
				else
					hit = true
				end
			end
		end
		if hit then
			die()
			if not g.alive then return end
		end

		if pr >= rows - 1 then
			score = score + 5
			g.setScore(score)
			lvl = lvl + 1
			pr, fxp, best = 0, W / 2 - pw / 2, 0
			buildLanes()
		end

		pbox.Position = UDim2.fromOffset(fxp, laneY(pr) + (cs - ph) / 2)
		pbox.Visible = inv <= 0 or math.floor(inv * 10) % 2 == 0
	end)
end

