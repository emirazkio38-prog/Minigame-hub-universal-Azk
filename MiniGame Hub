	local stage, score = 1, 0
	local en = nil
	local st, t, applied = "menu", 0, false
	local act, defend, sel = 0, false, 1
	local shakeT, heroShake, lunge, eLunge = 0, 0, 0, 0
	local popups = {}
	local nav = { l = false, r = false, ok = false, num = { false, false, false, false } }

