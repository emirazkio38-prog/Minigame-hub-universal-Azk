-- ENGINE: MERGE BALL (jatuhkan bola, bola kembar menyatu jadi lebih besar)
------------------------------------------------------------
ENG.merge = function(w, g)
	local W, H = g.W, g.H
	g.noLives = true
	g.setLives()
	local cw = math.floor(math.min(W * 0.48, 260))
	local chh = H - 66
	local cx0 = math.floor((W - cw) / 2)
	local top = 52
	local floorY = top + chh
	local r1 = math.max(8, cw * 0.05)
	local NL = 10
	local function rad(l) return r1 * (1.23 ^ (l - 1)) end
	local COLS = {
		C(235, 90, 90), C(250, 150, 70), C(250, 215, 70), C(150, 210, 80), C(70, 195, 140),
		C(70, 170, 230), C(100, 110, 235), C(170, 100, 230), C(235, 100, 190), C(250, 245, 200),
	}
	local VAL = { 1, 3, 6, 10, 15, 21, 28, 36, 45, 100 }

	local cont = new("Frame", { Position = UDim2.fromOffset(cx0, top), Size = UDim2.fromOffset(cw, chh), BackgroundColor3 = C(30, 36, 70), BackgroundTransparency = 0.1, BorderSizePixel = 0 }, w)
	new("UIStroke", { Color = Color3.new(1, 1, 1), Thickness = 3, LineJoinMode = Enum.LineJoinMode.Miter }, cont)
	local dangerY = 44 -- garis bahaya (dalam kontainer)
	local dl = new("Frame", { Position = UDim2.fromOffset(0, dangerY), Size = UDim2.fromOffset(cw, 2), BackgroundColor3 = C(255, 90, 90), BorderSizePixel = 0 }, cont)
	dl.BackgroundTransparency = 0.4

	local balls = {}
	local score = 0
	local nextLevel = math.random(1, 3)
	local curLevel = math.random(1, 3)
	local dropX = cw / 2
	local cooldown = 0
	local aiming = false
	local over = false
	local dangerT = 0

	local function mkBall(l, x, y)
		local r = rad(l)
		local f = new("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Size = UDim2.fromOffset(r * 2, r * 2), BackgroundColor3 = COLS[l], BorderSizePixel = 0 }, cont)
		new("UICorner", { CornerRadius = UDim.new(1, 0) }, f)
		new("UIStroke", { Color = Color3.new(0, 0, 0), Thickness = 2, Transparency = 0.4 }, f)
		local sh = new("Frame", { Position = UDim2.fromScale(0.18, 0.14), Size = UDim2.fromScale(0.3, 0.2), BackgroundColor3 = Color3.new(1, 1, 1), BackgroundTransparency = 0.55, BorderSizePixel = 0 }, f)
		new("UICorner", { CornerRadius = UDim.new(1, 0) }, sh)
		local nl = label(f, tostring(l), math.max(8, math.floor(r * 0.9)), UDim2.fromScale(0, 0), UDim2.fromScale(1, 1), C(30, 30, 40), Enum.TextXAlignment.Center)
		nl.TextYAlignment = Enum.TextYAlignment.Center
		return { f = f, l = l, x = x, y = y, vx = 0, vy = 0, r = r, age = 0, dead = false }
	end

	-- bola pratinjau & berikutnya
	local prev = mkBall(curLevel, dropX, 24)
	prev.f.BackgroundTransparency = 0.25
	local nextLbl = label(g.hud, "BERIKUTNYA", 11, UDim2.fromOffset(cx0 + cw + 14, top + 4), UDim2.fromOffset(90, 14), C(160, 200, 255))
	outline(nextLbl)
	local nextF = new("Frame", { Position = UDim2.fromOffset(cx0 + cw + 24, top + 24), Size = UDim2.fromOffset(30, 30), BackgroundColor3 = COLS[nextLevel], BorderSizePixel = 0 }, g.hud)
	new("UICorner", { CornerRadius = UDim.new(1, 0) }, nextF)
	new("UIStroke", { Color = Color3.new(1, 1, 1), Thickness = 2 }, nextF)
	local hint = label(g.hud, "GESER & LEPAS UNTUK MENJATUHKAN", 11, UDim2.fromOffset(6, 48), UDim2.fromOffset(cx0 - 10, 28), C(160, 200, 255))
	outline(hint)
	hint.TextWrapped = true

	local function setPrev()
		prev.f:Destroy()
		prev = mkBall(curLevel, dropX, 24)
		prev.f.BackgroundTransparency = 0.25
		nextF.BackgroundColor3 = COLS[nextLevel]
	end

	g.onPress(function()
		if over then return end
		aiming = true
	end)

	local function step(dt)
		local n = #balls
		for _, b in ipairs(balls) do
			b.vy = b.vy + 900 * dt
			b.x = b.x + b.vx * dt
			b.y = b.y + b.vy * dt
			b.age = b.age + dt
			b.vx = b.vx * (1 - 0.15 * dt)
			-- dinding
			if b.x - b.r < 0 then
				b.x = b.r
				b.vx = math.abs(b.vx) * 0.3
			elseif b.x + b.r > cw then
				b.x = cw - b.r
				b.vx = -math.abs(b.vx) * 0.3
			end
			if b.y + b.r > chh - 2 then
				b.y = chh - 2 - b.r
				b.vy = -b.vy * 0.15
				b.vx = b.vx * 0.9
				if math.abs(b.vy) < 20 then b.vy = 0 end
			end
		end
		-- tabrakan antar bola
		for iter = 1, 2 do
			for i = 1, n do
				local a = balls[i]
				if not a.dead then
					for j = i + 1, n do
						local b = balls[j]
						if not b.dead then
							local dx, dy = b.x - a.x, b.y - a.y
							local minD = a.r + b.r
							if dx * dx + dy * dy < minD * minD then
								local d = math.sqrt(dx * dx + dy * dy)
								if d < 0.001 then dx, dy, d = 0, 1, 1 end
								if a.l == b.l and a.l < NL and not a.merge and not b.merge then
									-- menyatu
									a.dead, b.dead = true, true
									local nb = mkBall(a.l + 1, (a.x + b.x) / 2, (a.y + b.y) / 2)
									nb.vx, nb.vy = (a.vx + b.vx) / 2, math.min(a.vy, b.vy) * 0.5
									nb.age = 1
									balls[#balls + 1] = nb
									score = score + VAL[a.l]
									g.sfx("coin")
								elseif a.l == NL and b.l == NL then
									a.dead, b.dead = true, true
									score = score + 200
									g.sfx("win")
								else
									local nx, ny = dx / d, dy / d
									local overlap = minD - d
									local ma, mb = a.r * a.r, b.r * b.r
									local tm = ma + mb
									a.x = a.x - nx * overlap * (mb / tm)
									a.y = a.y - ny * overlap * (mb / tm)
									b.x = b.x + nx * overlap * (ma / tm)
									b.y = b.y + ny * overlap * (ma / tm)
									local rvx, rvy = b.vx - a.vx, b.vy - a.vy
									local vn = rvx * nx + rvy * ny
									if vn < 0 then
										local jimp = -(1 + 0.1) * vn / (1 / ma + 1 / mb)
										a.vx = a.vx - jimp * nx / ma
										a.vy = a.vy - jimp * ny / ma
										b.vx = b.vx + jimp * nx / mb
										b.vy = b.vy + jimp * ny / mb
									end
								end
							end
						end
					end
				end
			end
		end
		-- hapus yang menyatu
		for i = #balls, 1, -1 do
			if balls[i].dead then
				balls[i].f:Destroy()
				table.remove(balls, i)
			end
		end
	end

	g.tick(function(dt)
		if over then return end
		dt = math.min(dt, 1 / 20)
		if cooldown > 0 then cooldown = cooldown - dt end
		-- bidik
		if g.held and aiming then
			dropX = math.clamp(g.ptr.x - cx0, rad(curLevel) + 2, cw - rad(curLevel) - 2)
			prev.f.Position = UDim2.fromOffset(dropX, 24)
		elseif aiming and not g.held then
			aiming = false
			if cooldown <= 0 then
				local b = mkBall(curLevel, dropX, 24)
				balls[#balls + 1] = b
				g.sfx("pop")
				cooldown = 0.55
				curLevel = nextLevel
				nextLevel = math.random(1, 4)
				dropX = math.clamp(dropX, rad(curLevel) + 2, cw - rad(curLevel) - 2)
				setPrev()
			end
		end
		prev.f.Visible = cooldown <= 0
		for _ = 1, 3 do step(dt / 3) end
		for _, b in ipairs(balls) do b.f.Position = UDim2.fromOffset(b.x, b.y) end
		-- game over: bola menetap di atas garis
		local danger = false
		for _, b in ipairs(balls) do
			if b.age > 1.2 and b.y - b.r < dangerY and math.abs(b.vy) < 40 then danger = true end
		end
		if danger then
			dangerT = dangerT + dt
			dl.BackgroundTransparency = (math.floor(dangerT * 6) % 2 == 0) and 0 or 0.7
			if dangerT > 2.2 then
				over = true
				g.sfx("lose")
				g.finish(score)
				return
			end
		else
			dangerT = math.max(0, dangerT - dt)
			dl.BackgroundTransparency = 0.4
		end
		g.setScore(score)
	end)
end

