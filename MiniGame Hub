local function spr(parent, name, px, color, flip)
	local rows = SPR[name]
	local w = 0
	for _, r in ipairs(rows) do
		if #r > w then w = #r end
	end
	local box = new("Frame", { Size = UDim2.fromOffset(w * px, #rows * px), BackgroundTransparency = 1, BorderSizePixel = 0 }, parent)
	color = color or COL.r
	local dark = shade(color, 0.65)
	for y, row0 in ipairs(rows) do
		local row = flip and row0:reverse() or row0
		local x = 1
		while x <= #row do
			local ch = row:sub(x, x)
			if ch == "." then
				x = x + 1
			else
				local x2 = x
				while x2 < #row and row:sub(x2 + 1, x2 + 1) == ch do x2 = x2 + 1 end
				local col = PAL[ch]
				if ch == "x" then col = color elseif ch == "X" then col = dark end
				new("Frame", {
					Position = UDim2.fromOffset((x - 1) * px, (y - 1) * px),
					Size = UDim2.fromOffset((x2 - x + 1) * px, px),
					BackgroundColor3 = col or color, BorderSizePixel = 0,
				}, box)
				x = x2 + 1
			end
		end
	end
	return box, w * px, #rows * px
end

