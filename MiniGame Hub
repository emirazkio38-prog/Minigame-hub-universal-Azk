	local function bossHit()
		if not boss or boss.inv > 0 or boss.hp <= 0 then return end
		boss.hp = boss.hp - 1
		boss.inv = 1.0
		score = score + 100
		g.sfx("boom")
		if bossFill then bossFill.Size = UDim2.fromScale(math.max(0, boss.hp / boss.maxHp), 1) end
		if boss.hp <= 0 then
			boss.dead = true
			boss.deadT = 0
			say(boss.def.name:gsub(" %(.*", "") .. " KALAH!", C(255, 230, 90), 3)
			score = score + 1000
			if bossBar then
				bossBar:Destroy()
				bossBar = nil
			end
		end
	end

	local function die()
		g.sfx("hurt")
		g.lives = g.lives - 1
		g.setLives()
		if g.lives <= 0 then
			g.finish(score)
			state = "over"
			return
		end
		rings = 0
		px, mode, gsp, vx, vy = cpX, "ground", 0, 0, 0
		ax, ay = px, gyAt(px) - RR
		jumped, rolling, charging, hurtT = false, false, false, 0
		invul = 2
		camX, camY = px - W * 0.4, gyAt(px)
		if boss and not boss.dead then
			boss.hp = math.min(boss.maxHp, boss.hp + 2)
		end
		say("COBA LAGI!", C(255, 140, 140), 1.5)
	end

	local function hurt()
		if invul > 0 or hurtT > 0 then return end
		if rings > 0 then
			g.sfx("hurt")
			spawnScatter(math.min(rings, 14))
			rings = 0
			hurtT, invul = 0.6, 2.2
			mode = "air"
			vx, vy = -face * 170, -300
			jumped, rolling, charging = false, false, false
		else
			die()
		end
	end

	local function isBall()
		return jumped or rolling or boostT > 0 or homeT > 0 or mode == "loop" or charging
	end

