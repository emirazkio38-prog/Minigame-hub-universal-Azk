ENG.flap = function(w, g)
	local cfg, W, H = g.cfg, g.W, g.H
	local gy = ground(w, g, 24)
	local hold = cfg.mode == "hold"
	local bf, bw, bh = spr(w, cfg.spr, 3, skc(g))
	local bx = W * 0.25
	local by, vy = H / 2, 0
	g.lives = 1 + g.extra + (g.skin >= 3 and 1 or 0)
	g.setLives()
	local pipes, timer, score, inv = {}, 1.0, 0, 0
	local gap = (hold and 150 or 135) + g.skin * 6
	local pcol = cfg.pipe or C(70, 190, 70)

	g.onPress(function()
		if not hold then vy = -320 end
	end)

	local function part(x, y, ww, hh, col)
		local f = new("Frame", { Position = UDim2.fromOffset(x, y), Size = UDim2.fromOffset(ww, hh), BackgroundColor3 = col, BorderSizePixel = 0 }, w)
		new("UIStroke", { Color = C(0, 0, 0), Thickness = 2, LineJoinMode = Enum.LineJoinMode.Miter }, f)
		return f
	end

	g.tick(function(dt)
		if hold then
			vy = vy + (g.held and -1300 or 800) * dt
			vy = math.clamp(vy, -300, 360)
		else
			vy = vy + 950 * dt
		end
		by = by + vy * dt
		bf.Position = UDim2.fromOffset(bx, by)
		bf.Rotation = math.clamp(vy / 10, -25, 45)

		timer = timer - dt
		if timer <= 0 then
			timer = 1.7
			local gt = math.random(40, math.max(41, math.floor(gy - 40 - gap)))
			pipes[#pipes + 1] = {
				x = W, gt = gt, passed = false,
				a = part(W, 0, 46, gt, pcol), b = part(W - 3, gt - 12, 52, 12, shade(pcol, 1.25)),
				c = part(W - 3, gt + gap, 52, 12, shade(pcol, 1.25)), d = part(W, gt + gap + 12, 46, math.max(1, gy - (gt + gap + 12)), pcol),
			}
		end

		inv = math.max(0, inv - dt)
		bf.Visible = inv <= 0 or math.floor(inv * 10) % 2 == 0
		local hit = false
		for i = #pipes, 1, -1 do
			local p = pipes[i]
			p.x = p.x - 170 * dt
			p.a.Position = UDim2.fromOffset(p.x, 0)
			p.b.Position = UDim2.fromOffset(p.x - 3, p.gt - 12)
			p.c.Position = UDim2.fromOffset(p.x - 3, p.gt + gap)
			p.d.Position = UDim2.fromOffset(p.x, p.gt + gap + 12)
			if not p.passed and p.x + 46 < bx then
				p.passed = true
				score = score + 1
				g.setScore(score)
			end
			if inv <= 0 and bx + bw - 5 > p.x - 3 and bx + 5 < p.x + 49 and (by + 4 < p.gt or by + bh - 4 > p.gt + gap) then hit = true end
			if p.x < -60 then
				p.a:Destroy()
				p.b:Destroy()
				p.c:Destroy()
				p.d:Destroy()
				table.remove(pipes, i)
			end
		end
		if by < 0 or by + bh > gy then hit = true end
		if hit and inv <= 0 then
			g.lives = g.lives - 1
			g.setLives()
			if g.lives <= 0 then
				g.finish(score)
				return
			end
			by, vy, inv = H / 2, 0, 1.5
		end
	end)
end

