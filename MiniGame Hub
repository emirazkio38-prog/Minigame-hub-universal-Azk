local gui = nil
local guiHome = nil
do
	local pgui = player:WaitForChild("PlayerGui")
	local function cleanup(parent)
		if not parent then return end
		for _, nm in ipairs({ "ThrowFarm", "MiniGameHub", "ThrowFarmHub" }) do
			local old = parent:FindFirstChild(nm)
			if old then pcall(function() old:Destroy() end) end
		end
	end
	local function make(parent)
		local g2 = new("ScreenGui", {
			Name = "MiniGameHub", ResetOnSpawn = false, IgnoreGuiInset = true, DisplayOrder = 999999,
			ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		}, parent)
		return g2
	end
	cleanup(pgui)

	-- tempat paling aman: gethui / CoreGui (script game tidak bisa menyembunyikan GUI di sini)
	local target = nil
	if PAKAI_COREGUI then
		local okH, h = pcall(function() return gethui and gethui() end)
		if okH and typeof(h) == "Instance" then target = h end
		if not target then
			local okC, cg = pcall(function() return game:GetService("CoreGui") end)
			if okC and typeof(cg) == "Instance" then target = cg end
		end
	end
	if target then
		cleanup(target)
		local ok, res = pcall(make, target)
		if ok and res and res.Parent then
			gui, guiHome = res, target
		elseif ok and res then
			pcall(function() res:Destroy() end)
		end
	end
	if not gui then
		gui, guiHome = make(pgui), pgui
	end

	-- kalau game mematikan / memindahkan GUI ini, langsung dikembalikan
	gui:GetPropertyChangedSignal("Enabled"):Connect(function()
		if not gui.Enabled then gui.Enabled = true end
	end)
	gui:GetPropertyChangedSignal("DisplayOrder"):Connect(function()
		if gui.DisplayOrder ~= 999999 then gui.DisplayOrder = 999999 end
	end)
end

