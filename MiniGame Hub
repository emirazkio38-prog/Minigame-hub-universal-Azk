-- ENGINE 13: PELIHARA HEWAN (ala Tamagotchi)
------------------------------------------------------------
ENG.pet = function(w, g)
	local cfg, W, H = g.cfg, g.W, g.H
	local gyP = ground(w, g, 64)
	g.lives = 1 + g.extra + (g.skin >= 3 and 1 or 0)
	g.setLives()

	local STAT = { "food", "joy", "clean", "energy" }
	local SNAME = { food = "LAPAR", joy = "SENANG", clean = "BERSIH", energy = "ENERGI" }
	local SCOL = { food = C(255, 170, 60), joy = C(255, 120, 190), clean = C(90, 200, 255), energy = C(255, 230, 80) }
	local STAGE = { "BAYI", "ANAK", "DEWASA" }
	local stats = { food = 80, joy = 80, clean = 80, energy = 80 }
	local hpv, age, care, score = 100, 0, 0, 0
	local sleeping, sel, cd = false, 1, 0
	local poops, poopT = {}, math.random(18, 30)
	local sizes = (cfg.spr == "dragon") and { 2, 3, 4 } or { 3, 4, 5 }
	local TOTAL = 240
	local stageNow = 0
	local pbox, pw, ph
	local px, dirx, wanderT, hopT = W / 2, 0, 0, 0
	local nav = { l = false, r = false, ok = false, num = { false, false, false, false } }

	local dark = new("Frame", {
		Size = UDim2.fromScale(1, 1), BackgroundColor3 = C(0, 0, 40), BackgroundTransparency = 0.4,
		BorderSizePixel = 0, Visible = false, ZIndex = 4,
	}, w)
	local mood = new("TextLabel", {
		Size = UDim2.fromOffset(40, 34), BackgroundTransparency = 1, Text = "", TextSize = 28,
		Font = Enum.Font.SourceSans, TextColor3 = Color3.new(1, 1, 1), ZIndex = 5,
	}, w)

	-- panel status
	local bars = {}
	local function mkStatRow(i, name, color)
		local y = 46 + (i - 1) * 17
		local l = label(g.hud, name, 10, UDim2.fromOffset(8, y), UDim2.fromOffset(56, 14), Color3.new(1, 1, 1))
		outline(l)
		local bg = new("Frame", { Position = UDim2.fromOffset(64, y + 3), Size = UDim2.fromOffset(80, 8), BackgroundColor3 = C(25, 25, 25), BorderSizePixel = 0 }, g.hud)
		new("UIStroke", { Color = Color3.new(0, 0, 0), Thickness = 2, LineJoinMode = Enum.LineJoinMode.Miter }, bg)
		return new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = color, BorderSizePixel = 0 }, bg)
	end
	for i, k in ipairs(STAT) do bars[k] = mkStatRow(i, SNAME[k], SCOL[k]) end
	local hpBar = mkStatRow(5, "NYAWA", C(230, 70, 70))

	local msg = label(g.hud, "RAWAT HEWANMU!", 14, UDim2.new(0.5, -160, 0, 28), UDim2.fromOffset(320, 20), Color3.new(1, 1, 0.7), Enum.TextXAlignment.Center)
	outline(msg)
	local info = label(w, "", 11, UDim2.fromOffset(8, H - 62), UDim2.new(1, -16, 0, 12), Color3.new(1, 1, 1))
	info.ZIndex = 6
	outline(info)

	local function addStat(k, v) stats[k] = math.clamp(stats[k] + v, 0, 100) end

	local function stageOf()
		if age < 40 then return 1 elseif age < 100 then return 2 end
		return 3
	end
	local function mkPet()
		if pbox then pbox:Destroy() end
		pbox, pw, ph = spr(w, cfg.spr, sizes[stageNow], skc(g))
	end
	local function addPoop()
		local f = new("Frame", {
			Size = UDim2.fromOffset(14, 10), Position = UDim2.fromOffset(math.random(150, math.max(160, W - 60)), gyP - 6),
			BackgroundColor3 = C(120, 75, 35), BorderSizePixel = 0,
		}, w)
		new("UIStroke", { Color = Color3.new(0, 0, 0), Thickness = 2, LineJoinMode = Enum.LineJoinMode.Miter }, f)
		poops[#poops + 1] = f
	end

	local function doAction(i)
		if cd > 0 then return end
		if i == 4 then
			sleeping = not sleeping
			msg.Text = sleeping and "ZZZ... HEWANMU TIDUR" or "HEWANMU BANGUN!"
			cd = 0.5
			return
		end
		if sleeping then
			msg.Text = "SHH... SEDANG TIDUR"
			return
		end
		cd = 0.5
		care = care + 1
		if i == 1 then
			addStat("food", 35)
			msg.Text = "NYAM NYAM! ENAK"
			hopT = 0.4
		elseif i == 2 then
			if stats.energy < 15 then
				msg.Text = "HEWANMU CAPEK, BIARKAN TIDUR"
				care = care - 1
				return
			end
			addStat("joy", 30)
			addStat("energy", -12)
			msg.Text = "ASIK! MAIN BARENG"
			hopT = 0.8
		else
			addStat("clean", 45)
			for _, f in ipairs(poops) do f:Destroy() end
			poops = {}
			msg.Text = "BERSIH & WANGI!"
		end
	end

	local btns = menuRow(g, { "MAKAN", "MAIN", "MANDI", "TIDUR" }, function(i)
		sel = i
		doAction(i)
	end)

	g.tick(function(dt)
		age = age + dt
		cd = math.max(0, cd - dt)
		hopT = math.max(0, hopT - dt)

		local sn = stageOf()
		if sn ~= stageNow then
			stageNow = sn
			mkPet()
			if sn > 1 then msg.Text = "HEWANMU TUMBUH JADI " .. STAGE[sn] .. "!" end
		end

		local idxPick
		sel, idxPick = menuNav(g, nav, sel, 4)
		if idxPick then doAction(idxPick) end

		-- status turun seiring waktu
		local mult = sleeping and 0.35 or 1
		addStat("food", -1.1 * mult * dt)
		addStat("joy", -0.9 * mult * dt)
		addStat("clean", -(0.7 + 0.6 * #poops) * mult * dt)
		if sleeping then
			addStat("energy", 6 * dt)
			if stats.energy >= 100 then
				sleeping = false
				msg.Text = "HEWANMU BANGUN, SEGAR!"
			end
		else
			addStat("energy", -0.5 * dt)
			poopT = poopT - dt
			if poopT <= 0 then
				poopT = math.random(20, 35)
				if #poops < 4 then addPoop() end
			end
		end

		-- nyawa hewan
		local low = 0
		for _, k in ipairs(STAT) do
			if stats[k] < 20 then low = low + 1 end
		end
		if low > 0 then
			hpv = hpv - 2.5 * low * dt
		else
			hpv = math.min(100, hpv + 1.5 * dt)
		end
		if hpv <= 0 then
			g.lives = g.lives - 1
			g.setLives()
			if g.lives <= 0 then
				g.finish(score)
				return
			end
			for _, k in ipairs(STAT) do stats[k] = 60 end
			hpv = 60
			msg.Text = "HEWANMU PULIH LAGI!"
		end

		if age >= TOTAL then
			msg.Text = "HEWANMU SUDAH DEWASA & BAHAGIA!"
			g.finish(score + 50)
			return
		end

		score = math.floor(age / 2) + care * 2
		g.setScore(score)

		-- gerak hewan
		if not sleeping then
			wanderT = wanderT - dt
			if wanderT <= 0 then
				wanderT = math.random(1, 3)
				dirx = math.random(-1, 1)
			end
			px = math.clamp(px + dirx * 30 * dt, 170, math.max(180, W - 70))
		end
		local bob = sleeping and 0 or math.sin(os.clock() * 3) * 2
		local hop = hopT > 0 and math.abs(math.sin(hopT / 0.8 * math.pi * 2)) * 22 or 0
		local py = gyP - ph + 2 - bob - hop
		pbox.Position = UDim2.fromOffset(px - pw / 2, py)

		local lowest = 100
		for _, k in ipairs(STAT) do lowest = math.min(lowest, stats[k]) end
		local face = "😊"
		if sleeping then
			face = "😴"
		elseif hpv < 30 or lowest < 20 then
			face = "😢"
		elseif lowest < 50 then
			face = "😐"
		end
		mood.Text = face
		mood.Position = UDim2.fromOffset(px - 20, py - 36)
		dark.Visible = sleeping

		for _, k in ipairs(STAT) do bars[k].Size = UDim2.fromScale(stats[k] / 100, 1) end
		hpBar.Size = UDim2.fromScale(math.clamp(hpv / 100, 0, 1), 1)
		info.Text = string.format("UMUR %ds / %ds   FASE: %s   KOTORAN: %d", math.floor(age), TOTAL, STAGE[stageNow], #poops)
		btns[4].Text = sleeping and "BANGUN" or "TIDUR"
		for i = 1, 4 do
			btns[i].BackgroundColor3 = (i == sel) and C(70, 140, 240) or C(40, 90, 170)
		end
	end)
end

