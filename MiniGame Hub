ENG.jump = function(w, g)
	local cfg, W, H = g.cfg, g.W, g.H
	g.mkPadLR()
	local pbox, pw, ph = spr(w, cfg.spr, 3, skc(g))
	pbox.ZIndex = 6
	local PW, PH = 58, 12
	local px, py, vy = W / 2 - pw / 2, H - 90 - ph, 0
	local bounce = -650 - g.skin * 25
	local plats, score, maxH, topY = {}, 0, 0, H
	g.lives = 1 + g.extra + (g.skin >= 3 and 1 or 0)
	g.setLives()

	local function addPlat(y, forceNorm, fixedX)
		local r = math.random()
		local k = "norm"
		local mv = cfg.moving and 0.4 or 0.18
		if not forceNorm then
			if r < mv then
				k = "move"
			elseif r < mv + 0.1 then
				k = "break"
			elseif r < mv + 0.18 then
				k = "spring"
			end
		end
		local color = C(80, 200, 90)
		if k == "move" then
			color = C(70, 140, 235)
		elseif k == "break" then
			color = C(170, 110, 60)
		elseif k == "spring" then
			color = C(220, 90, 90)
		end
		local x = fixedX or math.random(0, W - PW)
		local f = new("Frame", {
			Position = UDim2.fromOffset(x, y), Size = UDim2.fromOffset(PW, PH),
			BackgroundColor3 = color, BorderSizePixel = 0, ZIndex = 2,
		}, w)
		new("UIStroke", { Color = Color3.new(0, 0, 0), Thickness = 2, LineJoinMode = Enum.LineJoinMode.Miter }, f)
		if k == "spring" then
			new("Frame", { Position = UDim2.new(0.5, -8, 0, -8), Size = UDim2.fromOffset(16, 8), BackgroundColor3 = C(240, 240, 240), BorderSizePixel = 0 }, f)
		end
		plats[#plats + 1] = { f = f, x = x, y = y, k = k, dir = math.random(0, 1) * 2 - 1, fall = false }
	end

	topY = H - 30
	addPlat(topY, true, W / 2 - PW / 2)
	while topY > -40 do
		topY = topY - math.random(65, 95)
		addPlat(topY)
	end

	g.tick(function(dt)
		local dir = g.dir()
		if dir ~= 0 then
			px = px + dir * 290 * dt
		elseif not g.ptrLock then
			px = px + math.clamp(g.ptr.x - pw / 2 - px, -300 * dt, 300 * dt)
		end
		if px + pw < 0 then
			px = W
		elseif px > W then
			px = -pw
		end

		vy = vy + 1150 * dt
		local oldBottom = py + ph
		py = py + vy * dt

		for _, p in ipairs(plats) do
			if p.k == "move" then
				p.x = p.x + p.dir * 80 * dt
				if p.x < 0 then
					p.x = 0
					p.dir = 1
				elseif p.x + PW > W then
					p.x = W - PW
					p.dir = -1
				end
			end
			if p.fall then p.y = p.y + 420 * dt end
		end

		if vy > 0 then
			for _, p in ipairs(plats) do
				if not p.fall and px + pw - 6 > p.x and px + 6 < p.x + PW and oldBottom <= p.y + 6 and py + ph >= p.y then
					if p.k == "break" then
						p.fall = true
					else
						py = p.y - ph
						vy = (p.k == "spring") and bounce * 1.5 or bounce
					end
					break
				end
			end
		end

		-- kamera naik
		local lim = H * 0.42
		if py < lim then
			local dd = lim - py
			py = lim
			maxH = maxH + dd
			for _, p in ipairs(plats) do p.y = p.y + dd end
			topY = topY + dd
			score = math.floor(maxH / 10)
			g.setScore(score)
		end
		while topY > -30 do
			local hard = math.min(1, maxH / 8000)
			topY = topY - (math.random(60, 90) + hard * 40)
			addPlat(topY)
		end
		for i = #plats, 1, -1 do
			local p = plats[i]
			if p.y > H + 30 then
				p.f:Destroy()
				table.remove(plats, i)
			end
		end
		for _, p in ipairs(plats) do p.f.Position = UDim2.fromOffset(p.x, p.y) end
		pbox.Position = UDim2.fromOffset(px, py)

		if py > H + 20 then
			g.lives = g.lives - 1
			g.setLives()
			if g.lives <= 0 then
				g.finish(score)
				return
			end
			-- selamatkan: taruh platform tepat di bawah pemain
			addPlat(H - 70, true, math.clamp(px - 10, 0, W - PW))
			py, vy = H - 70 - ph, bounce
		end
	end)
end

