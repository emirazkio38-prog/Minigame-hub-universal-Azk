local function mountain(parent, x, baseY, wid, hgt, color)
	local steps = math.max(1, math.floor(hgt / 8))
	for i = 0, steps - 1 do
		local ww = wid - i * (wid / steps)
		new("Frame", {
			Size = UDim2.fromOffset(ww, 8), Position = UDim2.fromOffset(x + (wid - ww) / 2, baseY - (i + 1) * 8),
			BackgroundColor3 = color, BorderSizePixel = 0,
		}, parent)
	end
end

local function buildSky(sky, key, W, H, g)
	local s = SKY[key] or SKY.day
	new("UIGradient", { Color = ColorSequence.new(s[1], s[2]), Rotation = 90 }, sky)
	local dark = key == "night" or key == "space"
	if dark then
		for _ = 1, 30 do
			new("Frame", {
				Size = UDim2.fromOffset(2, 2), BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0,
				Position = UDim2.fromOffset(math.random(0, W), math.random(0, math.floor(H * 0.75))),
			}, sky)
		end
		local m = spr(sky, "moon", 4, C(250, 245, 200))
		m.Position = UDim2.fromOffset(W - 70, 16)
	else
		local sn = spr(sky, "sun", 5, C(255, 220, 60))
		sn.Position = UDim2.fromOffset(W - 80, 14)
	end
	if MTN[key] then
		mountain(sky, W * 0.02, H - 40, 150, 90, MTN[key])
		mountain(sky, W * 0.38, H - 40, 190, 120, shade(MTN[key], 0.85))
		mountain(sky, W * 0.7, H - 40, 140, 80, MTN[key])
	end
	g.clouds = {}
	local ccol = dark and C(70, 70, 120) or (key == "sunset" and C(255, 205, 190) or C(255, 255, 255))
	for i = 1, 4 do
		local f = spr(sky, "cloud", 4, ccol)
		g.clouds[i] = { f = f, x = math.random(0, W), y = math.random(10, math.max(11, math.floor(H * 0.4))), s = math.random(8, 24) }
	end
end

