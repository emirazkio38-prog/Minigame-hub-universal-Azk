local function act1Down(g)
	return UIS:IsKeyDown(KC.F) or UIS:IsKeyDown(KC.E) or UIS:IsKeyDown(KC.J)
		or padBtn(KC.ButtonX) or padBtn(KC.ButtonR1) or padBtn(KC.ButtonR2)
		or (g.a1 ~= nil and g.a1.down)
end

local function act2Down(g)
	return UIS:IsKeyDown(KC.G) or UIS:IsKeyDown(KC.Q) or UIS:IsKeyDown(KC.K) or UIS:IsKeyDown(KC.LeftShift)
		or padBtn(KC.ButtonB) or padBtn(KC.ButtonL1) or padBtn(KC.ButtonL2)
		or (g.a2 ~= nil and g.a2.down)
end

ENG.run = function(w, g)
	local cfg, W, H = g.cfg, g.W, g.H
	local sonic = cfg.style == "sonic"
	local sk = cfg.sk or { "SPIN DASH", "HOMING", "BOOST" }
	local bounceShot = cfg.name == "Super Mario Bros"
	local GH = 44
	local gy = H - GH
	local wl = g.weapon

	-- lapisan gambar: level < depan (bos, tembakan) < pemain
	local layer = new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, BorderSizePixel = 0 }, w)
	local front = new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, BorderSizePixel = 0 }, w)
	local pf, pw, ph = spr(w, cfg.spr, 3, skc(g))
	local pfL = spr(w, cfg.spr, 3, skc(g), true)
	pf.AnchorPoint = Vector2.new(0.5, 0.5)
	pfL.AnchorPoint = Vector2.new(0.5, 0.5)

	-- status level
	local L, lv, root, flag = 0, nil, nil, nil
	local S, E, coinsL, shots, bshots, fx = {}, {}, {}, {}, {}, {}
	local boss, bossBar, bossFill = nil, nil, nil
	local bossOn, bossDone = false, false

	-- status pemain
	local px, py, vx, vy = 80, gy - ph, 0, 0
	local face, onGround, jumps, coyote, landed = 1, true, 0, 0, nil
	local maxJ = (cfg.dj or sonic) and 2 or 1
	local jumpV = -620 - 25 * g.skin - (sonic and 30 or 0)
	local maxSpd = (sonic and 270 or 200) + 8 * g.skin
	local accel = sonic and 650 or 1500
	local decel = sonic and 420 or 1800
	local camX, camMax = 0, 0
	local inv, fireT = 0, 0
	local kills, coins, levelScore, maxX = 0, 0, 0, 0
	local state, clearT, safeX = "play", 0, 80
	local prevJ, prevA1, prevA2 = false, false, false
	local bannerT = 0

	-- status skill Sonic
	local charge, dashT, dashDur, dashV, dashF = 0, 0, 0.4, 0, 1
	local homingT, airDashT, airVx, airUsed, target = 0, 0, 0, false, nil
	local boostT, boostCD = 0, 0
	local boostDur = 2.2 + 0.6 * wl
	local boostMaxCD = math.max(4, 9 - 1.5 * wl)

	g.lives = 3 + g.extra + (g.skin >= 3 and 1 or 0)
	g.setLives()

	------------------------------------------------------------
	-- tombol di layar
	------------------------------------------------------------
	g.mkPadLR()
	local jumpBtn = g.holdBtn("JUMP", UDim2.new(1, -92, 1, -62), UDim2.fromOffset(82, 52), C(40, 150, 70))
	g.a1 = g.holdBtn(sonic and sk[1] or "TEMBAK", UDim2.new(1, -182, 1, -62), UDim2.fromOffset(82, 52), C(210, 120, 30))
	local btns = { jumpBtn, g.a1 }
	if sonic then
		g.a2 = g.holdBtn(sk[3], UDim2.new(1, -272, 1, -62), UDim2.fromOffset(82, 52), C(140, 70, 200))
		btns[#btns + 1] = g.a2
	end
	for _, st in ipairs(btns) do
		st.btn.TextSize = 13
		st.btn.BackgroundTransparency = 0.35
	end

	local lvLbl = label(g.hud, "", 16, UDim2.fromOffset(8, 46), UDim2.fromOffset(200, 20), C(160, 230, 255))
	outline(lvLbl)
	local banner = label(g.hud, "", 24, UDim2.new(0.5, -170, 0.2, 0), UDim2.fromOffset(340, 60), Color3.new(1, 1, 0.6), Enum.TextXAlignment.Center)
	outline(banner)

	local bbFill = nil
	if sonic then
		local bbBg = new("Frame", { Position = UDim2.fromOffset(8, 70), Size = UDim2.fromOffset(90, 8), BackgroundColor3 = C(30, 30, 30), BorderSizePixel = 0 }, g.hud)
		new("UIStroke", { Color = Color3.new(0, 0, 0), Thickness = 2 }, bbBg)
		bbFill = new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = C(170, 90, 230), BorderSizePixel = 0 }, bbBg)
	end
	local chBg = new("Frame", { Size = UDim2.fromOffset(34, 5), BackgroundColor3 = C(20, 20, 20), BorderSizePixel = 0, Visible = false }, front)
	local chFill = new("Frame", { Size = UDim2.fromScale(0, 1), BackgroundColor3 = C(255, 200, 60), BorderSizePixel = 0 }, chBg)

	------------------------------------------------------------
	-- helper
	------------------------------------------------------------
	local function say(text, col, t)
		banner.Text = text
		banner.TextColor3 = col or Color3.new(1, 1, 0.6)
		bannerT = t or 2
	end

	local function score()
		return levelScore + math.floor(maxX / 60) + coins * 2 + kills * 3
	end

	local function put(f, x, y, ww)
		local sx = x - camX
		if sx > W + 80 or sx + ww < -80 then
			if f.Visible then f.Visible = false end
		else
			if not f.Visible then f.Visible = true end
			f.Position = UDim2.fromOffset(math.floor(sx), math.floor(y))
		end
	end

	local function hitSolid(x, y, ww, hh)
		for i = 1, #S do
			local s = S[i]
			if x < s.x + s.w and x + ww > s.x and y < s.y + s.h - 0.01 and y + hh > s.y + 0.01 then
				return s
			end
		end
		return nil
	end

	local function killEnemy(i)
		E[i].f:Destroy()
		table.remove(E, i)
		kills = kills + 1
	end

	local function bump(s)
		if s.k == "q" and not s.used then
			s.used = true
			s.f.BackgroundColor3 = C(150, 110, 60)
			if s.lbl then s.lbl.Text = "" end
			coins = coins + 1
			local f = spr(front, "coin", 3)
			fx[#fx + 1] = { f = f, x = s.x + 5, y = s.y - 22, t = 0.5 }
		end
		s.bump = 0.12
	end

	local function hurt(force)
		if not force and (inv > 0 or dashT > 0 or boostT > 0 or homingT > 0 or airDashT > 0) then
			return false
		end
		g.lives = g.lives - 1
		g.setLives()
		if g.lives <= 0 then
			g.finish(score())
			return true
		end
		inv = 1.6
		return true
	end

	local function respawn()
		px, py, vx, vy = safeX, gy - ph - 90, 0, 0
		inv = 2
		dashT, homingT, airDashT, boostT = 0, 0, 0, 0
	end

	local function clearLevel()
		if state == "clear" then return end
		state = "clear"
		clearT = 2.4
		levelScore = levelScore + 40 + 10 * L + (lv.boss and 100 or 0)
		say("LEVEL " .. L .. " SELESAI!", C(255, 230, 80), 2.4)
	end

	------------------------------------------------------------
	-- tembakan (Mario & sejenisnya)
	------------------------------------------------------------
	local function shoot()
		fireT = ({ 0.4, 0.33, 0.27, 0.2 })[wl + 1]
		local sp = 360 + 45 * wl
		local x0 = face > 0 and (px + pw) or (px - 10)
		local y0 = py + ph * 0.35
		local function mk(vyy)
			local f = spr(front, "fire", 2)
			shots[#shots + 1] = {
				f = f, x = x0, y = y0, vx = face * sp, vy = vyy, life = 1.6,
				dmg = wl >= 3 and 2 or 1, pierce = wl >= 3,
			}
		end
		mk(0)
		if wl >= 2 then mk(-160) end
	end

	------------------------------------------------------------
	-- pembuat level (tiap level beda: balok, pipa, tangga, jurang, musuh)
	------------------------------------------------------------
	local function genLevel(n)
		local rng = Random.new(n * 7919 + g.idx * 131)
		local function ri(a, b) return rng:NextInteger(a, b) end
		local d = { segs = {}, sol = {}, en = {}, co = {}, boss = (n % 3 == 0), theme = LV_THEME[(n - 1) % #LV_THEME + 1] }
		local spdE = math.min(40 + n * 6, 95)
		local function seg(x1, x2) d.segs[#d.segs + 1] = { x1 = x1, x2 = x2 } end
		local function blk(bx, by, kind, bw, bh)
			d.sol[#d.sol + 1] = { x = bx, y = by, w = bw or BS, h = bh or BS, k = kind }
		end
		local function walker(ex, x1, x2, hop)
			d.en[#d.en + 1] = {
				k = hop and "hop" or "walk", x = ex, base = gy, x1 = x1, x2 = x2,
				spd = spdE * (hop and 1.15 or 1), dir = ri(0, 1) * 2 - 1, ph = ri(0, 6),
			}
		end
		local function flyer(ex, ey, x1, x2)
			d.en[#d.en + 1] = {
				k = "fly", x = ex, base = ey, x1 = x1, x2 = x2,
				spd = spdE * 1.1 + 10, dir = ri(0, 1) * 2 - 1, ph = ri(0, 6),
			}
		end
		local function spike(ex)
			d.en[#d.en + 1] = { k = "spike", x = ex, base = gy, x1 = ex, x2 = ex + 1, spd = 0, dir = 1, ph = 0 }
		end
		local function coinLine(cx, cy, cnt)
			for i = 0, cnt - 1 do d.co[#d.co + 1] = { x = cx + i * 26, y = cy } end
		end

		seg(0, 420)
		coinLine(220, gy - 60, 3)
		local x = 420
		local len = 2000 + 380 * math.min(n, 8)
		local maxW = math.min(3, 1 + math.floor(n / 2))
		while x < len do
			local kind = ri(1, 7)
			if kind == 1 or kind == 7 then
				-- tanah datar + musuh berjalan
				local l = ri(260, 400)
				seg(x, x + l)
				local nw = ri(1, maxW)
				for i = 1, nw do
					local ex = x + 50 + (i - 1) * ((l - 100) / nw) + ri(0, 20)
					walker(ex, x + 20, x + l - 20, n >= 2 and ri(1, 3) == 1)
				end
				if n >= 3 and ri(1, 2) == 1 then flyer(x + l / 2, gy - ri(60, 110), x + 30, x + l - 30) end
				if n >= 2 and ri(1, 3) == 1 then spike(x + l * 0.55) end
				coinLine(x + l * 0.3, gy - 70, 3)
				x = x + l
			elseif kind == 2 then
				-- jurang
				local l1 = ri(140, 200)
				seg(x, x + l1)
				walker(x + l1 / 2, x + 20, x + l1 - 20, false)
				x = x + l1
				local gw = math.min(70 + n * 6 + ri(0, 20), 112)
				coinLine(x + gw / 2 - 26, gy - 100, 3)
				x = x + gw
				local l2 = ri(130, 180)
				seg(x, x + l2)
				x = x + l2
			elseif kind == 3 then
				-- baris balok di atas (bata + balok ?)
				local l = ri(320, 440)
				seg(x, x + l)
				local cnt = ri(4, 7)
				local bx = x + 60 + ri(0, 40)
				for i = 1, cnt do
					blk(bx + (i - 1) * BS, gy - 84, (i % 2 == 0) and "q" or "brick")
				end
				coinLine(bx, gy - 84 - 30, cnt)
				walker(x + l * 0.6, x + 30, x + l - 30, false)
				if n >= 4 then flyer(x + l * 0.4, gy - 120, x + 40, x + l - 40) end
				x = x + l
			elseif kind == 4 then
				-- tangga naik lalu turun
				local h = ri(2, 4)
				local sx = x + 110
				for c = 1, h do
					for r = 1, c do blk(sx + (c - 1) * BS, gy - r * BS, "step") end
				end
				local sx2 = sx + h * BS + ri(50, 80)
				for c = 1, h do
					for r = 1, h - c + 1 do blk(sx2 + (c - 1) * BS, gy - r * BS, "step") end
				end
				local l = (sx2 + h * BS + 110) - x
				seg(x, x + l)
				if n >= 2 then walker(sx + h * BS + 4, sx + h * BS, sx2, false) end
				coinLine(sx + h * BS - 10, gy - h * BS - 30, 3)
				x = x + l
			elseif kind == 5 then
				-- pipa
				local l = ri(380, 460)
				seg(x, x + l)
				local np = ri(1, 2)
				for i = 1, np do
					local phh = (ri(1, 2) == 1) and 56 or 84
					blk(x + 70 + (i - 1) * 150, gy - phh, "pipe", 44, phh)
				end
				local pend = x + 70 + (np - 1) * 150 + 44
				walker(pend + 40, pend + 16, x + l - 16, false)
				flyer(x + l / 2, gy - 120, x + 30, x + l - 30)
				coinLine(x + 60, gy - 130, 3)
				x = x + l
			else
				-- jurang dengan platform melayang
				local l1 = ri(130, 170)
				seg(x, x + l1)
				x = x + l1
				local cnt = ri(2, 3)
				for i = 1, cnt do
					local bx = x + (i - 1) * 118 + 14
					local by = gy - 56 - ((i % 2 == 0) and 24 or 0)
					blk(bx, by, "brick")
					blk(bx + BS, by, "brick")
					coinLine(bx + 4, by - 30, 2)
				end
				x = x + cnt * 118 + 10
				local l2 = ri(140, 190)
				seg(x, x + l2)
				x = x + l2
			end
		end

		if d.boss then
			d.arenaL = x + 60
			d.arenaR = d.arenaL + W
			seg(x, d.arenaR + 160)
			d.len = d.arenaR + 160
		else
			d.flagX = x + 160
			seg(x, x + 420)
			d.len = x + 420
		end
		return d
	end

	local function build(d)
		root = new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, BorderSizePixel = 0 }, layer)
		local grd = GRD[d.theme] or GRD.day
		S, E, coinsL = {}, {}, {}
		for _, s in ipairs(d.segs) do
			local f = new("Frame", { Size = UDim2.fromOffset(s.x2 - s.x1, GH), BackgroundColor3 = grd[1], BorderSizePixel = 0 }, root)
			new("Frame", { Size = UDim2.new(1, 0, 0, 8), BackgroundColor3 = grd[2], BorderSizePixel = 0 }, f)
			S[#S + 1] = { x = s.x1, y = gy, w = s.x2 - s.x1, h = GH + 400, k = "ground", f = f }
		end
		for _, b in ipairs(d.sol) do
			local col = C(160, 160, 175)
			if b.k == "brick" then
				col = d.theme == "snow" and C(150, 200, 235) or C(190, 100, 50)
			elseif b.k == "q" then
				col = C(245, 190, 40)
			elseif b.k == "pipe" then
				col = C(50, 170, 70)
			end
			local f = new("Frame", { Size = UDim2.fromOffset(b.w, b.h), BackgroundColor3 = col, BorderSizePixel = 0 }, root)
			new("UIStroke", { Color = Color3.new(0, 0, 0), Thickness = 2, LineJoinMode = Enum.LineJoinMode.Miter }, f)
			if b.k == "q" then
				b.lbl = label(f, "?", 20, UDim2.new(), UDim2.fromScale(1, 1), Color3.new(1, 1, 1), Enum.TextXAlignment.Center)
			elseif b.k == "pipe" then
				new("Frame", { Size = UDim2.new(1, 8, 0, 12), Position = UDim2.fromOffset(-4, 0), BackgroundColor3 = C(70, 200, 90), BorderSizePixel = 0 }, f)
			end
			b.f = f
			S[#S + 1] = b
		end
		for _, e in ipairs(d.en) do
			local nm = "mush"
			local col = nil
			if e.k == "fly" then
				nm = "bat"
			elseif e.k == "spike" then
				nm = "spike"
			elseif e.k == "hop" then
				nm = "alien"
				col = C(230, 90, 90)
			else
				col = C(170, 100, 50)
			end
			local f, ew, eh = spr(root, nm, 3, col)
			e.f, e.w, e.h = f, ew, eh
			e.y = e.base - eh
			e.t = 0
			E[#E + 1] = e
		end
		for _, c in ipairs(d.co) do
			local f = spr(root, "coin", 3)
			coinsL[#coinsL + 1] = { f = f, x = c.x, y = c.y, w = 18, h = 18 }
		end
		flag = nil
		if d.flagX then
			local pole = new("Frame", { Size = UDim2.fromOffset(5, 170), BackgroundColor3 = C(230, 230, 230), BorderSizePixel = 0 }, root)
			new("Frame", { Size = UDim2.fromOffset(34, 22), Position = UDim2.fromOffset(5, 4), BackgroundColor3 = C(230, 50, 50), BorderSizePixel = 0 }, pole)
			flag = { f = pole, x = d.flagX, y = gy - 170 }
		end
	end

	local function clearFx()
		for _, t in ipairs(shots) do t.f:Destroy() end
		for _, t in ipairs(bshots) do t.f:Destroy() end
		for _, t in ipairs(fx) do t.f:Destroy() end
		shots, bshots, fx = {}, {}, {}
		if boss then
			boss.f:Destroy()
			boss.fl:Destroy()
			boss = nil
		end
		if bossBar then
			bossBar:Destroy()
			bossBar = nil
		end
	end

	local function loadLevel(n)
		L = n
		lv = genLevel(n)
		if root then root:Destroy() end
		clearFx()
		bossOn, bossDone = false, false
		g.setSky(lv.theme)
		build(lv)
		camMax = math.max(0, lv.len - W)
		px, py, vx, vy = 80, gy - ph, 0, 0
		camX, safeX, maxX = 0, 80, 0
		inv, state, onGround, jumps = 1.0, "play", true, 0
		dashT, homingT, airDashT, boostT = 0, 0, 0, 0
		lvLbl.Text = "LEVEL " .. n .. (lv.boss and " (BOS)" or "")
		if lv.boss then
			say("LEVEL " .. n .. " - BOS DI UJUNG!", C(255, 140, 120), 2.4)
		else
			say("LEVEL " .. n, nil, 2)
		end
	end

	------------------------------------------------------------
	-- BOS
	------------------------------------------------------------
	local function bossShot(x, y, svx, svy, kind)
		local f, sw, sh3 = spr(front, kind, 3)
		bshots[#bshots + 1] = { f = f, x = x - sw / 2, y = y, vx = svx, vy = svy, w = sw, h = sh3 }
	end

	local function startBoss()
		bossOn = true
		safeX = math.max(safeX, lv.arenaL + 30)
		local tier = math.max(1, math.floor(L / 3))
		local def = BOSSES[(tier - 1) % #BOSSES + 1]
		local bf, bw, bh = spr(front, def.spr, 6, def.col)
		local bfl = spr(front, def.spr, 6, def.col, true)
		local hp = 6 + tier * 2
		boss = {
			f = bf, fl = bfl, w = bw, h = bh, x = lv.arenaR - bw - 30, y = gy - bh, vy = 0,
			hp = hp, max = hp, mode = def.mode, dir = -1, t = 0, shootT = 2, inv = 0,
			state = "idle", st = 0, spd = 70 + tier * 12, dead = false,
		}
		bossBar = new("Frame", {
			Position = UDim2.new(0.5, -90, 0, 34), Size = UDim2.fromOffset(180, 12),
			BackgroundColor3 = C(30, 30, 30), BorderSizePixel = 0,
		}, g.hud)
		new("UIStroke", { Color = Color3.new(0, 0, 0), Thickness = 2 }, bossBar)
		bossFill = new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = C(230, 60, 60), BorderSizePixel = 0 }, bossBar)
		local nl = label(bossBar, def.name, 11, UDim2.fromOffset(0, 12), UDim2.fromOffset(180, 14), Color3.new(1, 1, 1), Enum.TextXAlignment.Center)
		outline(nl)
		say("BOS: " .. def.name .. "!", C(255, 100, 100), 2.4)
	end

	local function damageBoss(n)
		local b = boss
		if not b or b.dead or b.inv > 0 then return end
		b.hp = b.hp - n
		b.inv = 0.7
		bossFill.Size = UDim2.fromScale(math.max(0, b.hp / b.max), 1)
		if b.hp <= 0 then
			b.dead = true
			b.f.Visible = false
			b.fl.Visible = false
			bossDone = true
			bossOn = false
			kills = kills + 5
			for _, t in ipairs(bshots) do t.f:Destroy() end
			bshots = {}
			clearLevel()
		end
	end

	local function updBoss(dt)
		local b = boss
		b.t = b.t + dt
		b.inv = math.max(0, b.inv - dt)
		local aL, aR = lv.arenaL, lv.arenaR
		local enrage = b.hp <= b.max / 2
		local sp = b.spd * (enrage and 1.4 or 1)
		local pcx = px + pw / 2
		local bcx = b.x + b.w / 2
		if b.mode == "walk" then
			b.x = b.x + b.dir * sp * dt
			if b.x < aL + 4 then
				b.x = aL + 4
				b.dir = 1
			elseif b.x + b.w > aR - 4 then
				b.x = aR - 4 - b.w
				b.dir = -1
			end
			b.vy = b.vy + 1500 * dt
			b.y = b.y + b.vy * dt
			if b.y >= gy - b.h then
				b.y = gy - b.h
				b.vy = 0
			end
			b.st = b.st - dt
			if b.st <= 0 and b.y >= gy - b.h - 0.5 then
				b.st = enrage and 1.4 or 2.0
				b.vy = -480
				local dx = (pcx > bcx) and 1 or -1
				bossShot(bcx, b.y + b.h * 0.4, dx * 230, 0, "fire")
			end
		elseif b.mode == "charge" then
			b.y = gy - b.h
			if b.state == "idle" then
				b.st = b.st + dt
				local dx = (pcx > bcx) and 1 or -1
				b.dir = dx
				b.x = math.clamp(b.x + dx * sp * 0.4 * dt, aL + 4, aR - 4 - b.w)
				if b.st > (enrage and 1.2 or 2) then
					b.state = "wind"
					b.st = 0
				end
			elseif b.state == "wind" then
				b.st = b.st + dt
				if b.st > 0.6 then
					b.state = "rush"
					b.st = 0
					b.dir = (pcx > bcx) and 1 or -1
				end
			elseif b.state == "rush" then
				b.x = b.x + b.dir * (300 + (enrage and 90 or 0)) * dt
				if b.x < aL + 4 then
					b.x = aL + 4
					b.state = "stun"
					b.st = 0
				elseif b.x + b.w > aR - 4 then
					b.x = aR - 4 - b.w
					b.state = "stun"
					b.st = 0
				end
			else
				b.st = b.st + dt
				if b.st > 1.1 then
					b.state = "idle"
					b.st = 0
				end
			end
		else
			local hoverY = gy - b.h - 50
			if b.state == "slam" then
				b.y = b.y + 380 * dt
				if b.y >= gy - b.h then
					b.y = gy - b.h
					b.state = "rise"
					b.st = 0
				end
			elseif b.state == "rise" then
				b.st = b.st + dt
				if b.st > 1.0 then
					b.y = b.y - 220 * dt
					if b.y <= hoverY then
						b.y = hoverY
						b.state = "idle"
						b.st = 0
					end
				end
			else
				local tx = pcx - b.w / 2
				b.x = math.clamp(b.x + math.clamp(tx - b.x, -sp * dt, sp * dt), aL + 4, aR - 4 - b.w)
				b.y = hoverY + math.sin(b.t * 2.2) * 14
				b.dir = (pcx > bcx) and 1 or -1
				b.st = b.st + dt
				b.shootT = b.shootT - dt
				if b.shootT <= 0 then
					b.shootT = enrage and 1.1 or 1.7
					bossShot(bcx, b.y + b.h, 0, 190, "bomb")
				end
				if b.st > (enrage and 3.5 or 5) then
					b.state = "slam"
					b.st = 0
				end
			end
		end
	end

	------------------------------------------------------------
	-- skill Sonic: homing attack / air dash
	------------------------------------------------------------
	local function startHoming()
		local best, bd = nil, 1e9
		local cx, cy = px + pw / 2, py + ph / 2
		for _, e in ipairs(E) do
			if e.k ~= "spike" then
				local dx, dy = e.x + e.w / 2 - cx, e.y + e.h / 2 - cy
				local dd = dx * dx + dy * dy
				if math.abs(dx) < 300 and math.abs(dy) < 200 and dx * face > -20 and dd < bd then
					best, bd = e, dd
				end
			end
		end
		if boss and not boss.dead then
			local dx, dy = boss.x + boss.w / 2 - cx, boss.y + boss.h / 2 - cy
			local dd = dx * dx + dy * dy
			if math.abs(dx) < 320 and math.abs(dy) < 220 and dd < bd then
				best, bd = boss, dd
			end
		end
		airUsed = true
		if best then
			target = best
			homingT = 0.55
		else
			airVx = face * (430 + 30 * wl)
			airDashT = 0.28
			vy = -10
		end
	end

	------------------------------------------------------------
	-- fisika pemain
	------------------------------------------------------------
	local function phys(h)
		px = px + vx * h
		local s = hitSolid(px, py, pw, ph)
		if s then
			if vx > 0 then
				px = s.x - pw
			elseif vx < 0 then
				px = s.x + s.w
			end
			vx = 0
			dashT = 0
			airDashT = 0
		end
		local lo = bossOn and (lv.arenaL + 2) or 0
		local hi = bossOn and lv.arenaR or lv.len
		if px < lo then
			px = lo
			if vx < 0 then vx = 0 end
		elseif px + pw > hi then
			px = hi - pw
			if vx > 0 then vx = 0 end
		end

		if homingT <= 0 and airDashT <= 0 then vy = vy + 1700 * h end
		vy = math.min(vy, 900)
		py = py + vy * h
		onGround = false
		local s2 = hitSolid(px, py, pw, ph)
		if s2 then
			if vy > 0 then
				py = s2.y - ph
				vy = 0
				onGround = true
				jumps = 0
				airUsed = false
				landed = s2
			elseif vy < 0 then
				py = s2.y + s2.h
				vy = 0
				bump(s2)
			end
		end
	end

	------------------------------------------------------------
	-- gambar semua
	------------------------------------------------------------
	local function render(dt)
		local tcam = px + pw / 2 - W * 0.4
		if bossOn then tcam = lv.arenaL end
		camX = math.clamp(tcam, 0, camMax)
		for _, s in ipairs(S) do
			if s.bump and s.bump > 0 then s.bump = s.bump - dt end
			put(s.f, s.x, s.y - (((s.bump or 0) > 0) and 6 or 0), s.w)
		end
		for _, e in ipairs(E) do put(e.f, e.x, e.y, e.w) end
		for _, c in ipairs(coinsL) do put(c.f, c.x, c.y, c.w) end
		if flag then put(flag.f, flag.x, flag.y, 40) end
		for _, s in ipairs(shots) do put(s.f, s.x, s.y, 10) end
		for _, s in ipairs(bshots) do put(s.f, s.x, s.y, s.w) end
		for i = #fx, 1, -1 do
			local t = fx[i]
			t.t = t.t - dt
			t.y = t.y - 70 * dt
			put(t.f, t.x, t.y, 18)
			if t.t <= 0 then
				t.f:Destroy()
				table.remove(fx, i)
			end
		end

		if boss and not boss.dead then
			local vis = boss.inv <= 0 or math.floor(boss.inv * 14) % 2 == 0
			if boss.state == "wind" and math.floor(boss.t * 12) % 2 == 0 then vis = false end
			local right = boss.dir > 0
			boss.f.Visible = vis and right
			boss.fl.Visible = vis and not right
			local pos = UDim2.fromOffset(math.floor(boss.x - camX), math.floor(boss.y))
			boss.f.Position = pos
			boss.fl.Position = pos
		end

		local vis = inv <= 0 or math.floor(inv * 12) % 2 == 0
		local cxp, cyp = px - camX + pw / 2, py + ph / 2
		local pos = UDim2.fromOffset(cxp, cyp)
		pf.Position = pos
		pfL.Position = pos
		pf.Visible = vis and face > 0
		pfL.Visible = vis and face < 0
		local rot = 0
		if dashT > 0 or boostT > 0 or homingT > 0 or airDashT > 0 then
			rot = ((os.clock() * 1080) % 360) * face
		elseif charge > 0 then
			rot = math.sin(os.clock() * 40) * 8
		end
		pf.Rotation = rot
		pfL.Rotation = rot
		chBg.Visible = charge > 0.02
		if chBg.Visible then
			chBg.Position = UDim2.fromOffset(cxp - 17, py - 12)
			chFill.Size = UDim2.fromScale(charge, 1)
		end
		if bbFill then
			local fr
			if boostT > 0 then
				fr = boostT / boostDur
			else
				fr = 1 - math.min(1, boostCD / boostMaxCD)
			end
			bbFill.Size = UDim2.fromScale(math.clamp(fr, 0, 1), 1)
		end
		g.setScore(score())
	end

	------------------------------------------------------------
	-- LOOP UTAMA
	------------------------------------------------------------
	g.tick(function(dt)
		if bannerT > 0 then
			bannerT = bannerT - dt
			if bannerT <= 0 then banner.Text = "" end
		end

		if state == "clear" then
			clearT = clearT - dt
			vx = 0
			phys(math.min(dt, 0.03))
			if clearT <= 0 then loadLevel(L + 1) end
			render(dt)
			return
		end

		-- input
		local dirIn = g.dir()
		if dirIn > 0.2 then
			face = 1
		elseif dirIn < -0.2 then
			face = -1
		end
		local jd = g.held or jumpBtn.down
		local a1, a2 = act1Down(g), act2Down(g)
		local a1p = a1 and not prevA1
		local a1r = (not a1) and prevA1
		local a2p = a2 and not prevA2
		inv = math.max(0, inv - dt)
		fireT = fireT - dt
		boostCD = math.max(0, boostCD - dt)
		if onGround then coyote = 0.1 else coyote = coyote - dt end

		-- lompat (tahan = lebih tinggi, double jump untuk tipe Sonic)
		if jd and not prevJ then
			if onGround or coyote > 0 then
				vy, jumps, onGround, coyote = jumpV, 1, false, 0
			elseif jumps < maxJ then
				jumps = jumps + 1
				vy = jumpV * 0.92
			end
		elseif prevJ and not jd and vy < -230 then
			vy = vy * 0.55
		end

		-- aksi 1 / aksi 2
		if not sonic then
			if a1 and fireT <= 0 then shoot() end
		else
			if onGround then
				if a1 and math.abs(vx) < 80 and dashT <= 0 then
					-- tahan = isi tenaga Spin Dash
					charge = math.min(1, charge + dt * (1.2 + 0.2 * wl))
				elseif a1r and charge > 0.2 then
					dashDur = 0.35 + 0.35 * charge
					dashT = dashDur
					dashF = face
					dashV = 360 + 280 * charge + 35 * wl
					charge = 0
				elseif a1p and math.abs(vx) >= 80 and dashT <= 0 then
					-- guling cepat saat berlari
					dashDur = 0.4
					dashT = 0.4
					dashF = face
					dashV = 380 + 35 * wl
				elseif not a1 then
					charge = 0
				end
			else
				charge = 0
				if a1p and homingT <= 0 and airDashT <= 0 and not airUsed then startHoming() end
			end
			if a2p and boostT <= 0 and boostCD <= 0 then
				boostT = boostDur
				boostCD = boostMaxCD + boostDur
				say(sk[3] .. "!", C(200, 140, 255), 0.8)
			end
		end

		-- timer skill
		if dashT > 0 then dashT = dashT - dt end
		if boostT > 0 then boostT = boostT - dt end
		if airDashT > 0 then
			airDashT = airDashT - dt
			if airDashT <= 0 then vx = math.clamp(vx, -maxSpd, maxSpd) end
		end
		if homingT > 0 then
			homingT = homingT - dt
			if homingT <= 0 then
				vx = math.clamp(vx, -maxSpd, maxSpd)
				vy = math.min(vy, 120)
			end
		end

		-- kecepatan horizontal
		if homingT > 0 and target then
			local tx = target.x + target.w / 2
			local ty = target.y + target.h / 2
			local dx, dy = tx - (px + pw / 2), ty - (py + ph / 2)
			local dd = math.sqrt(dx * dx + dy * dy) + 0.001
			vx, vy = dx / dd * 560, dy / dd * 560
		elseif airDashT > 0 then
			vx = airVx
			vy = -10
		elseif boostT > 0 then
			vx = face * (450 + 40 * wl)
		elseif dashT > 0 then
			vx = dashF * dashV * (0.6 + 0.4 * dashT / dashDur)
		else
			local tgt = dirIn * maxSpd
			local a
			if tgt == 0 or (vx ~= 0 and tgt * vx < 0) or math.abs(vx) > math.abs(tgt) then a = decel else a = accel end
			if not onGround then a = a * 0.75 end
			if vx < tgt then
				vx = math.min(tgt, vx + a * dt)
			else
				vx = math.max(tgt, vx - a * dt)
			end
		end

		-- fisika (dipecah supaya tidak tembus balok)
		local steps = math.max(1, math.ceil(dt / 0.0167))
		local hs = dt / steps
		for _ = 1, steps do phys(hs) end
		if onGround and landed and landed.k == "ground" and px > landed.x + 40 and px + pw < landed.x + landed.w - 40 then
			safeX = px
		end
		maxX = math.max(maxX, px)

		-- jatuh ke jurang
		if py > H + 70 then
			hurt(true)
			if not g.alive then return end
			respawn()
		end

		local attacking = dashT > 0 or boostT > 0 or homingT > 0 or airDashT > 0

		-- musuh bergerak + tabrakan
		for i = #E, 1, -1 do
			local e = E[i]
			e.t = e.t + dt
			if e.k ~= "spike" then
				e.x = e.x + e.dir * e.spd * dt
				if e.x < e.x1 then
					e.x = e.x1
					e.dir = 1
				elseif e.x + e.w > e.x2 then
					e.x = e.x2 - e.w
					e.dir = -1
				end
				if e.k == "fly" then
					e.y = e.base + math.sin(e.t * 2 + e.ph) * 28
				elseif e.k == "hop" then
					e.y = e.base - e.h - math.abs(math.sin(e.t * 3 + e.ph)) * 44
				end
			end
			if px + 5 < e.x + e.w and px + pw - 5 > e.x and py + 4 < e.y + e.h and py + ph > e.y + 2 then
				if e.k == "spike" then
					if not attacking then
						if hurt(false) then
							if not g.alive then return end
							vy = -330
						end
					end
				elseif attacking then
					killEnemy(i)
					if homingT > 0 then
						homingT = 0
						vy = -420
						jumps = 1
						airUsed = false
					end
				elseif vy > 50 and (py + ph) - e.y < 16 then
					killEnemy(i)
					vy = jd and -540 or -400
					jumps = 1
					inv = math.max(inv, 0.15)
				else
					if hurt(false) then
						if not g.alive then return end
						vy = -330
					end
				end
			end
		end

		-- koin
		for i = #coinsL, 1, -1 do
			local c = coinsL[i]
			if px < c.x + c.w and px + pw > c.x and py < c.y + c.h and py + ph > c.y then
				coins = coins + 1
				c.f:Destroy()
				table.remove(coinsL, i)
			end
		end

		-- tembakan pemain
		for i = #shots, 1, -1 do
			local s = shots[i]
			s.life = s.life - dt
			if bounceShot then s.vy = s.vy + 900 * dt end
			s.x = s.x + s.vx * dt
			local dead = s.life <= 0 or s.y > H + 20 or s.y < -20
			if not dead and hitSolid(s.x, s.y, 10, 10) then dead = true end
			if not dead then
				s.y = s.y + s.vy * dt
				local hs2 = hitSolid(s.x, s.y, 10, 10)
				if hs2 then
					if bounceShot and s.vy > 0 then
						s.y = hs2.y - 10
						s.vy = -260
					else
						dead = true
					end
				end
			end
			if not dead then
				for j = #E, 1, -1 do
					local e = E[j]
					if s.x + 10 > e.x and s.x < e.x + e.w and s.y + 10 > e.y and s.y < e.y + e.h then
						if e.k == "spike" then
							dead = true
							break
						end
						killEnemy(j)
						if not s.pierce then
							dead = true
							break
						end
					end
				end
			end
			if not dead and boss and not boss.dead then
				if s.x + 10 > boss.x and s.x < boss.x + boss.w and s.y + 10 > boss.y and s.y < boss.y + boss.h then
					damageBoss(s.dmg)
					dead = true
				end
			end
			if dead then
				s.f:Destroy()
				table.remove(shots, i)
			end
		end

		-- bos
		if lv.boss and not bossOn and not bossDone and px > lv.arenaL + 30 then startBoss() end
		if boss and not boss.dead then
			updBoss(dt)
			if px + 4 < boss.x + boss.w and px + pw - 4 > boss.x and py + 2 < boss.y + boss.h and py + ph > boss.y + 4 then
				if attacking then
					if boss.inv <= 0 then
						damageBoss(2)
						if boostT <= 0 then
							dashT, homingT, airDashT = 0, 0, 0
							vx = -face * 240
							vy = -320
							jumps = 1
							airUsed = false
						end
					end
				elseif vy > 50 and (py + ph) - boss.y < 22 and boss.inv <= 0 then
					damageBoss(1)
					vy = -520
					jumps = 1
					inv = math.max(inv, 0.35)
				elseif boss.inv <= 0 then
					if hurt(false) then
						if not g.alive then return end
						vy = -330
					end
				end
			end
		end
		for i = #bshots, 1, -1 do
			local b = bshots[i]
			b.x = b.x + b.vx * dt
			b.y = b.y + b.vy * dt
			local remove = b.y + b.h >= gy or b.x < -40 or b.x > lv.len + 40
			if px + 4 < b.x + b.w and px + pw - 4 > b.x and py + 4 < b.y + b.h and py + ph > b.y then
				remove = true
				if hurt(false) then
					if not g.alive then return end
					vy = -300
				end
			end
			if remove then
				b.f:Destroy()
				table.remove(bshots, i)
			end
		end

		-- bendera akhir level
		if flag and px + pw > flag.x - 6 and px < flag.x + 40 then clearLevel() end

		prevJ, prevA1, prevA2 = jd, a1, a2
		render(dt)
	end)

	loadLevel(1)
end

------------------------------------------------------------
-- FISIKA HILL CLIMB: bodi tegar + 2 roda dengan suspensi pegas, gravitasi, gaya mesin & rem, kontrol di udara
-- (koordinat layar: y ke bawah, sudut positif = searah jarum jam)
------------------------------------------------------------
local CAR = {
	G = 820, MASS = 1, INERTIA = 1000,
	L = 14, D = 5,         -- posisi gantungan roda terhadap pusat bodi
	S0 = 7, SMAX = 14,     -- panjang pegas normal / maksimum
	WR = 7,                -- jari-jari roda
	K = 110, CD = 7.5,     -- kekakuan pegas & peredam
	ENGINE = 700, BRAKE = 900, MU = 1.35,
	AIRTQ = 3600,          -- torsi kontrol di udara
	ADG = 600,             -- peredam putaran saat roda menyentuh tanah
	KA = 900, DA = 220,    -- bantuan stabil di udara (selaras dengan lereng)
}

local function newCar(ty, x0, power)
	local car = { x = x0, y = ty(x0) - 30, a = 0, vx = 0, vy = 0, w = 0, power = power or 1 }
	car.wheelLen = { CAR.S0, CAR.S0 }
	car.contact = { false, false }
	car.onGround = false
	car.crashed = false
	car.wheelSpin = 0

	local function slopeAt(x) return (ty(x + 1) - ty(x - 1)) / 2 end

	-- cari jarak sepanjang sinar (arah bawah bodi) sampai kena tanah
	local function rayGround(ax, ay, dx, dy, maxT)
		if ay >= ty(ax) then return 0 end
		local t = 0
		local step = 2
		while t < maxT do
			local nt = math.min(maxT, t + step)
			local px, py = ax + dx * nt, ay + dy * nt
			if py >= ty(px) then
				local lo, hi = t, nt
				for _ = 1, 4 do
					local mid = (lo + hi) / 2
					if ay + dy * mid >= ty(ax + dx * mid) then hi = mid else lo = mid end
				end
				return hi
			end
			t = nt
		end
		return nil
	end

	-- throttle: -1..1 (1 = gas maju). brake: true = pedal mundur/rem
	function car.step(h, gas, brake)
		local a = car.a
		local ca, sa = math.cos(a), math.sin(a)
		local fx, fy, tq = 0, CAR.G * CAR.MASS, 0
		local grounded = 0
		-- hambatan udara
		local sp = math.sqrt(car.vx * car.vx + car.vy * car.vy)
		fx = fx - 0.0026 * car.vx * sp
		fy = fy - 0.0026 * car.vy * sp
		for i = 1, 2 do
			local lx = (i == 1) and -CAR.L or CAR.L
			local rx, ry = lx * ca - CAR.D * sa, lx * sa + CAR.D * ca
			local ax, ay = car.x + rx, car.y + ry
			local dx, dy = -sa, ca
			local t = rayGround(ax, ay, dx, dy, CAR.SMAX + CAR.WR)
			car.contact[i] = false
			if t then
				local wl = math.max(2, t - CAR.WR)
				car.wheelLen[i] = math.min(CAR.SMAX, wl)
				local comp = CAR.S0 - wl
				if comp > -CAR.WR * 0 and t < CAR.S0 + CAR.WR then
					car.contact[i] = true
					grounded = grounded + 1
					-- kecepatan titik gantungan
					local vax = car.vx - car.w * ry
					local vay = car.vy + car.w * rx
					local vn = vax * dx + vay * dy -- positif = mendekati tanah
					local Fs = CAR.K * (CAR.S0 + CAR.WR - t) + CAR.CD * vn
					if Fs < 0 then Fs = 0 end
					local Fx, Fy = -dx * Fs, -dy * Fs
					fx, fy = fx + Fx, fy + Fy
					tq = tq + (rx * Fy - ry * Fx)
					-- gaya mesin / rem sepanjang tanah
					local cx = ax + dx * t
					local s = slopeAt(cx)
					local inv = 1 / math.sqrt(1 + s * s)
					local tx, ty2 = inv, s * inv
					local vT = car.vx * tx + car.vy * ty2
					local cap = CAR.MU * Fs
					local Ft = 0
					if gas > 0 then
						Ft = math.min(cap, CAR.ENGINE * 0.5 * gas * car.power)
						-- hambat kalau sudah terlalu cepat
						if vT > 520 then Ft = 0 end
					elseif brake then
						if vT > 12 then
							Ft = -math.min(cap, CAR.BRAKE * 0.5, vT * 40)
						else
							Ft = -math.min(cap, CAR.ENGINE * 0.5 * 0.6)
							if vT < -150 then Ft = 0 end
						end
					else
						Ft = -vT * 0.9 -- hambatan gelinding ringan
					end
					fx, fy = fx + tx * Ft, fy + ty2 * Ft
					tq = tq + (rx * (ty2 * Ft) - ry * (tx * Ft)) * 0.45
					car.wheelSpin = car.wheelSpin + vT / CAR.WR * h * 0.5
				end
			else
				car.wheelLen[i] = CAR.SMAX
			end
		end
		car.onGround = grounded > 0
		if grounded > 0 then
			tq = tq - car.w * CAR.ADG
			-- reaksi mesin: gas mengangkat hidung, rem menurunkan
			if gas > 0 then tq = tq - 90 * gas * grounded * car.power end
		else
			-- kontrol di udara (gas = hidung naik, rem = hidung turun)
			if gas > 0 then tq = tq - CAR.AIRTQ * gas end
			if brake then tq = tq + CAR.AIRTQ end
			-- bantuan lembut: hidung cenderung sejajar lereng di depan (bisa dikalahkan oleh pedal)
			local sl = (ty(car.x + 40) - ty(car.x - 10)) / 50
			local err = car.a - math.atan(sl)
			err = (err + math.pi) % (2 * math.pi) - math.pi
			tq = tq - CAR.KA * err - CAR.DA * car.w
		end

		-- tabrakan sudut bawah bodi (memantul, tidak fatal)
		for _, lx in ipairs({ -18, 18 }) do
			local ly = 8
			local rx, ry = lx * ca - ly * sa, lx * sa + ly * ca
			local px, py = car.x + rx, car.y + ry
			local g0 = ty(px)
			if py > g0 then
				local vpx = car.vx - car.w * ry
				local vpy = car.vy + car.w * rx
				local Fy = -(py - g0) * 700 - math.min(0, vpy) * 0 - vpy * 4
				if Fy > 0 then Fy = 0 end
				local Fx = -vpx * 3
				fx, fy = fx + Fx, fy + Fy
				tq = tq + (rx * Fy - ry * Fx)
			end
		end

		-- integrasi
		car.vx = car.vx + fx / CAR.MASS * h
		car.vy = car.vy + fy / CAR.MASS * h
		car.w = car.w + tq / CAR.INERTIA * h
		car.w = math.max(-9, math.min(9, car.w))
		car.x = car.x + car.vx * h
		car.y = car.y + car.vy * h
		car.a = car.a + car.w * h

		-- kepala / atap menyentuh tanah = kecelakaan
		local ca2, sa2 = math.cos(car.a), math.sin(car.a)
		for _, pt in ipairs({ { 2, -14 } }) do
			local px = car.x + pt[1] * ca2 - pt[2] * sa2
			local py = car.y + pt[1] * sa2 + pt[2] * ca2
			if py >= ty(px) - 0.5 then car.crashed = true end
		end
	end

	function car.update(dt, gas, brake)
		dt = math.min(dt, 1 / 20)
		local n = math.max(4, math.ceil(dt / 0.0022))
		local h = dt / n
		for _ = 1, n do car.step(h, gas, brake) end
	end

	function car.respawn(x)
		car.x, car.y, car.a, car.vx, car.vy, car.w = x, ty(x) - 32, 0, math.max(0, car.vx * 0.3), 0, 0
		car.crashed = false
	end

	return car
end

