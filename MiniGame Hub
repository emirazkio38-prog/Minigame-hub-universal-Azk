-- ENGINE: GAMBAR PIXEL (kanvas, palet warna, pensil, penghapus, isi warna, undo)
------------------------------------------------------------
ENG.draw = function(w, g)
	local W, H = g.W, g.H
	g.noLives = true
	g.setLives()
	local GW, GH = 36, 24
	local cp = math.max(4, math.floor(math.min((W - 150) / GW, (H - 52) / GH)))
	local cw, ch = GW * cp, GH * cp
	local ox = 6
	local oy = math.floor((H - ch) / 2) + 12
	local PALETTE = {
		C(0, 0, 0), C(80, 80, 90), C(160, 160, 170), C(255, 255, 255), C(230, 50, 50), C(250, 140, 40), C(250, 220, 60), C(150, 220, 60),
		C(40, 170, 80), C(30, 160, 160), C(70, 200, 240), C(50, 100, 230), C(130, 70, 210), C(240, 120, 190), C(130, 80, 40), C(250, 205, 160),
	}
	local WHITE = C(255, 255, 255)
	local frame = new("Frame", { Position = UDim2.fromOffset(ox - 2, oy - 2), Size = UDim2.fromOffset(cw + 4, ch + 4), BackgroundColor3 = C(40, 40, 60), BorderSizePixel = 0 }, w)
	new("UIStroke", { Color = Color3.new(1, 1, 1), Thickness = 2, LineJoinMode = Enum.LineJoinMode.Miter }, frame)
	local cells, data = {}, {}
	for y = 1, GH do
		for x = 1, GW do
			local i = (y - 1) * GW + x
			data[i] = 0
			cells[i] = new("Frame", {
				Position = UDim2.fromOffset(2 + (x - 1) * cp, 2 + (y - 1) * cp), Size = UDim2.fromOffset(cp - ((cp >= 6) and 1 or 0), cp - ((cp >= 6) and 1 or 0)),
				BackgroundColor3 = WHITE, BorderSizePixel = 0,
			}, frame)
		end
	end
	local function colorOf(v) return (v == 0) and WHITE or PALETTE[v] end

	local cur, tool, size = 1, "pensil", 1
	local hist, stroke = {}, nil
	local lastCell = nil

	local function setCell(i, v)
		if data[i] == v then return end
		if stroke then stroke[#stroke + 1] = { i, data[i] } end
		data[i] = v
		cells[i].BackgroundColor3 = colorOf(v)
	end
	local function brushAt(cx, cy, v)
		for dy = 0, size - 1 do
			for dx = 0, size - 1 do
				local x, y = cx + dx - math.floor((size - 1) / 2), cy + dy - math.floor((size - 1) / 2)
				if x >= 1 and x <= GW and y >= 1 and y <= GH then setCell((y - 1) * GW + x, v) end
			end
		end
	end
	local function line(x0, y0, x1, y1, v)
		local dx, dy = math.abs(x1 - x0), math.abs(y1 - y0)
		local sx, sy = (x0 < x1) and 1 or -1, (y0 < y1) and 1 or -1
		local err = dx - dy
		while true do
			brushAt(x0, y0, v)
			if x0 == x1 and y0 == y1 then break end
			local e2 = 2 * err
			if e2 > -dy then err = err - dy x0 = x0 + sx end
			if e2 < dx then err = err + dx y0 = y0 + sy end
		end
	end
	local function flood(cx, cy, v)
		local start = (cy - 1) * GW + cx
		local from = data[start]
		if from == v then return end
		local q, head = { start }, 1
		setCell(start, v)
		while head <= #q do
			local i = q[head]
			head = head + 1
			local x, y = (i - 1) % GW + 1, (i - 1) // GW + 1
			for _, nb in ipairs({ { x - 1, y }, { x + 1, y }, { x, y - 1 }, { x, y + 1 } }) do
				if nb[1] >= 1 and nb[1] <= GW and nb[2] >= 1 and nb[2] <= GH then
					local j = (nb[2] - 1) * GW + nb[1]
					if data[j] == from then
						setCell(j, v)
						q[#q + 1] = j
					end
				end
			end
		end
	end
	local function commit()
		if stroke and #stroke > 0 then
			hist[#hist + 1] = stroke
			if #hist > 40 then table.remove(hist, 1) end
		end
		stroke = nil
	end
	local function undo()
		local s = table.remove(hist)
		if not s then return end
		for k = #s, 1, -1 do
			data[s[k][1]] = s[k][2]
			cells[s[k][1]].BackgroundColor3 = colorOf(s[k][2])
		end
		g.sfx("click")
	end

	local function cellAt()
		local x = math.floor((g.ptr.x - ox) / cp) + 1
		local y = math.floor((g.ptr.y - oy) / cp) + 1
		if x >= 1 and x <= GW and y >= 1 and y <= GH then return x, y end
		return nil
	end

	-- panel kanan: palet + alat
	local px0 = ox + cw + 10
	local sw = 18
	local swatches = {}
	local function paintSw()
		for i, b in ipairs(swatches) do
			b.UIStroke.Color = (i == cur) and Color3.new(1, 1, 0) or Color3.new(0, 0, 0)
			b.UIStroke.Thickness = (i == cur) and 3 or 1
		end
	end
	for i = 1, #PALETTE do
		local col, row = (i - 1) % 4, (i - 1) // 4
		local b = new("TextButton", {
			Position = UDim2.fromOffset(px0 + col * (sw + 3), oy + row * (sw + 3)), Size = UDim2.fromOffset(sw, sw),
			BackgroundColor3 = PALETTE[i], Text = "", AutoButtonColor = false, BorderSizePixel = 0, Selectable = false,
		}, g.hud)
		new("UIStroke", { Color = Color3.new(0, 0, 0), Thickness = 1, LineJoinMode = Enum.LineJoinMode.Miter }, b)
		b.Activated:Connect(function()
			cur = i
			if tool == "hapus" then tool = "pensil" end
			g.sfx("click")
			paintSw()
		end)
		swatches[i] = b
	end
	paintSw()
	local ty0 = oy + 4 * (sw + 3) + 4
	local tbtns = {}
	local function mkTool(text, y, fn, key)
		local b = mkBtn(g.hud, text, UDim2.fromOffset(px0, y), UDim2.fromOffset(4 * (sw + 3) - 3, 22), C(50, 90, 190))
		b.TextSize = 11
		b.Selectable = false
		b.Activated:Connect(function()
			g.sfx("click")
			fn()
		end)
		if key then tbtns[key] = b end
		return b
	end
	local function paintTools()
		for k, b in pairs(tbtns) do b.BackgroundColor3 = (tool == k) and C(230, 150, 40) or C(50, 90, 190) end
	end
	mkTool("PENSIL", ty0, function() tool = "pensil" paintTools() end, "pensil")
	mkTool("HAPUS", ty0 + 25, function() tool = "hapus" paintTools() end, "hapus")
	mkTool("ISI", ty0 + 50, function() tool = "isi" paintTools() end, "isi")
	local sizeB = mkTool("UKURAN 1", ty0 + 75, function()
		size = size % 3 + 1
	end)
	mkTool("UNDO", ty0 + 100, undo)
	mkTool("BERSIH", ty0 + 125, function()
		stroke = {}
		for i = 1, #data do setCell(i, 0) end
		commit()
	end)
	paintTools()
	local hint = label(g.hud, "GAMBAR PIXEL", 12, UDim2.new(0, ox, 0, 34), UDim2.fromOffset(200, 14), C(160, 200, 255))

	g.onPress(function()
		local x, y = cellAt()
		if not x then return end
		stroke = {}
		lastCell = { x, y }
		if tool == "isi" then
			flood(x, y, cur)
			commit()
			lastCell = nil
			g.sfx("pop")
		else
			brushAt(x, y, (tool == "hapus") and 0 or cur)
		end
	end)

	g.tick(function(dt)
		sizeB.Text = "UKURAN " .. size
		if g.held and stroke and tool ~= "isi" then
			local x, y = cellAt()
			if x and lastCell and (x ~= lastCell[1] or y ~= lastCell[2]) then
				line(lastCell[1], lastCell[2], x, y, (tool == "hapus") and 0 or cur)
				lastCell = { x, y }
			elseif x and not lastCell then
				lastCell = { x, y }
			end
		elseif not g.held and stroke then
			commit()
			lastCell = nil
		end
	end)
end

------------------------------------------------------------
-- ENGINE 3: SHOOTER VERTIKAL (Space Invaders dkk)
------------------------------------------------------------
local ENM = {
	alien = { hp = 1, pts = 1, spr = "alien", shoot = true },
	ufo = { hp = 2, pts = 2, spr = "ufo", shoot = true },
	rock = { hp = 3, pts = 2, spr = "rock" },
}
ENG.shoot = function(w, g)
	local cfg, W, H = g.cfg, g.W, g.H
	local sf, sw, sh2 = spr(w, cfg.spr, 3, skc(g))
	g.mkPadLR()
	local sx, sy = W / 2, H - sh2 - 14
	g.lives = 3 + g.extra + (g.skin >= 2 and 1 or 0)
	g.setLives()
	local wp = g.weapon
	local rate = ({ 0.45, 0.32, 0.3, 0.28 })[wp + 1]
	local dmg = wp >= 3 and 2 or 1
	local bcol = ({ C(255, 240, 120), C(120, 230, 255), C(255, 120, 230), C(255, 255, 255) })[wp + 1]
	local bullets, enemies, ebul = {}, {}, {}
	local fireT, spawnT, t, score, inv = 0, 0.8, 0, 0, 0

	local function shot(dx, vxs)
		local f = new("Frame", { Size = UDim2.fromOffset(4, 12), BackgroundColor3 = bcol, BorderSizePixel = 0 }, w)
		bullets[#bullets + 1] = { f = f, x = sx + dx, y = sy, vx = vxs }
	end
	local function spawn()
		local kind = cfg.en[math.random(#cfg.en)]
		local d = ENM[kind]
		local f, ew, eh = spr(w, d.spr, 3, cfg.ecol or COL.g)
		local x0 = math.random(10, math.max(11, W - ew - 10))
		enemies[#enemies + 1] = {
			f = f, x = x0, x0 = x0, y = -eh, w = ew, h = eh, hp = d.hp, pts = d.pts, sh = d.shoot,
			st = math.random(15, 40) / 10, ph = math.random() * 6,
		}
	end
	local function hurt()
		if inv > 0 then return end
		inv = 1.3
		g.lives = g.lives - 1
		g.setLives()
		if g.lives <= 0 then g.finish(score) end
	end

	g.tick(function(dt)
		t = t + dt
		local dir = g.dir()
		if dir ~= 0 then
			sx = sx + dir * 340 * dt
		elseif not g.ptrLock then
			sx = sx + math.clamp(g.ptr.x - sx, -380 * dt, 380 * dt)
		end
		sx = math.clamp(sx, sw / 2, W - sw / 2)
		sf.Position = UDim2.fromOffset(sx - sw / 2, sy)
		inv = math.max(0, inv - dt)
		sf.Visible = inv <= 0 or math.floor(inv * 10) % 2 == 0

		fireT = fireT - dt
		if fireT <= 0 then
			fireT = rate
			if wp <= 1 then
				shot(0, 0)
			elseif wp == 2 then
				shot(-8, 0)
				shot(8, 0)
			else
				shot(-10, -60)
				shot(0, 0)
				shot(10, 60)
			end
		end
		spawnT = spawnT - dt
		if spawnT <= 0 then
			spawnT = math.max(0.35, 1.1 - t * 0.01)
			spawn()
		end

		for i = #bullets, 1, -1 do
			local b = bullets[i]
			b.y = b.y - 520 * dt
			b.x = b.x + b.vx * dt
			b.f.Position = UDim2.fromOffset(b.x - 2, b.y)
			local dead = b.y < -20
			if not dead then
				for _, e in ipairs(enemies) do
					if not e.dead and b.x > e.x - 2 and b.x < e.x + e.w + 2 and b.y < e.y + e.h and b.y + 12 > e.y then
						e.hp = e.hp - dmg
						dead = true
						if e.hp <= 0 then
							e.dead = true
							score = score + e.pts
						end
						break
					end
				end
			end
			if dead then
				b.f:Destroy()
				table.remove(bullets, i)
			end
		end

		local espd = math.min(45 + t * 0.8, 120)
		for i = #enemies, 1, -1 do
			local e = enemies[i]
			if e.dead then
				e.f:Destroy()
				table.remove(enemies, i)
			else
				e.y = e.y + espd * dt
				if e.sh then
					e.x = math.clamp(e.x0 + math.sin(t * 1.6 + e.ph) * 22, 0, W - e.w)
					e.st = e.st - dt
					if e.st <= 0 and e.y > 0 then
						e.st = math.random(20, 45) / 10
						local bf = new("Frame", { Size = UDim2.fromOffset(4, 10), BackgroundColor3 = C(255, 80, 80), BorderSizePixel = 0 }, w)
						ebul[#ebul + 1] = { f = bf, x = e.x + e.w / 2, y = e.y + e.h }
					end
				end
				e.f.Position = UDim2.fromOffset(e.x, e.y)
				local hitP = inv <= 0 and e.x < sx + sw / 2 - 4 and e.x + e.w > sx - sw / 2 + 4 and e.y + e.h > sy + 4 and e.y < sy + sh2
				if hitP or e.y > H - 8 then
					e.dead = true
					hurt()
					if not g.alive then return end
				end
			end
		end

		for i = #ebul, 1, -1 do
			local b = ebul[i]
			b.y = b.y + 170 * dt
			b.f.Position = UDim2.fromOffset(b.x - 2, b.y)
			local remove = b.y > H
			if inv <= 0 and b.x > sx - sw / 2 + 3 and b.x < sx + sw / 2 - 3 and b.y + 10 > sy + 4 and b.y < sy + sh2 then
				remove = true
				hurt()
			end
			if remove then
				b.f:Destroy()
				table.remove(ebul, i)
			end
			if not g.alive then return end
		end
		g.setScore(score)
	end)
end

