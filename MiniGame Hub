-- ENGINE 2: HILL CLIMB (fisika asli: gravitasi, suspensi pegas, mobil bisa terbang & jungkir balik)
------------------------------------------------------------
ENG.climb = function(w, g)
	local cfg, W, H = g.cfg, g.W, g.H
	local grd = GRD[cfg.sky] or GRD.day
	local rough = cfg.rough or 1
	local function ty(x)
		local a = math.clamp(0.2 + x / 8000, 0.2, 0.85) * rough
		local ramp = math.clamp(x / 400, 0, 1)
		return -ramp * a * (math.sin(x * 0.010) * 40 + math.sin(x * 0.0237 + 1.7) * 22 + math.sin(x * 0.052 + 0.3) * 3)
	end
	local colW = 6
	local n = math.ceil(W / colW) + 2
	local cols = {}
	for i = 1, n do
		local top = new("Frame", { BackgroundColor3 = grd[2], BorderSizePixel = 0, Size = UDim2.fromOffset(colW, 5) }, w)
		local dirt = new("Frame", { BackgroundColor3 = grd[1], BorderSizePixel = 0 }, w)
		cols[i] = { top = top, dirt = dirt }
	end

	local car = newCar(ty, 0, 1 + 0.08 * g.skin)
	local bodyF = spr(w, "carbody", 3, skc(g))
	bodyF.AnchorPoint = Vector2.new(0.5, 0.5)
	local wheels = {}
	for i = 1, 2 do
		local wf = new("Frame", { Size = UDim2.fromOffset(15, 15), AnchorPoint = Vector2.new(0.5, 0.5), BackgroundColor3 = C(22, 22, 28), BorderSizePixel = 0 }, w)
		new("UICorner", { CornerRadius = UDim.new(1, 0) }, wf)
		local hub = new("Frame", { Size = UDim2.fromOffset(7, 7), Position = UDim2.fromScale(0.5, 0.5), AnchorPoint = Vector2.new(0.5, 0.5), BackgroundColor3 = C(170, 175, 190), BorderSizePixel = 0 }, wf)
		new("UICorner", { CornerRadius = UDim.new(1, 0) }, hub)
		new("Frame", { Size = UDim2.fromOffset(2, 13), Position = UDim2.fromScale(0.5, 0.5), AnchorPoint = Vector2.new(0.5, 0.5), BackgroundColor3 = C(240, 240, 250), BorderSizePixel = 0 }, wf)
		wheels[i] = wf
	end

	local vx = W * 0.3
	local maxFuel = 100 + g.skin * 20
	local fuel = maxFuel
	local bonus, nextP = 0, 300
	local picks = {}
	g.lives = 1 + g.extra
	g.setLives()
	local camY = car.y
	local invul, airT, rotAcc = 1.0, 0, 0
	local popT = 0

	local brk = g.holdBtn("MUNDUR", UDim2.new(0, 10, 1, -60), UDim2.fromOffset(90, 50), C(170, 60, 50))
	local gas = g.holdBtn("MAJU", UDim2.new(1, -100, 1, -60), UDim2.fromOffset(90, 50), C(40, 150, 70))
	local fbg = new("Frame", { Position = UDim2.new(0.5, -60, 0, 10), Size = UDim2.fromOffset(120, 12), BackgroundColor3 = C(30, 30, 30), BorderSizePixel = 0 }, g.hud)
	new("UIStroke", { Color = C(0, 0, 0), Thickness = 2 }, fbg)
	local ffill = new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = C(255, 200, 40), BorderSizePixel = 0 }, fbg)
	local fl = label(g.hud, "BENSIN", 10, UDim2.new(0.5, -60, 0, 23), UDim2.fromOffset(120, 12), Color3.new(1, 1, 1), Enum.TextXAlignment.Center)
	outline(fl)
	local pop = label(g.hud, "", 20, UDim2.new(0.5, -120, 0, 44), UDim2.fromOffset(240, 26), C(255, 230, 90), Enum.TextXAlignment.Center)
	outline(pop)

	local function say(t)
		pop.Text = t
		popT = 1.2
	end
	local function sc() return math.floor(car.x / 50) + bonus end

	g.tick(function(dt)
		local stx = padStick()
		local gasOn = gas.down or UIS:IsKeyDown(KC.D) or UIS:IsKeyDown(KC.Right) or UIS:IsKeyDown(KC.Up) or padBtn(KC.DPadRight) or padBtn(KC.ButtonR2) or padBtn(KC.ButtonA) or stx > 0.3
		local brkOn = brk.down or UIS:IsKeyDown(KC.A) or UIS:IsKeyDown(KC.Left) or UIS:IsKeyDown(KC.Down) or padBtn(KC.DPadLeft) or padBtn(KC.ButtonL2) or padBtn(KC.ButtonB) or stx < -0.3
		local gasIn = 0
		if gasOn and fuel > 0 then
			gasIn = 1
			fuel = fuel - 9 * dt
		end
		if invul > 0 then invul = invul - dt end
		local wasGround = car.onGround
		car.update(dt, gasIn, brkOn)
		if car.x < 0 then
			car.x = 0
			if car.vx < 0 then car.vx = 0 end
		end
		-- waktu di udara, jungkir balik
		if car.onGround then
			if not wasGround and airT > 0.25 then g.sfx("land") end
			if airT > 0.9 then
				local b = math.floor(airT * 6)
				bonus = bonus + b
				say("MELAYANG +" .. b)
			end
			if math.abs(rotAcc) > 5.6 then
				bonus = bonus + 30
				say("JUNGKIR BALIK +30")
				g.sfx("win")
			end
			airT, rotAcc = 0, 0
		else
			airT = airT + dt
			rotAcc = rotAcc + car.w * dt
		end
		if popT > 0 then
			popT = popT - dt
			if popT <= 0 then pop.Text = "" end
		end
		-- kecelakaan: kepala kena tanah
		if car.crashed then
			if invul > 0 then
				car.crashed = false
			else
				g.sfx("boom")
				g.lives = g.lives - 1
				g.setLives()
				if g.lives <= 0 then
					g.finish(sc())
					return
				end
				car.respawn(car.x)
				invul = 1.6
				say("NYAWA BERKURANG")
			end
		end

		-- kamera
		local camX = car.x - vx
		camY = camY + (car.y - camY) * math.min(1, 3.5 * dt)
		local oy = H * 0.55 - camY
		local off = camX % colW
		for i = 1, n do
			local sx = (i - 1) * colW - off
			local y = ty(camX + sx + colW / 2) + oy
			local c = cols[i]
			c.top.Position = UDim2.fromOffset(sx, y)
			c.dirt.Position = UDim2.fromOffset(sx, y + 5)
			c.dirt.Size = UDim2.fromOffset(colW, math.max(1, H - y))
		end
		-- gambar mobil
		bodyF.Position = UDim2.fromOffset(vx, car.y + oy)
		bodyF.Rotation = math.deg(car.a)
		local ca, sa = math.cos(car.a), math.sin(car.a)
		for i = 1, 2 do
			local lx = (i == 1) and -CAR.L or CAR.L
			local len = car.wheelLen[i]
			local px = lx * ca - (CAR.D + len) * sa
			local py = lx * sa + (CAR.D + len) * ca
			wheels[i].Position = UDim2.fromOffset(vx + px, car.y + oy + py)
			wheels[i].Rotation = math.deg(car.wheelSpin)
		end
		bodyF.Visible = invul <= 0 or math.floor(invul * 10) % 2 == 0
		ffill.Size = UDim2.fromScale(math.clamp(fuel / maxFuel, 0, 1), 1)

		-- pickup
		while nextP < car.x + W do
			local r = math.random()
			local kind = "coin"
			if r >= 0.6 and r < 0.8 then kind = "gas" elseif r >= 0.8 and cfg.haz then kind = cfg.haz end
			local f, pw2, ph2 = spr(w, kind, 3, kind == "mush" and C(170, 100, 50) or nil)
			local hgt = (kind == "coin") and math.random(16, 60) or 18
			picks[#picks + 1] = { f = f, x = nextP, k = kind, w = pw2, h = ph2, oy = hgt }
			nextP = nextP + math.random(130, 260)
		end
		for i = #picks, 1, -1 do
			local p = picks[i]
			local sx = vx + (p.x - car.x)
			local py = ty(p.x) - p.oy
			p.f.Position = UDim2.fromOffset(sx - p.w / 2, py + oy - p.h / 2)
			local remove = sx < -60
			local dx, dy = p.x - car.x, py - car.y
			if dx * dx + dy * dy < 26 * 26 then
				remove = true
				if p.k == "coin" then
					bonus = bonus + 5
					g.sfx("coin")
				elseif p.k == "gas" then
					fuel = math.min(maxFuel, fuel + 35)
					g.sfx("blip")
				elseif p.k == "mush" then
					bonus = bonus + 3
					car.vx = car.vx * 0.6
				else
					car.vx = car.vx * 0.35
					g.lives = g.lives - 1
					g.setLives()
					g.sfx("hurt")
				end
			end
			if remove then
				p.f:Destroy()
				table.remove(picks, i)
			end
		end
		g.setScore(sc())
		local speed = math.sqrt(car.vx * car.vx + car.vy * car.vy)
		if g.lives <= 0 or (fuel <= 0 and speed < 8 and car.onGround) then g.finish(sc()) end
	end)
end

