local sfxLast = {}
local function sfx(name)
	if not sfxOn then return end
	local d = SFXDEF[name]
	if not d then return end
	local now = os.clock()
	if now - (sfxLast[name] or 0) < 0.06 then return end
	sfxLast[name] = now
	pcall(function()
		local s = Instance.new("Sound")
		s.SoundId = d[1]
		s.PlaybackSpeed = d[2]
		s.Volume = d[3]
		s.Parent = SoundService
		s.Ended:Connect(function() s:Destroy() end)
		s:Play()
		task.delay(4, function() if s.Parent then s:Destroy() end end)
	end)
end
-- suara saat menekan layar, per jenis game
local SFX_QUIET = { chess = true, ttt = true, blast = true, draw = true, road = true, climb = true, sonic = true, dan = true, ludo = true, ladder = true, rings = true, merge = true }
local SFX_PRESS = { run = "jump", jump = "jump", flap = "jump", shoot = "shoot", tap = "hit", lane = "click", pet = "click", rpg = "hit" }

local function skc(g)
	if g.skin > 0 then return SKINCOL[g.skin] end
	return g.cfg.col
end

local function isPointer(i)
	return i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch
end

function F.start(idx)
	F.stop()
	pcall(function()
		GuiService.AutoSelectGuiEnabled = false
		GuiService.SelectedObject = nil
	end)
	local cfg = GAMES[idx]
	U.area.Visible = true
	local canvas = new("TextButton", {
		Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(1, 1, 1), Text = "", AutoButtonColor = false,
		ClipsDescendants = true, BorderSizePixel = 0,
	}, U.area)
	local sky = new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0, ZIndex = 1 }, canvas)
	local world = new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, ZIndex = 2 }, canvas)
	local hud = new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, ZIndex = 10 }, canvas)
	local eq = eqOf(idx)

	local g = {
		cfg = cfg, idx = idx, canvas = canvas, hud = hud, conns = {}, alive = true, held = false,
		skin = eq.s, weapon = eq.w, extra = data.owned.life and 1 or 0, lives = 1, score = -1,
		W = 480, H = 300, ptr = { x = 240, y = 150 }, onP = {}, clouds = {},
	}
	current = g

	local scoreLbl = label(hud, "SKOR: 0", 16, UDim2.fromOffset(8, 6), UDim2.fromOffset(160, 20))
	local livesLbl = label(hud, "", 16, UDim2.fromOffset(8, 26), UDim2.fromOffset(160, 20), C(255, 120, 120))
	outline(scoreLbl)
	outline(livesLbl)
	local exitBtn = mkBtn(hud, "KELUAR", UDim2.new(1, -78, 0, 6), UDim2.fromOffset(70, 26), C(160, 40, 40))
	exitBtn.Selectable = false
	canvas.Selectable = false
	exitBtn.Activated:Connect(function() F.stop() end)

	g.sfx = sfx
	local sfxBtn = mkBtn(hud, sfxOn and "SUARA: ON" or "SUARA: OFF", UDim2.new(1, -164, 0, 6), UDim2.fromOffset(80, 26), C(60, 90, 160))
	sfxBtn.TextSize = 11
	sfxBtn.Selectable = false
	sfxBtn.Activated:Connect(function()
		sfxOn = not sfxOn
		sfxBtn.Text = sfxOn and "SUARA: ON" or "SUARA: OFF"
		if sfxOn then sfx("click") end
	end)

	function g.setScore(n)
		if n ~= g.score then
			if n > (g.score or 0) and not SFX_QUIET[cfg.eng] then sfx("coin") end
			g.score = n
			scoreLbl.Text = "SKOR: " .. n
		end
	end
	local lastLives = nil
	function g.setLives()
		if g.noLives then
			livesLbl.Text = ""
			return
		end
		if lastLives and g.lives < lastLives and not SFX_QUIET[cfg.eng] then sfx("hurt") end
		lastLives = g.lives
		livesLbl.Text = "NYAWA: " .. g.lives
	end
	function g.connect(c)
		table.insert(g.conns, c)
		return c
	end
	function g.onPress(f) table.insert(g.onP, f) end
	function g.tick(fn)
		g.connect(RunService.Heartbeat:Connect(function(dt)
			if g.alive then fn(math.min(dt, 0.05)) end
		end))
	end
	function g.holdBtn(text, pos, size, color)
		local st = { down = false }
		local b = mkBtn(hud, text, pos, size, color)
		b.TextSize = 18
		b.InputBegan:Connect(function(i)
			if isPointer(i) then
				st.down = true
				st.inp = i
			end
		end)
		g.connect(UIS.InputEnded:Connect(function(i)
			if i == st.inp or (i.UserInputType == Enum.UserInputType.MouseButton1 and st.inp ~= nil) then
				st.down = false
				st.inp = nil
			end
		end))
		b.Selectable = false
		st.btn = b
		return st
	end

	-- kontrol gabungan: keyboard + controller + tombol layar
	function g.dir()
		local d = keyDir()
		if g.padL and g.padL.down then d = d - 1 end
		if g.padR and g.padR.down then d = d + 1 end
		d = math.clamp(d, -1, 1)
		if d ~= 0 then g.ptrLock = true end
		return d
	end
	function g.vdir()
		local d = keyVert()
		if g.padU and g.padU.down then d = d - 1 end
		if g.padD and g.padD.down then d = d + 1 end
		d = math.clamp(d, -1, 1)
		if d ~= 0 then g.ptrLock = true end
		return d
	end
	local function soft(st)
		st.btn.BackgroundTransparency = 0.45
		st.btn.TextSize = 22
		return st
	end
	function g.mkPadLR()
		g.padL = soft(g.holdBtn("<", UDim2.new(0, 10, 1, -62), UDim2.fromOffset(64, 52), C(60, 60, 70)))
		g.padR = soft(g.holdBtn(">", UDim2.new(0, 84, 1, -62), UDim2.fromOffset(64, 52), C(60, 60, 70)))
	end
	function g.mkPadUD()
		g.padU = soft(g.holdBtn("^", UDim2.new(0, 10, 1, -128), UDim2.fromOffset(56, 56), C(60, 60, 70)))
		g.padD = soft(g.holdBtn("v", UDim2.new(0, 10, 1, -66), UDim2.fromOffset(56, 56), C(60, 60, 70)))
	end
	function g.mkPad4()
		g.p4 = {}
		local specs = { { "u", "^", -102, -150 }, { "l", "<", -152, -100 }, { "r", ">", -52, -100 }, { "d", "v", -102, -50 } }
		for _, sp in ipairs(specs) do
			g.p4[sp[1]] = soft(g.holdBtn(sp[2], UDim2.new(1, sp[3], 1, sp[4]), UDim2.fromOffset(46, 46), C(60, 60, 70)))
		end
	end
	function g.dir4()
		local sx, sy = padStick()
		local p = g.p4
		local l = UIS:IsKeyDown(KC.A) or UIS:IsKeyDown(KC.Left) or padBtn(KC.DPadLeft) or sx < -0.5 or (p ~= nil and p.l.down)
		local r = UIS:IsKeyDown(KC.D) or UIS:IsKeyDown(KC.Right) or padBtn(KC.DPadRight) or sx > 0.5 or (p ~= nil and p.r.down)
		local u = UIS:IsKeyDown(KC.W) or UIS:IsKeyDown(KC.Up) or padBtn(KC.DPadUp) or sy > 0.5 or (p ~= nil and p.u.down)
		local d = UIS:IsKeyDown(KC.S) or UIS:IsKeyDown(KC.Down) or padBtn(KC.DPadDown) or sy < -0.5 or (p ~= nil and p.d.down)
		return l and true or false, r and true or false, u and true or false, d and true or false
	end

	local function press()
		g.held = true
		if SFX_PRESS[cfg.eng] then sfx(SFX_PRESS[cfg.eng]) end
		for _, f in ipairs(g.onP) do f() end
	end
	local function updPtr(i)
		g.ptr.x = i.Position.X - canvas.AbsolutePosition.X
		g.ptr.y = i.Position.Y - canvas.AbsolutePosition.Y
	end
	g.connect(canvas.InputBegan:Connect(function(i)
		if isPointer(i) then
			g.ptrLock = false
			updPtr(i)
			press()
		end
	end))
	g.connect(UIS.InputChanged:Connect(function(i)
		if i.UserInputType == Enum.UserInputType.MouseMovement then
			g.ptrLock = false
			updPtr(i)
		elseif i.UserInputType == Enum.UserInputType.Touch and not g.ptrLock then
			updPtr(i)
		end
	end))
	g.connect(UIS.InputEnded:Connect(function(i)
		if isPointer(i) or i.KeyCode == Enum.KeyCode.Space or i.KeyCode == Enum.KeyCode.Up or i.KeyCode == Enum.KeyCode.W or i.KeyCode == Enum.KeyCode.ButtonA then g.held = false end
	end))
	g.connect(UIS.InputBegan:Connect(function(i, gp)
		if i.KeyCode == Enum.KeyCode.ButtonA then
			press()
		elseif not gp and (i.KeyCode == Enum.KeyCode.Space or i.KeyCode == Enum.KeyCode.Up or i.KeyCode == Enum.KeyCode.W) then
			press()
		end
	end))
	g.connect(UIS.InputBegan:Connect(function(i)
		if i.KeyCode == Enum.KeyCode.ButtonSelect then F.stop() end
	end))

	function g.finish(score)
		if not g.alive then return end
		g.alive = false
		for _, c in ipairs(g.conns) do c:Disconnect() end
		score = math.max(0, math.floor(score))
		sfx((score > 0) and "win" or "lose")
		local raw = math.min(400, math.floor(score * (RATE[cfg.eng] or 1) * (1 + 0.15 * g.skin + 0.10 * g.weapon)))
		local gained = raw * gmult()
		data.coins = data.coins + gained
		F.refresh()
		local panel = new("Frame", {
			Size = UDim2.fromOffset(250, 150), Position = UDim2.fromScale(0.5, 0.5), AnchorPoint = Vector2.new(0.5, 0.5),
			BackgroundColor3 = C(10, 10, 10), BorderSizePixel = 0, ZIndex = 11,
		}, hud)
		accent(panel, 3)
		local mid = Enum.TextXAlignment.Center
		local t1 = label(panel, "GAME OVER", 22, UDim2.fromOffset(0, 8), UDim2.new(1, 0, 0, 28), C(255, 90, 90), mid)
		local t2 = label(panel, "SKOR: " .. score, 16, UDim2.fromOffset(0, 42), UDim2.new(1, 0, 0, 20), Color3.new(1, 1, 1), mid)
		local t3 = label(panel, "+" .. gained .. " KOIN", 18, UDim2.fromOffset(0, 66), UDim2.new(1, 0, 0, 22), C(255, 220, 60), mid)
		t1.ZIndex, t2.ZIndex, t3.ZIndex = 12, 12, 12
		local again = mkBtn(panel, "MAIN LAGI", UDim2.fromOffset(12, 104), UDim2.fromOffset(106, 32), C(40, 110, 215))
		local menu = mkBtn(panel, "MENU", UDim2.fromOffset(132, 104), UDim2.fromOffset(106, 32), C(60, 60, 60))
		again.ZIndex, menu.ZIndex = 12, 12
		pcall(function()
			GuiService.AutoSelectGuiEnabled = true
			GuiService.SelectedObject = again
		end)
		again.Activated:Connect(function() F.start(idx) end)
		menu.Activated:Connect(function() F.stop() end)
	end

	RunService.Heartbeat:Wait() -- tunggu layout supaya ukuran valid
	if current ~= g or not g.alive then return end
	local W, H = canvas.AbsoluteSize.X, canvas.AbsoluteSize.Y
	if W < 100 or H < 100 then W, H = 480, 300 end
	g.W, g.H = W, H
	g.ptr.x, g.ptr.y = W / 2, H / 2
	buildSky(sky, cfg.sky, W, H, g)
	g.sky = sky
	function g.setSky(key)
		for _, c in ipairs(sky:GetChildren()) do c:Destroy() end
		buildSky(sky, key, W, H, g)
	end
	g.tick(function(dt)
		for _, c in ipairs(g.clouds) do
			c.x = c.x - c.s * dt
			if c.x < -70 then c.x = W + 10 end
			c.f.Position = UDim2.fromOffset(c.x, c.y)
		end
	end)
	ENG[cfg.eng](world, g)
end

local function ground(w, g, h)
	local grd = GRD[g.cfg.sky] or GRD.day
	local gy = g.H - h
	new("Frame", { Position = UDim2.fromOffset(0, gy), Size = UDim2.new(1, 0, 0, h), BackgroundColor3 = grd[1], BorderSizePixel = 0 }, w)
	new("Frame", { Position = UDim2.fromOffset(0, gy), Size = UDim2.new(1, 0, 0, 8), BackgroundColor3 = grd[2], BorderSizePixel = 0 }, w)
	return gy, grd
end

