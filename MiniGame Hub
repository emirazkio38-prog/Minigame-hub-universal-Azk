					F.refresh()
				end)
			end
		else
			actBtn(row, "BELI " .. SKIN_PRICE[lv], C(40, 110, 215), function()
				if buyItem(id, SKIN_PRICE[lv], nm) then eq.s = lv end
				F.refresh()
			end)
