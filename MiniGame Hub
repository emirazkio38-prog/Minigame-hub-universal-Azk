local KC = Enum.KeyCode
local PAD = Enum.UserInputType.Gamepad1

-- CONTROLLER: baca tombol & stik gamepad
local function padBtn(k)
	local ok, r = pcall(UIS.IsGamepadButtonDown, UIS, PAD, k)
	return ok and r == true
end

local function padStick()
	local x, y = 0, 0
	local ok, st = pcall(UIS.GetGamepadState, UIS, PAD)
	if ok and st then
		for _, o in ipairs(st) do
			if o.KeyCode == KC.Thumbstick1 then
				x, y = o.Position.X, o.Position.Y
			end
		end
	end
	if math.abs(x) < 0.25 then x = 0 end
	if math.abs(y) < 0.25 then y = 0 end
	return x, y
end

-- kiri/kanan (mundur/maju): keyboard A/D/panah, D-Pad, stik kiri
local function keyDir()
	local d = 0
	if UIS:IsKeyDown(KC.A) or UIS:IsKeyDown(KC.Left) then d = d - 1 end
	if UIS:IsKeyDown(KC.D) or UIS:IsKeyDown(KC.Right) then d = d + 1 end
	if padBtn(KC.DPadLeft) then d = d - 1 end
	if padBtn(KC.DPadRight) then d = d + 1 end
	local sx = padStick()
	d = d + sx
	return math.clamp(d, -1, 1)
end

-- atas/bawah (layar: atas = -1)
local function keyVert()
	local d = 0
	if UIS:IsKeyDown(KC.W) or UIS:IsKeyDown(KC.Up) then d = d - 1 end
	if UIS:IsKeyDown(KC.S) or UIS:IsKeyDown(KC.Down) then d = d + 1 end
	if padBtn(KC.DPadUp) then d = d - 1 end
	if padBtn(KC.DPadDown) then d = d + 1 end
	local _, sy = padStick()
	d = d - sy
	return math.clamp(d, -1, 1)
end

