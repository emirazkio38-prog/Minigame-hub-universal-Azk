ENG.pong = function(w, g)
	local cfg, W, H = g.cfg, g.W, g.H
	local top = 34
	local pH, pWd = 64 + g.skin * 8, 10
	local py, ay = H / 2 - pH / 2, H / 2 - pH / 2
	local playX, aiX = 24, W - 24 - pWd
	g.mkPadUD()
	g.lives = 3 + g.extra + (g.skin >= 2 and 1 or 0)
	g.setLives()

	for i = 0, 9 do
		new("Frame", {
			Position = UDim2.fromOffset(W / 2 - 2, top + i * ((H - top) / 10) + 6), Size = UDim2.fromOffset(4, 14),
			BackgroundColor3 = Color3.new(1, 1, 1), BackgroundTransparency = 0.5, BorderSizePixel = 0,
		}, w)
	end
	local function paddle(x, c)
		local f = new("Frame", { Size = UDim2.fromOffset(pWd, pH), Position = UDim2.fromOffset(x, 0), BackgroundColor3 = c, BorderSizePixel = 0 }, w)
		new("UIStroke", { Color = Color3.new(0, 0, 0), Thickness = 2, LineJoinMode = Enum.LineJoinMode.Miter }, f)
		return f
	end
	local pf = paddle(playX, skc(g))
	local af = paddle(aiX, C(220, 220, 220))
	local ball = new("Frame", { Size = UDim2.fromOffset(10, 10), BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0 }, w)
	new("UIStroke", { Color = Color3.new(0, 0, 0), Thickness = 2, LineJoinMode = Enum.LineJoinMode.Miter }, ball)

	local bx, by, bvx, bvy = W / 2, H / 2, 0, 0
	local bs = 270
	local serveT, serveDir = 0.9, 1
	local score, aiOff = 0, 0
	local function serve(dx)
		bx, by = W / 2, (H + top) / 2
		local a = math.rad(math.random(-30, 30))
		bvx, bvy = dx * bs * math.cos(a), bs * math.sin(a)
	end

	g.tick(function(dt)
		-- paddle pemain (atas/bawah): W/S, panah, D-Pad, stik, tombol layar, sentuh/mouse
		local vd = g.vdir()
		if vd ~= 0 then
			py = py + vd * 380 * dt
		elseif not g.ptrLock then
			py = py + math.clamp(g.ptr.y - pH / 2 - py, -420 * dt, 420 * dt)
		end
		py = math.clamp(py, top, H - pH)
		pf.Position = UDim2.fromOffset(playX, py)

		-- paddle komputer
		local aiSpd = math.min(150 + score * 4, 320)
		local goal = (H + top) / 2 - pH / 2
		if bvx > 0 and serveT <= 0 then goal = by - pH / 2 + aiOff end
		ay = math.clamp(ay + math.clamp(goal - ay, -aiSpd * dt, aiSpd * dt), top, H - pH)
		af.Position = UDim2.fromOffset(aiX, ay)

		if serveT > 0 then
			serveT = serveT - dt
			if serveT <= 0 then serve(serveDir) end
		else
			bx = bx + bvx * dt
			by = by + bvy * dt
			if by < top then
				by = top
				bvy = math.abs(bvy)
			elseif by + 10 > H then
				by = H - 10
				bvy = -math.abs(bvy)
			end
			if bvx < 0 and bx <= playX + pWd and bx + 10 >= playX and by + 10 >= py and by <= py + pH then
				bx = playX + pWd
				bs = math.min(540, bs + 14)
				local off = ((by + 5) - (py + pH / 2)) / (pH / 2)
				bvx, bvy = bs * math.cos(off), bs * math.sin(off)
				score = score + 1
				g.setScore(score)
				aiOff = math.random(-28, 28)
			elseif bvx > 0 and bx + 10 >= aiX and bx <= aiX + pWd and by + 10 >= ay and by <= ay + pH then
				bx = aiX - 10
				local off = ((by + 5) - (ay + pH / 2)) / (pH / 2)
				bvx, bvy = -bs * math.cos(off), bs * math.sin(off)
			end
			if bx < -20 then
				g.lives = g.lives - 1
				g.setLives()
				if g.lives <= 0 then
					g.finish(score)
					return
				end
				serveT, serveDir, bs = 1, 1, math.max(270, bs - 60)
			elseif bx > W + 20 then
				score = score + 5
				g.setScore(score)
				serveT, serveDir = 1, -1
			end
		end
		ball.Position = UDim2.fromOffset(bx, by)
	end)
end

