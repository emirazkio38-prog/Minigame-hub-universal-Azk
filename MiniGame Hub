-- ENGINE: ROAD FIGHTER (balap jalan raya dari atas, hindari mobil, ambil bensin, turbo)
------------------------------------------------------------
ENG.road = function(w, g)
	local cfg, W, H = g.cfg, g.W, g.H
	local roadW = math.floor(math.min(W * 0.5, 240) / 4) * 4
	local laneW = roadW / 4
	local rx = math.floor((W - roadW) / 2)
	local carW, carH = 21, 33
	local pxY = H - 70
	g.lives = 1 + g.extra
	g.setLives()

	-- latar
	new("Frame", { Size = UDim2.fromOffset(W, H), BackgroundColor3 = C(60, 150, 70), BorderSizePixel = 0 }, w)
	new("Frame", { Position = UDim2.fromOffset(rx, 0), Size = UDim2.fromOffset(roadW, H), BackgroundColor3 = C(70, 72, 82), BorderSizePixel = 0 }, w)
	local dashes, kerbs, trees = {}, {}, {}
	local dashH, dashGap = 22, 22
	local nDash = math.ceil(H / (dashH + dashGap)) + 2
	for l = 1, 3 do
		for i = 1, nDash do
			dashes[#dashes + 1] = { f = new("Frame", { Size = UDim2.fromOffset(3, dashH), BackgroundColor3 = C(235, 235, 235), BorderSizePixel = 0, Position = UDim2.fromOffset(rx + laneW * l - 1, 0) }, w), i = i }
		end
	end
	local kh = 14
	local nK = math.ceil(H / kh) + 2
	for side = 0, 1 do
		for i = 1, nK do
			local kx = (side == 0) and (rx - 6) or (rx + roadW)
			kerbs[#kerbs + 1] = { f = new("Frame", { Size = UDim2.fromOffset(6, kh), Position = UDim2.fromOffset(kx, 0), BackgroundColor3 = (i % 2 == 0) and C(230, 60, 60) or C(240, 240, 240), BorderSizePixel = 0 }, w), i = i, x = kx }
		end
	end
	local gapT = 70
	for side = 0, 1 do
		for i = 1, math.ceil(H / gapT) + 2 do
			local tf = new("Frame", { Size = UDim2.fromOffset(16, 16), BackgroundColor3 = C(30, 110, 50), BorderSizePixel = 0 }, w)
			new("UICorner", { CornerRadius = UDim.new(1, 0) }, tf)
			trees[#trees + 1] = { f = tf, i = i, side = side, off = math.random(0, 10) }
		end
	end

	-- mobil
	local pcar, pw, ph = spr(w, "rcar", 3, skc(g))
	pcar.AnchorPoint = Vector2.new(0.5, 0)
	local px = rx + laneW * 1.5
	local fuel, maxFuel = 100, 100 + g.skin * 15
	local speed, dist, bonus = 0, 0, 0
	local cruise = 140
	local invul = 0
	local traffic, items = {}, {}
	local nextSpawn, nextItem = 0.6, 4
	local shake = 0
	local stage = 1

	local turbo = g.holdBtn("TURBO", UDim2.new(1, -100, 1, -60), UDim2.fromOffset(90, 50), C(220, 130, 30))
	g.mkPadLR()
	local fbg = new("Frame", { Position = UDim2.new(0.5, -60, 0, 10), Size = UDim2.fromOffset(120, 12), BackgroundColor3 = C(30, 30, 30), BorderSizePixel = 0 }, g.hud)
	new("UIStroke", { Color = C(0, 0, 0), Thickness = 2 }, fbg)
	local ffill = new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = C(255, 200, 40), BorderSizePixel = 0 }, fbg)
	local fl = label(g.hud, "BENSIN", 10, UDim2.new(0.5, -60, 0, 23), UDim2.fromOffset(120, 12), Color3.new(1, 1, 1), Enum.TextXAlignment.Center)
	outline(fl)
	local spL = label(g.hud, "0 KM/J", 14, UDim2.new(1, -100, 1, -84), UDim2.fromOffset(90, 18), C(255, 255, 255), Enum.TextXAlignment.Right)
	outline(spL)
	local msg = label(g.hud, "", 20, UDim2.new(0.5, -120, 0, 44), UDim2.fromOffset(240, 26), C(255, 230, 90), Enum.TextXAlignment.Center)
	outline(msg)
	local msgT = 0
	local function say(t)
		msg.Text = t
		msgT = 1.3
	end
	say("TAHAN KIRI/KANAN, TURBO UNTUK NGEBUT")

	local function sc() return math.floor(dist / 12) + bonus end

	local function spawnCar()
		local lane = math.random(0, 3)
		local truck = math.random() < 0.22
		local f, w2, h2 = spr(w, truck and "rtruck" or "rcar", 3, ({ C(230, 70, 70), C(70, 120, 230), C(240, 200, 60), C(150, 90, 220), C(240, 240, 240) })[math.random(1, 5)])
		f.AnchorPoint = Vector2.new(0.5, 0)
		-- jangan menumpuk di lajur yang sama terlalu dekat
		for _, t in ipairs(traffic) do
			if t.lane == lane and t.y < 100 then
				f:Destroy()
				return
			end
		end
		traffic[#traffic + 1] = { f = f, lane = lane, x = rx + laneW * (lane + 0.5), y = -60, v = truck and math.random(40, 70) or math.random(60, 110), w = w2, h = h2, passed = false }
	end

	g.tick(function(dt)
		local d = g.dir()
		-- kecepatan
		local turboOn = turbo.down or UIS:IsKeyDown(KC.W) or UIS:IsKeyDown(KC.Up) or padBtn(KC.ButtonR2) or padBtn(KC.ButtonA)
		local target = cruise + (stage - 1) * 8
		if turboOn and fuel > 0 then target = target + 130 end
		if speed < target then speed = math.min(target, speed + 70 * dt) else speed = math.max(target, speed - 90 * dt) end
		-- keluar jalur (rumput) = melambat
		local onGrass = px - carW / 2 < rx or px + carW / 2 > rx + roadW
		if onGrass then
			speed = math.max(60, speed - 160 * dt)
			shake = 0.1
		end
		px = px + d * (110 + speed * 0.6) * dt
		px = math.clamp(px, rx - 20, rx + roadW + 20)
		dist = dist + speed * dt
		fuel = fuel - ((turboOn and 7 or 2.6) + stage * 0.15) * dt
		if invul > 0 then invul = invul - dt end
		local newStage = math.floor(dist / 3200) + 1
		if newStage > stage then
			stage = newStage
			say("TAHAP " .. stage)
			g.sfx("win")
		end

		-- gulir latar
		local scroll = speed * 1.1 * dt
		local per = dashH + dashGap
		local base = (dist * 1.1) % per
		local idx = 0
		for l = 1, 3 do
			for i = 1, nDash do
				idx = idx + 1
				local y = ((i - 1) * per + base) % (nDash * per) - per
				dashes[idx].f.Position = UDim2.fromOffset(rx + laneW * l - 1, y)
			end
		end
		local kb = (dist * 1.1) % (kh * 2)
		for k, kd in ipairs(kerbs) do
			local i = (k - 1) % nK
			local y = (i * kh + kb) % (nK * kh) - kh
			kd.f.Position = UDim2.fromOffset(kd.x, y)
			local alt = (math.floor((y - kb) / kh + 0.5)) % 2 == 0
			kd.f.BackgroundColor3 = alt and C(230, 60, 60) or C(240, 240, 240)
		end
		local tb = (dist * 1.1) % gapT
		for _, tr in ipairs(trees) do
			local y = ((tr.i - 1) * gapT + tb) % ((math.ceil(H / gapT) + 2) * gapT) - gapT
			local x = (tr.side == 0) and (rx - 30 - tr.off) or (rx + roadW + 14 + tr.off)
			tr.f.Position = UDim2.fromOffset(x, y)
		end

		-- mobil lalu lintas
		nextSpawn = nextSpawn - dt
		if nextSpawn <= 0 then
			spawnCar()
			nextSpawn = math.max(0.35, 1.1 - stage * 0.1 - speed / 900) * (0.7 + math.random() * 0.6)
		end
		for i = #traffic, 1, -1 do
			local t = traffic[i]
			t.y = t.y + (speed * 1.1 - t.v) * dt
			t.f.Position = UDim2.fromOffset(t.x, t.y)
			if not t.passed and t.y > pxY + ph then
				t.passed = true
				bonus = bonus + 2
			end
			if invul <= 0 and math.abs(t.x - px) < (carW + t.w) / 2 - 3 and t.y < pxY + ph - 4 and t.y + t.h > pxY + 4 then
				-- tabrakan
				g.sfx("boom")
				invul = 1.6
				speed = speed * 0.35
				shake = 0.4
				fuel = fuel - 8
				g.lives = g.lives - 1
				g.setLives()
				t.f:Destroy()
				table.remove(traffic, i)
				if g.lives <= 0 then
					g.finish(sc())
					return
				end
				say("TABRAKAN!")
			elseif t.y > H + 80 or t.y < -400 then
				t.f:Destroy()
				table.remove(traffic, i)
			end
		end

		-- bensin
		nextItem = nextItem - dt
		if nextItem <= 0 then
			local lane = math.random(0, 3)
			local f, w2, h2 = spr(w, "gas", 3)
			f.AnchorPoint = Vector2.new(0.5, 0)
			items[#items + 1] = { f = f, x = rx + laneW * (lane + 0.5), y = -40, w = w2, h = h2 }
			nextItem = math.random(4, 7)
		end
		for i = #items, 1, -1 do
			local it = items[i]
			it.y = it.y + speed * 1.1 * dt
			it.f.Position = UDim2.fromOffset(it.x, it.y)
			if math.abs(it.x - px) < (carW + it.w) / 2 and it.y < pxY + ph and it.y + it.h > pxY then
				fuel = math.min(maxFuel, fuel + 30)
				bonus = bonus + 5
				g.sfx("coin")
				it.f:Destroy()
				table.remove(items, i)
			elseif it.y > H + 60 then
				it.f:Destroy()
				table.remove(items, i)
			end
		end

		local jx = (shake > 0) and math.random(-2, 2) or 0
		if shake > 0 then shake = shake - dt end
		pcar.Position = UDim2.fromOffset(px + jx, pxY)
		pcar.Visible = invul <= 0 or math.floor(invul * 10) % 2 == 0
		ffill.Size = UDim2.fromScale(math.clamp(fuel / maxFuel, 0, 1), 1)
		spL.Text = math.floor(speed * 0.9) .. " KM/J"
		if msgT > 0 then
			msgT = msgT - dt
			if msgT <= 0 then msg.Text = "" end
		end
		g.setScore(sc())
		if fuel <= 0 then
			speed = speed - 120 * dt
			if speed <= 5 then g.finish(sc()) end
		end
	end)
end

