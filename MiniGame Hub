	------------------------------------------------------------
	local function vr_vc_of(sq)
		local r, c = sq // 8, sq % 8
		if flip then return 7 - r, 7 - c end
		return r, c
	end
	local function sqAt(vr, vc)
		if flip then return (7 - vr) * 8 + (7 - vc) end
		return vr * 8 + vc
	end
	local function lerpC(a, b, t) return a:Lerp(b, t) end

	local function movesFrom(sq)
		local out = {}
		for _, m in ipairs(legalList) do
			if m % 64 == sq then out[#out + 1] = m end
		end
		return out
	end

	local function setHints()
		hints = {}
		if sel then
			for _, m in ipairs(movesFrom(sel)) do hints[(m // 64) % 64] = true end
		end
	end

	local function refresh()
		local checkSq = nil
		if CHESS.inCheck(st) then checkSq = st.k[st.turn] end
		for vr = 0, 7 do
			for vc = 0, 7 do
				local sq = sqAt(vr, vc)
				local cl = cells[vr * 8 + vc]
				local p = st.b[sq]
				local base = ((vr + vc) % 2 == 0) and theme[1] or theme[2]
				if sq == lastFrom or sq == lastTo then base = lerpC(base, C(246, 246, 100), 0.5) end
				if hints[sq] then base = lerpC(base, (p ~= 0) and C(235, 110, 110) or C(120, 200, 140), 0.45) end
				if sel == sq then base = C(110, 185, 255) end
				if checkSq == sq then base = C(235, 80, 80) end
				cl.b.BackgroundColor3 = base
				cl.dot.Visible = hints[sq] == true and p == 0
				if cl.piece ~= p then
					cl.piece = p
					if cl.spr then
						cl.spr:Destroy()
						cl.spr = nil
					end
					if p ~= 0 then
						local sp = tpl[p]:Clone()
						sp.Position = UDim2.fromOffset(pOff, pOff)
						sp.Parent = cl.b
						cl.spr = sp
					end
				end
			end
		end
		cursor.Visible = showCursor and mode ~= "menu"
		cursor.Position = UDim2.fromOffset(bx0 + curC * cell, by0 + curR * cell)
		if mode ~= "menu" and not over then
			if thinking then
				turnLbl.Text = "BOT BERPIKIR...\nTUNGGU GILIRANMU"
				turnLbl.TextColor3 = C(255, 190, 90)
			elseif st.turn == myColor then
				turnLbl.Text = (CHESS.inCheck(st) and "SKAK!\n" or "") .. "GILIRANMU\nSilakan jalan"
