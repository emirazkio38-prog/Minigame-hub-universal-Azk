	------------------------------------------------------------
	-- loop & tanah
	------------------------------------------------------------
	local function findLoop(x0, x1)
		for _, lo in ipairs(loops) do
			if (x0 - lo.xc) * (x1 - lo.xc) <= 0 and math.abs(x1 - x0) > 0 then return lo end
		end
		return nil
	end

	local function startJump()
		local s = slopeAt(px)
		local inv = 1 / math.sqrt(1 + s * s)
		local cosT, sinT = inv, s * inv
		vx = gsp * cosT + sinT * JUMP * 0.55
		vy = gsp * sinT - cosT * JUMP
		if vy > -JUMP * 0.5 then vy = -JUMP * 0.9 end
		ax, ay = px + sinT * RR, gyAt(px) - cosT * RR
		mode = "air"
		jumped, rolling, charging = true, false, false
		airUsed = false
		g.sfx("jump")
	end

	------------------------------------------------------------
	-- update utama
	------------------------------------------------------------
	g.tick(function(dt)
		if state == "over" then return end
		timeS = timeS + dt
		if invul > 0 then invul = invul - dt end
		if hurtT > 0 then hurtT = hurtT - dt end
		if boostT > 0 then boostT = boostT - dt end
		if boostCD > 0 then boostCD = boostCD - dt end
		if bannerT > 0 then
			bannerT = bannerT - dt
			if bannerT <= 0 then banner.Text = "" end
		end

		local d = g.dir()
		local jDown = jumpBtn.down or UIS:IsKeyDown(KC.Space) or UIS:IsKeyDown(KC.W) or UIS:IsKeyDown(KC.Up) or padBtn(KC.ButtonA)
		local a1Down = g.a1.down or UIS:IsKeyDown(KC.F) or UIS:IsKeyDown(KC.E) or padBtn(KC.ButtonX) or padBtn(KC.ButtonR1)
		local a2Down = g.a2.down or UIS:IsKeyDown(KC.G) or UIS:IsKeyDown(KC.Q) or padBtn(KC.ButtonB) or padBtn(KC.ButtonL1)
		local jPress, a1Press, a2Press = jDown and not prevJ, a1Down and not prevA1, a2Down and not prevA2
		prevJ, prevA1, prevA2 = jDown, a1Down, a2Down
		if hurtT > 0 or state ~= "play" then d, jPress, a1Press, a2Press = 0, false, false, false end
		if d ~= 0 then face = d end

		if state == "play" then
			if mode == "ground" then
				local s = slopeAt(px)
				local inv = 1 / math.sqrt(1 + s * s)
				local cosT, sinT = inv, s * inv
				-- spin dash / roll
				if a1Press and not charging then
					if math.abs(gsp) < 120 then
						charging, charge = true, 0
					else
						rolling = true
					end
				end
				if charging then
					charge = math.min(1, charge + dt / 0.9)
					gsp = gsp * (1 - 8 * dt)
					if not a1Down then
						charging = false
						gsp = face * (300 + 300 * charge)
						rolling = true
						g.sfx("boom")
					end
				elseif rolling and not a1Down and math.abs(gsp) < 110 then
					rolling = false
				end
				-- boost
				if a2Press and boostCD <= 0 and boostT <= 0 then
					boostT, boostCD = boostDur, boostMaxCD
					g.sfx("win")
				end
				if boostT > 0 then gsp = face * math.max(math.abs(gsp), 430) end
				-- input
				if not charging then
					if d ~= 0 and not rolling then
						if gsp * d < 0 then
							gsp = gsp + d * DEC * dt
						elseif math.abs(gsp) < MAXSPD then
							gsp = gsp + d * ACC * dt
							if math.abs(gsp) > MAXSPD then gsp = d * MAXSPD end
						end
					else
						local fr = rolling and FRC * 0.25 or FRC
						if d == 0 or rolling then
							local sgn = (gsp > 0) and 1 or -1
							gsp = gsp - sgn * math.min(math.abs(gsp), fr * dt)
						end
						if rolling and d ~= 0 and gsp * d < 0 then gsp = gsp + d * 300 * dt end
					end
				end
				-- lereng
				local sl = sinT * SLOPE * dt
				if rolling then sl = sl * ((gsp * sinT > 0) and 1.2 or 1.6) end
				gsp = gsp + sl
				gsp = math.clamp(gsp, -TOPSPD, TOPSPD)
				if math.abs(gsp) < 6 and d == 0 and math.abs(sinT) < 0.25 then gsp = 0 end
				if rolling and math.abs(gsp) < 40 and not a1Down then rolling = false end

				-- loncat
				if jPress and not charging then
					startJump()
				else
					local nx = px + gsp * cosT * dt
					local lo = findLoop(px, nx)
					if lo and math.abs(gsp) >= LOOPMIN and math.abs(nx - px) > 0 then
						mode = "loop"
						lp = { lo = lo, phi = 0, dir = (gsp > 0) and 1 or -1 }
						px = lo.xc
						jumped = false
					else
						if lo and math.abs(gsp) < LOOPMIN then
							nx = px
							gsp = -gsp * 0.3
						end
						nx = math.clamp(nx, 30, lenPx - 20)
						if bossLevel and boss then nx = math.clamp(nx, goalX - 900 + 20, goalX - 20) end
						local oy = gyAt(px)
						local ny = gyAt(nx)
						local ys = oy + s * (nx - px)
						if ny - ys > 5 and math.abs(gsp) > 170 then
							vx, vy = gsp * cosT, gsp * sinT
							ax, ay = px + sinT * RR, oy - cosT * RR
							mode = "air"
							jumped = false
						else
							px = nx
						end
					end
				end
				if mode == "ground" then
					local s2 = slopeAt(px)
					local i2 = 1 / math.sqrt(1 + s2 * s2)
					ax, ay = px + s2 * i2 * RR, gyAt(px) - i2 * RR
				end
			elseif mode == "air" then
				if homeT > 0 then
					homeT = homeT - dt
					if homeTarget and homeTarget.alive then
						local dx, dy = homeTarget.x - ax, homeTarget.y - ay
						local dl = math.max(1, math.sqrt(dx * dx + dy * dy))
						vx, vy = dx / dl * 620, dy / dl * 620
					else
						homeT = 0
					end
				else
					vy = vy + GRAV * dt
					if vy > 900 then vy = 900 end
					if d ~= 0 then
						local acc = 560 * d * dt
						if vx * d < MAXSPD then vx = vx + acc end
					end
					if not jDown and jumped and vy < -230 then vy = -230 end
					if vy < 0 and vy > -240 then vx = vx * (1 - 0.5 * dt) end
				end
				-- skill udara: homing / air dash
				if a1Press and not airUsed then
					airUsed = true
					local best, bd = nil, 190
					for _, df in ipairs(defs) do
						if df.alive and (df.k == "motobug" or df.k == "crab" or df.k == "buzz") then
							local dx, dy = df.ex - ax, df.ey - ay
							local dist = math.sqrt(dx * dx + dy * dy)
							if dist < bd then best, bd = df, dist end
						end
					end
					if boss and not boss.dead then
						local dx, dy = boss.x - ax, boss.y - ay
						local dist = math.sqrt(dx * dx + dy * dy)
						if dist < bd then best = { alive = true, x = boss.x, y = boss.y, isBoss = true } end
					end
					jumped = true
					g.sfx("shoot")
					if best then
						homeT = 0.35
						homeTarget = best
						if not best.isBoss then
							homeTarget = { alive = true, x = best.ex, y = best.ey }
							-- ikuti musuh yang bergerak
							homeTarget.ref = best
						end
					else
						vx = face * 430
						vy = math.min(vy, -60)
					end
				end
				if homeTarget and homeTarget.ref and homeTarget.ref.alive then
					homeTarget.x, homeTarget.y = homeTarget.ref.ex, homeTarget.ref.ey
				end
				if a2Press and boostCD <= 0 and boostT <= 0 then
					boostT, boostCD = boostDur, boostMaxCD
					g.sfx("win")
				end
				if boostT > 0 then vx = face * math.max(math.abs(vx), 400) end
				ax = ax + vx * dt
				ay = ay + vy * dt
				ax = math.clamp(ax, 30, lenPx - 20)
				if bossLevel then ax = math.clamp(ax, goalX - 900 + 20, goalX - 20) end
				-- mendarat
				local gyA = gyAt(ax)
				if vy >= 0 and ay + RR >= gyA - 1 then
					local s = slopeAt(ax)
					local inv = 1 / math.sqrt(1 + s * s)
					local cosT, sinT = inv, s * inv
					px = ax
					if math.abs(s) < 0.25 then
						gsp = vx
					else
						gsp = vx * cosT + vy * sinT
						if math.abs(gsp) < 120 then gsp = gsp + sinT * 220 end
					end
					mode = "ground"
					if jumped then g.sfx("land") end
					jumped = false
					airUsed = false
					homeT = 0
					rolling = (not a1Down) and false or rolling
				end
			elseif mode == "loop" then
				local lo = lp.lo
				gsp = gsp * (1 - 0.04 * dt)
				lp.phi = lp.phi + (math.abs(gsp) / (lo.R - RR)) * dt
				local rad = lo.R - RR
				ax = lo.xc + lp.dir * rad * math.sin(lp.phi)
				ay = lo.y0 - lo.R + rad * math.cos(lp.phi)
				if lp.phi >= TAU then
					mode = "ground"
					px = lo.xc + lp.dir * 6
					rolling = true
				end
			end
			-- batas bawah (jurang)
			if ay > hMax + 500 then die() end
		end

		-- mati kena apa pun saat state clear: lewati
		ringLbl.Text = "RING: " .. rings

		------------------------------------------------------------
		-- objek
		------------------------------------------------------------
		local atkNow = isBall()
		-- aktifkan objek di sekitar kamera
		local viewL, viewR = camX - 120, camX + W + 160
		for _, df in ipairs(defs) do
			if df.x > viewR then break end
			if df.x >= viewL and not df.dead and not df.f and df.k ~= "boss" then
				df.f = mkObj(df)
				if df.k == "motobug" or df.k == "crab" or df.k == "buzz" then
					df.alive = true
					df.ex, df.home = df.x, df.x
					df.dir = -1
					df.shotT = 1.2
					df.wave = math.random() * 6
				end
			end
			if df.k == "boss" and not boss and not df.dead and ax > df.x - 420 then
				df.dead = true
				makeBoss(df.x)
				say("EGGMAN!", C(255, 120, 90), 2)
			end
		end
		for _, df in ipairs(defs) do
			if df.x > viewR then break end
			if df.f then
				local k = df.k
				local gx = df.x
				local wx, wy
				if k == "ring" then
					wx = gx
					wy = df.ringAbs and df.ay or (gyAt(gx) - df.above)
					df.f.Rotation = 0
					local sc = 0.55 + 0.45 * math.abs(math.cos(timeS * 6))
					df.f.Size = UDim2.fromOffset(14 * sc + 2, 14)
					if not df.dead then
						local dx, dy = wx - ax, wy - ay
						if dx * dx + dy * dy < (RR + 9) * (RR + 9) then
							df.dead = true
							rings = rings + 1
							score = score + 10
							g.sfx("coin")
							if rings >= extraLife then
								extraLife = extraLife + 100
								g.lives = g.lives + 1
								g.setLives()
								say("1UP!", C(120, 255, 140), 1.5)
							end
						end
					end
					df.f.Position = UDim2.fromOffset(wx - camX - df.f.Size.X.Offset / 2, wy - camY + H * 0.58 - 7)
				elseif k == "motobug" or k == "crab" or k == "buzz" then
					if df.alive then
						if k == "motobug" then
							df.ex = df.ex + df.dir * 42 * dt
							if math.abs(df.ex - df.home) > 90 then df.dir = -df.dir end
							df.ey = gyAt(df.ex) - 10
						elseif k == "crab" then
							df.ex = df.ex + df.dir * 26 * dt
							if math.abs(df.ex - df.home) > 70 then df.dir = -df.dir end
							df.ey = gyAt(df.ex) - 11
							df.shotT = df.shotT - dt
							if df.shotT <= 0 and math.abs(df.ex - ax) < 240 then
								df.shotT = 2.4
								for _, sv in ipairs({ -1, 1 }) do
									local f = box(objL, 0, 0, 8, 8, C(255, 120, 60), 1)
									shots[#shots + 1] = { f = f, x = df.ex, y = df.ey - 12, vx = sv * 90, vy = -230, t = 0 }
								end
							end
						else
							df.wave = df.wave + dt
							df.ex = df.home + math.sin(df.wave * 0.9) * 130
							df.ey = gyAt(df.home) - df.above + math.sin(df.wave * 2.2) * 14
							df.shotT = df.shotT - dt
							if df.shotT <= 0 and math.abs(df.ex - ax) < 220 then
								df.shotT = 2.2
								local f = box(objL, 0, 0, 8, 8, C(255, 220, 60), 1)
								shots[#shots + 1] = { f = f, x = df.ex, y = df.ey + 8, vx = (ax > df.ex) and 70 or -70, vy = 170, t = 0 }
							end
						end
						df.f.Position = UDim2.fromOffset(df.ex - camX - df.f.Size.X.Offset / 2, df.ey - camY + H * 0.58 - df.f.Size.Y.Offset / 2)
						local dx, dy = df.ex - ax, df.ey - ay
						local rr = OBJR[k] + RR
						if dx * dx + dy * dy < rr * rr then
							if atkNow then
								df.alive = false
								df.dead = true
								score = score + 100
								g.sfx("hit")
								if mode == "air" and homeT <= 0 then vy = -300 elseif homeT > 0 then vy = -330 homeT = 0 airUsed = false end
								spawnScatter(0)
							else
								hurt()
							end
						end
					end
				elseif k == "spike" then
					wx, wy = gx, gyAt(gx) - 8
					df.f.Position = UDim2.fromOffset(wx - camX - 10, wy - camY + H * 0.58 - 8)
					local dx, dy = wx - ax, wy - ay
					if dx * dx + dy * dy < (OBJR.spike + RR - 3) ^ 2 then hurt() end
				elseif k == "spring" then
					wx, wy = gx, gyAt(gx) - 10
					df.f.Position = UDim2.fromOffset(wx - camX - 12, wy - camY + H * 0.58 - 10)
					local dx, dy = wx - ax, wy - ay
					if dx * dx + dy * dy < (OBJR.spring + RR) ^ 2 and (mode ~= "loop") then
						if mode == "ground" then
							ax, ay = px, gyAt(px) - RR
						end
						mode = "air"
						vy = -(df.power or 760)
						vx = (mode == "air") and vx or gsp
						jumped, rolling = false, false
						airUsed = false
						g.sfx("jump")
					end
				elseif k == "dash" then
					wx, wy = gx, gyAt(gx) - 3
					df.f.Position = UDim2.fromOffset(wx - camX - 20, wy - camY + H * 0.58 - 3)
					if mode == "ground" and math.abs(px - gx) < 26 then
						gsp = (face >= 0 and 1 or -1) * math.max(math.abs(gsp), 520)
						g.sfx("win")
					end
				elseif k == "check" then
					wx, wy = gx, gyAt(gx) - 25
					df.f.Position = UDim2.fromOffset(wx - camX - 6, wy - camY + H * 0.58 - 25)
					if not df.on and math.abs(ax - gx) < 30 then
						df.on = true
						cpX = gx
						df.lamp.BackgroundColor3 = C(255, 60, 60)
						g.sfx("blip")
						say("CHECKPOINT", C(160, 220, 255), 1.2)
					end
				elseif k == "goal" then
					wx, wy = gx, gyAt(gx) - 35
					df.f.Position = UDim2.fromOffset(wx - camX - 15, wy - camY + H * 0.58 - 35)
					if state == "play" and math.abs(ax - gx) < 28 then
						state, stateT = "clear", 0
						df.on = true
						local bonus = rings * 10 + math.max(0, 80 - math.floor(timeS)) * 30
						score = score + bonus
						say("ACT CLEAR!\nBONUS +" .. bonus, C(255, 235, 120), 3.2)
						g.sfx("win")
					end
					if df.on and df.sign then df.sign.Rotation = (timeS * 540) % 360 end
				elseif k == "palm" then
					df.f.Position = UDim2.fromOffset(gx - camX * 0.9 - 25, gyAt(gx) - 66 - camY * 0.9 + H * 0.58 - (camY * 0.1))
				end
			end
		end
		-- buang objek yang tertinggal
		for _, df in ipairs(defs) do
			if df.f and (df.dead or df.x < camX - 200) and df.k ~= "check" and df.k ~= "goal" then
				df.f:Destroy()
				df.f = nil
			end
			if df.x > camX - 200 then
				if df.x > viewR then break end
			end
		end

		-- peluru
		for i = #shots, 1, -1 do
			local s = shots[i]
			s.t = s.t + dt
			s.vy = s.vy + (s.grav or 500) * dt
			s.x = s.x + s.vx * dt
			s.y = s.y + s.vy * dt
			local sz = s.size or 8
			s.f.Position = UDim2.fromOffset(s.x - camX - sz / 2, s.y - camY + H * 0.58 - sz / 2)
			local dx, dy = s.x - ax, s.y - ay
			if s.bomb then
				if s.t >= s.fuse or s.y >= gyAt(s.x) - 6 then
					-- ledakan
					local ex = box(objL, 0, 0, 20, 20, C(255, 170, 50), 1)
					fxs[#fxs + 1] = { f = ex, x = s.x, y = s.y, t = 0, d = 0.35, grow = 100 }
					g.sfx("boom")
					if dx * dx + dy * dy < 56 * 56 then hurt() end
					s.f:Destroy()
					table.remove(shots, i)
				end
			elseif dx * dx + dy * dy < (RR + sz / 2 + 1) ^ 2 then
				s.f:Destroy()
				table.remove(shots, i)
				hurt()
			elseif s.t > 4 or (s.grav ~= 0 and s.y > gyAt(s.x) + 5) or s.x < camX - 300 or s.x > camX + W + 300 then
				s.f:Destroy()
				table.remove(shots, i)
			end
		end
		-- ring jatuh
		for i = #scat, 1, -1 do
			local p = scat[i]
			p.t = p.t + dt
			p.vy = p.vy + 900 * dt
			p.x = p.x + p.vx * dt
			p.y = p.y + p.vy * dt
			local gyp = gyAt(p.x)
			if p.y > gyp - 7 then
				p.y = gyp - 7
				p.vy = -p.vy * 0.6
			end
			p.f.Position = UDim2.fromOffset(p.x - camX - 7, p.y - camY + H * 0.58 - 7)
			local dx, dy = p.x - ax, p.y - ay
			if p.t > 0.9 and dx * dx + dy * dy < (RR + 9) ^ 2 then
				rings = rings + 1
				score = score + 10
				g.sfx("coin")
				p.f:Destroy()
				table.remove(scat, i)
			elseif p.t > 4.5 then
				p.f:Destroy()
				table.remove(scat, i)
			end
		end

		------------------------------------------------------------
		-- bos
		------------------------------------------------------------
		if boss then
			local B = boss
			B.t = B.t + dt
			if B.inv > 0 then B.inv = B.inv - dt end
			if B.dead then
				B.deadT = B.deadT + dt
				B.y = B.y + 60 * dt
				B.f.Rotation = math.sin(B.deadT * 30) * 6
				if B.deadT > 2.4 then
					B.f:Destroy()
					boss = nil
					state, stateT = "clear", 0
					say("ZONE CLEAR!", C(255, 235, 120), 2.8)
					score = score + rings * 10
				end
			else
				local id, def = B.def.id, B.def
				local gb = B.gb
				B.stT = B.stT + dt
				B.dir = (ax >= B.x) and 1 or -1
				local function shoot(sx2, sy2, svx, svy, size, col, grav, bomb, fuse)
					local sf = box(objL, 0, 0, size, size, col, 1)
					shots[#shots + 1] = { f = sf, x = sx2, y = sy2, vx = svx, vy = svy, t = 0, size = size, grav = grav, bomb = bomb, fuse = fuse }
				end
				local floorY = gb - def.h / 2
				local function groundPhysics()
					B.vy = B.vy + 1100 * dt
					B.y = B.y + B.vy * dt
					if B.y >= floorY then
						if B.vy > 200 and B.onAir then
							g.sfx("boom")
							local ex = box(objL, 0, 0, 20, 10, C(255, 200, 80), 0.5)
							fxs[#fxs + 1] = { f = ex, x = B.x, y = gb - 4, t = 0, d = 0.3, grow = 120 }
							if mode == "ground" and math.abs(ax - B.x) < 80 then hurt() end
						end
						B.y, B.vy, B.onAir = floorY, 0, false
					else
						B.onAir = true
					end
					B.x = math.clamp(B.x, B.aL, B.aR)
				end
				if id == "egg" then
					if B.st == "idle" then
						B.x = B.baseX + math.sin(B.t * (1.1 + L * 0.03)) * 250
						B.y = gb - 110 + math.sin(B.t * 2.2) * 12
						B.shotT = B.shotT - dt
						if B.shotT <= 0 then
							B.shotT = math.max(1.1, 2.4 - L * 0.1)
							shoot(B.x, B.y + 24, B.dir * 140, -40, 12, C(255, 100, 60), nil)
						end
						if B.stT > 4.5 then B.st, B.stT = "dive", 0 end
					elseif B.st == "dive" then
						B.x = B.x + ((ax - B.x) * 1.6 * dt)
						B.y = B.y + ((gb - 36 - B.y) * 3 * dt)
						if B.stT > 2 then B.st, B.stT = "rise", 0 end
					else
						B.y = B.y + ((gb - 110 - B.y) * 2.5 * dt)
						if B.stT > 0.8 then B.st, B.stT = "idle", 0 end
					end
				elseif id == "zazz" then
					groundPhysics()
					if not B.onAir then
						local dist = math.abs(ax - B.x)
						if dist > 170 then B.x = B.x + B.dir * 70 * dt elseif dist < 90 then B.x = B.x - B.dir * 70 * dt end
					end
					B.shotT = B.shotT - dt
					if B.shotT <= 0 then
						B.shotT = math.max(1.4, 2.6 - L * 0.08)
						local vxB = math.clamp((ax - B.x) * 0.8, -230, 230)
						shoot(B.x, B.y - 20, vxB, -340, 14, C(40, 40, 50), nil, true, 1.3)
					end
					B.hopT = B.hopT - dt
					if B.hopT <= 0 and not B.onAir then
						B.hopT = 4.5
						B.vy = -520
						B.x = B.x + B.dir * 60
						B.vx = B.dir * 140
					end
					if B.onAir then B.x = B.x + B.vx * dt end
				elseif id == "zavok" then
					groundPhysics()
					if B.st == "idle" then
						B.x = B.x + B.dir * 55 * dt
						if B.stT > 1.4 then B.st, B.stT, B.cdir = "tele", 0, B.dir end
					elseif B.st == "tele" then
						B.f.Rotation = math.sin(B.stT * 60) * 3
						if B.stT > 0.7 then B.st, B.stT = "charge", 0 B.f.Rotation = 0 end
					elseif B.st == "charge" then
						B.x = B.x + B.cdir * 500 * dt
						if B.x <= B.aL + 2 or B.x >= B.aR - 2 or B.stT > 1.5 then
							B.st, B.stT = "stun", 0
							g.sfx("boom")
							for _, sv in ipairs({ -1, 1 }) do
								shoot(B.x, gb - 10, sv * 210, 0, 14, C(255, 140, 60), 0)
							end
						end
					else
						if B.stT > 1.1 then B.st, B.stT = "idle", 0 end
					end
				elseif id == "zeena" then
					-- DI-NERF: siklus diam+tembak, bersiap, lompat sekali, lalu istirahat (celah untuk diserang)
					groundPhysics()
					if B.st == "idle" then
						B.x = B.x + B.dir * 26 * dt
						B.shotT = B.shotT - dt
						if B.shotT <= 0 then
							B.shotT = 99
							local base = atan2(ay - B.y, ax - B.x)
							for _, da in ipairs({ -0.2, 0.2 }) do
								shoot(B.x, B.y, math.cos(base + da) * 120, math.sin(base + da) * 120, 9, C(255, 230, 80), 0)
							end
						end
						if B.stT > 2.0 then B.st, B.stT = "tele", 0 end
					elseif B.st == "tele" then
						B.f.Rotation = math.sin(B.stT * 40) * 3
						if B.stT > 0.6 then
							B.st, B.stT = "hop", 0
							B.f.Rotation = 0
							B.vy = -400
							B.vx = B.dir * 120
						end
					elseif B.st == "hop" then
						B.x = B.x + B.vx * dt
						if not B.onAir and B.stT > 0.25 then B.st, B.stT = "rest", 0 end
					else
						if B.stT > 1.1 then
							B.st, B.stT = "idle", 0
							B.shotT = 0.4
						end
					end
				elseif id == "zomom" then
					groundPhysics()
					B.x = B.x + B.dir * 34 * dt
					B.shotT = B.shotT - dt
					if B.shotT <= 0 then
						B.shotT = math.max(1.6, 2.7 - L * 0.07)
						shoot(B.x, B.y - 16, math.clamp((ax - B.x) * 0.8, -200, 200), -330, 14, C(120, 220, 60), nil)
						shoot(B.x, B.y - 16, math.clamp((ax - B.x) * 0.5, -140, 140), -260, 11, C(120, 220, 60), nil)
					end
				elseif id == "zik" then
					B.y = gb - 95 + math.sin(B.t * 2) * 10
					B.shotT = B.shotT - dt
					if B.tele > 0 then
						B.tele = B.tele - dt
						B.f.Visible = false
						if B.tele <= 0 then
							B.x = B.aL + math.random() * (B.aR - B.aL)
							B.f.Visible = true
							for q = -1, 1 do
								local base = atan2(ay - B.y, ax - B.x)
								shoot(B.x, B.y, math.cos(base + q * 0.25) * 200, math.sin(base + q * 0.25) * 200, 11, C(120, 240, 255), 0)
							end
						end
					elseif B.shotT <= 0 then
						B.shotT = 3
						B.tele = 0.3
					end
				elseif id == "zor" then
					local spd = 1 + (1 - B.hp / B.maxHp) * 0.6
					B.x = B.x + B.vx * spd * dt
					B.y = B.y + B.vy * spd * dt
					if B.x < B.aL or B.x > B.aR then B.vx = -B.vx B.x = math.clamp(B.x, B.aL, B.aR) end
					if B.y < gb - 200 or B.y > gb - 22 then B.vy = -B.vy B.y = math.clamp(B.y, gb - 200, gb - 22) end
				else -- metal sonic
					if B.st == "idle" then
						B.x = B.x + ((ax - B.x) * 0.9 * dt)
						B.y = B.y + ((gb - 75 - B.y) * 2 * dt)
						B.shotT = B.shotT - dt
						if B.shotT <= 0 then
							B.shotT = 1.3
							shoot(B.x, B.y, B.dir * 260, 0, 10, C(255, 70, 70), 0)
						end
						if B.stT > 3.2 then B.st, B.stT, B.cdir = "aim", 0, B.dir B.targetY = math.clamp(ay, gb - 110, gb - 24) end
					elseif B.st == "aim" then
						B.y = B.y + ((B.targetY - B.y) * 6 * dt)
						B.f.Rotation = math.sin(B.stT * 50) * 3
						if B.stT > 0.7 then B.st, B.stT = "dash", 0 B.f.Rotation = 0 g.sfx("shoot") end
					elseif B.st == "dash" then
						B.x = B.x + B.cdir * 600 * dt
						if B.x <= B.aL or B.x >= B.aR or B.stT > 1.8 then B.st, B.stT = "idle", 0 B.x = math.clamp(B.x, B.aL, B.aR) end
					end
				end
				-- tabrakan dengan pemain
				local dx, dy = B.x - ax, B.y - ay
				if dx * dx + dy * dy < (def.r + RR) ^ 2 then
					if isBall() then
						bossHit()
						if boss and B.inv > 0 then
							vy = -380
							vx = (ax > B.x) and 220 or -220
							mode = "air"
							homeT = 0
						end
					else
						hurt()
					end
				end
				if B.tele <= 0 then B.f.Visible = B.inv <= 0 or math.floor(B.inv * 12) % 2 == 0 end
			end
			if boss then boss.f.Position = UDim2.fromOffset(boss.x - camX, boss.y - camY + H * 0.58) end
		end
		-- efek ledakan
		for i = #fxs, 1, -1 do
			local e = fxs[i]
			e.t = e.t + dt
			local k = e.t / e.d
			local sz = 20 + e.grow * k
			e.f.Size = UDim2.fromOffset(sz, sz)
			e.f.Position = UDim2.fromOffset(e.x - camX - sz / 2, e.y - camY + H * 0.58 - sz / 2)
			e.f.BackgroundTransparency = 0.2 + 0.8 * k
			if k >= 1 then
				e.f:Destroy()
				table.remove(fxs, i)
			end
		end

		------------------------------------------------------------
		-- stage selesai
		------------------------------------------------------------
		if state == "clear" then
			stateT = stateT + dt
			if mode == "ground" then
				gsp = gsp + ((rolling and 0 or 1) * 220 * dt)
				gsp = math.min(gsp, 300)
			end
			if stateT > 3.4 then loadLevel(L + 1) end
		end

		------------------------------------------------------------
		-- kamera
		------------------------------------------------------------
		local look = ((mode == "air") and vx or gsp) * 0.25
		local tx = ax - W * 0.4 + look
		if bossLevel and boss then tx = math.clamp(tx, goalX - 900, goalX - W + 40) end
		camX = camX + (tx - camX) * math.min(1, 6 * dt)
		camX = math.max(0, camX)
		camY = camY + (ay - camY) * math.min(1, 4 * dt)

		------------------------------------------------------------
		-- gambar
		------------------------------------------------------------
		local oy = H * 0.58 - camY
		-- bukit latar
		local off = (camX * 0.3) % 10
		for i, c in ipairs(bgCols) do
			local sx = (i - 1) * 10 - off
			local wx = camX * 0.3 + sx
			local hh = 50 + math.sin(wx * 0.011) * 26 + math.sin(wx * 0.027 + 2) * 12
			c.Position = UDim2.fromOffset(sx, H - hh - (camY - hMin) * 0.05 - 30)
			c.Size = UDim2.fromOffset(10, hh + 80)
		end
		for _, cl in ipairs(clouds) do
			local sx = (cl.x - camX * 0.15) % (W + 120) - 60
			cl.f.Position = UDim2.fromOffset(sx, cl.y)
		end
		-- tanah
		local off2 = camX % colW
		for i, c in ipairs(terCols) do
			local sx = (i - 1) * colW - off2
			local wx = camX + sx + colW / 2
			local y = gyAt(wx) + oy
			c.top.Position = UDim2.fromOffset(sx, y)
			local chk = (math.floor(wx / 24) % 2 == 0)
			c.d1.Position = UDim2.fromOffset(sx, y + 8)
			c.d1.BackgroundColor3 = chk and zone.a or zone.b
			c.d2.Position = UDim2.fromOffset(sx, y + 30)
			c.d2.Size = UDim2.fromOffset(colW, math.max(1, H - y - 30 + 20))
			c.d2.BackgroundColor3 = chk and zone.b or zone.a
		end
		-- loop
		for _, lf in ipairs(loopF) do
			local lo = lf.lo
			local cx = lo.xc - camX
			local vis = cx > -lo.R - 40 and cx < W + lo.R + 40
			for q, f in ipairs(lf.segs) do
				f.Visible = vis
				if vis then
					local a0 = (q - 1) / 36 * TAU
					local wxp = lo.xc + (lo.R + 4) * math.sin(a0)
					local wyp = lo.y0 - lo.R + (lo.R + 4) * math.cos(a0)
					f.Position = UDim2.fromOffset(wxp - camX, wyp + oy)
					f.Rotation = -math.deg(a0)
				end
			end
		end
		-- Sonic (sprite retro)
		local sx, sy = ax - camX, ay + oy
		local showBall = isBall()
		local key = (face >= 0) and "R" or "L"
		for _, set in pairs(sonF) do
			for _, f in ipairs(set) do f.Visible = false end
		end
		ball.Visible = false
		local blink = invul > 0 and (math.floor(invul * 14) % 2 == 0)
		local rot = 0
		if mode == "loop" then
			rot = -lp.dir * math.deg(lp.phi)
		elseif mode == "ground" then
			rot = math.deg(math.atan(slopeAt(px))) * 0.8
		end
		animT = animT + math.abs((mode == "air") and vx or gsp) * dt * 0.06
		if not blink then
			if showBall then
				ball.Visible = true
			else
				local idx = 1
				if mode == "ground" and math.abs(gsp) > 20 then idx = (math.floor(animT * 1.6) % 2 == 0) and 2 or 3 end
				local cur = sonF[key][idx]
				cur.Visible = true
				cur.Position = UDim2.fromOffset(sx, sy - 6)
				cur.Rotation = rot
			end
		end
		ball.Position = UDim2.fromOffset(sx, sy)
		ballRot = ballRot + ((mode == "air") and vx or gsp) * dt * 8
		if charging then ballRot = ballRot + 900 * dt end
		ball.Rotation = ballRot
		-- bar boost
		bbFill.Size = UDim2.fromScale(boostCD <= 0 and 1 or math.clamp(1 - boostCD / boostMaxCD, 0, 1), 1)
		g.setScore(score)
	end)
end

------------------------------------------------------------
-- ENGINE: DAN THE MAN (beat 'em up: pukul, tendang, loncat, gelombang musuh, bos)
------------------------------------------------------------
ENG.dan = function(w, g)
	local cfg, W, H = g.cfg, g.W, g.H
	local GY = H - 46
	local bgL = new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, BorderSizePixel = 0 }, w)
	local objL = new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, BorderSizePixel = 0 }, w)

	local function box(parent, x, y, bw, bh, col, round)
		local f = new("Frame", { Position = UDim2.fromOffset(x, y), Size = UDim2.fromOffset(bw, bh), BackgroundColor3 = col, BorderSizePixel = 0 }, parent)
		if round then new("UICorner", { CornerRadius = UDim.new(round, 0) }, f) end
		return f
	end

	local SKIN, BLACK, WHITE = C(250, 205, 160), C(15, 15, 25), C(255, 255, 255)
	-- orang dari bentuk (flip = menghadap kiri). big = lebih besar
	local function buildMan(shirt, pants, hair, flip, scale, shades)
		local sz = 30 * scale
		local c = new("Frame", { Size = UDim2.fromOffset(sz, 46 * scale), AnchorPoint = Vector2.new(0.5, 1), BackgroundTransparency = 1, BorderSizePixel = 0 }, objL)
		local function X(x, bw) return (flip and (30 - x - bw) or x) * scale end
		local P = {}
		P.legB = box(c, X(6, 7), 32 * scale, 7 * scale, 14 * scale, pants)
		P.legF = box(c, X(15, 7), 32 * scale, 7 * scale, 14 * scale, pants)
		P.torso = box(c, X(5, 20), 15 * scale, 20 * scale, 19 * scale, shirt, 0.15)
		P.head = box(c, X(7, 16), 0, 16 * scale, 16 * scale, SKIN, 0.4)
		P.hair = box(c, X(6, 18), -1 * scale, 18 * scale, 6 * scale, hair, 0.5)
		if shades then
			box(c, X(flip and 8 or 12, 11), 6 * scale, 11 * scale, 3 * scale, BLACK)
		else
			box(c, X(flip and 9 or 16, 3), 6 * scale, 3 * scale, 4 * scale, BLACK)
		end
		P.arm = box(c, X(18, 8), 18 * scale, 8 * scale, 6 * scale, SKIN, 0.3)
		P.armBack = box(c, X(4, 6), 19 * scale, 6 * scale, 6 * scale, SKIN, 0.3)
		P.flip, P.scale = flip, scale
		return c, P
	end

	local function dressPose(P, atk, kick, walkPhase, air)
		local sc = P.scale
		local sw = math.sin(walkPhase) * 3 * sc
		P.legB.Position = UDim2.fromOffset(P.legB.Position.X.Offset, 32 * sc)
		if air or kick then
			P.legF.Size = UDim2.fromOffset(kick and 20 * sc or 7 * sc, 7 * sc)
			P.legF.Position = UDim2.fromOffset(P.flip and (30 - 15 - 20) * sc or 15 * sc, (kick and 30 or 36) * sc)
		else
			P.legF.Size = UDim2.fromOffset(7 * sc, 14 * sc)
			P.legF.Position = UDim2.fromOffset(P.legF.Position.X.Offset, 32 * sc)
			P.legB.Position = UDim2.fromOffset(P.legB.Position.X.Offset, 32 * sc + sw * 0.5)
		end
		local armLen = atk and 22 * sc or 8 * sc
		P.arm.Size = UDim2.fromOffset(armLen, 6 * sc)
		if P.flip then P.arm.Position = UDim2.fromOffset((30 - 18) * sc - armLen + 8 * sc, 18 * sc) else P.arm.Position = UDim2.fromOffset(18 * sc, 18 * sc) end
	end

	-- pemain
	local shirtC = skc(g)
	local pR, PR = buildMan(shirtC, C(40, 50, 120), C(30, 25, 25), false, 1)
	local pL, PL = buildMan(shirtC, C(40, 50, 120), C(30, 25, 25), true, 1)
	-- ikat kepala merah
	box(pR, 7, 3, 16, 3, C(220, 40, 40))
	box(pL, 7, 3, 16, 3, C(220, 40, 40))

	local maxHp = 100 + 20 * g.skin
	local hp = maxHp
	local L, LEN = 0, 3000
	local px, py, vx, vy, face = 80, GY, 0, 0, 1
	local onGround = true
	local camX, camMax = 0, 0
	local atkT, atkKind, comboI, comboT, hitDone = 0, nil, 0, 0, {}
	local inv, hurtT, superM = 0, 0, 0
	local score, kills, coinsN = 0, 0, 0
	local E, drops, shots, fx = {}, {}, {}, {}
	local waves, lockX = {}, nil
	local state, stateT = "play", 0
	local bgParts = {}
	local goT = 0
	local prevJ, prevA1, prevA2, prevA3 = false, false, false, false

	g.lives = 3 + g.extra + (g.skin >= 3 and 1 or 0)
	g.setLives()
	g.mkPadLR()
	local jumpBtn = g.holdBtn("LONCAT", UDim2.new(1, -78, 1, -60), UDim2.fromOffset(70, 50), C(40, 150, 70))
	g.a1 = g.holdBtn("PUKUL", UDim2.new(1, -152, 1, -60), UDim2.fromOffset(70, 50), C(210, 90, 40))
	g.a2 = g.holdBtn("TENDANG", UDim2.new(1, -226, 1, -60), UDim2.fromOffset(70, 50), C(190, 60, 60))
	g.a3 = g.holdBtn("SUPER", UDim2.new(1, -300, 1, -60), UDim2.fromOffset(70, 50), C(140, 70, 200))
	for _, b in ipairs({ jumpBtn, g.a1, g.a2, g.a3 }) do
		b.btn.TextSize = 12
		b.btn.BackgroundTransparency = 0.35
	end
	local hpBg = new("Frame", { Position = UDim2.fromOffset(8, 48), Size = UDim2.fromOffset(120, 10), BackgroundColor3 = C(30, 30, 30), BorderSizePixel = 0 }, g.hud)
	new("UIStroke", { Color = Color3.new(0, 0, 0), Thickness = 2 }, hpBg)
	local hpFill = new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = C(230, 60, 60), BorderSizePixel = 0 }, hpBg)
	local suBg = new("Frame", { Position = UDim2.fromOffset(8, 62), Size = UDim2.fromOffset(120, 6), BackgroundColor3 = C(30, 30, 30), BorderSizePixel = 0 }, g.hud)
	new("UIStroke", { Color = Color3.new(0, 0, 0), Thickness = 2 }, suBg)
	local suFill = new("Frame", { Size = UDim2.fromScale(0, 1), BackgroundColor3 = C(170, 90, 230), BorderSizePixel = 0 }, suBg)
	local stLbl = label(g.hud, "", 14, UDim2.fromOffset(8, 72), UDim2.fromOffset(200, 18), C(160, 230, 255))
	outline(stLbl)
	local banner = label(g.hud, "", 24, UDim2.new(0.5, -170, 0.2, 0), UDim2.fromOffset(340, 60), Color3.new(1, 1, 0.6), Enum.TextXAlignment.Center)
	outline(banner)
	local bannerT = 0
	local goLbl = label(g.hud, "JALAN >>", 22, UDim2.new(1, -140, 0.4, 0), UDim2.fromOffset(120, 30), C(255, 235, 90), Enum.TextXAlignment.Right)
	outline(goLbl)
	goLbl.Visible = false
	local function say(t, col, d)
		banner.Text = t
		banner.TextColor3 = col or Color3.new(1, 1, 0.6)
		bannerT = d or 2
	end

	local function clearAll()
		for _, e in ipairs(E) do e.f:Destroy() end
		for _, d in ipairs(drops) do d.f:Destroy() end
		for _, s in ipairs(shots) do s.f:Destroy() end
		for _, f in ipairs(bgL:GetChildren()) do f:Destroy() end
		E, drops, shots, bgParts = {}, {}, {}, {}
	end

	local THEMES = { { sky = C(40, 40, 70), bld = C(30, 30, 55), ground = C(70, 70, 80), line = C(110, 110, 120) },
		{ sky = C(90, 60, 90), bld = C(70, 45, 75), ground = C(95, 70, 70), line = C(140, 100, 100) },
		{ sky = C(30, 60, 50), bld = C(25, 50, 45), ground = C(60, 80, 60), line = C(100, 130, 100) } }
	local theme = THEMES[1]

	local function loadLevel(n)
		clearAll()
		L = n
		theme = THEMES[(n - 1) % #THEMES + 1]
		LEN = 2800 + 350 * math.min(n, 8)
		px, py, vx, vy = 80, GY, 0, 0
		camX, camMax = 0, 0
		lockX = nil
		waves = {}
		local cnt = 4 + math.min(n, 6)
		local count = math.min(5, 2 + math.floor(n / 2))
		for i = 1, count do waves[#waves + 1] = { x = 600 + (LEN - 1100) * (i - 1) / math.max(1, count - 1), n = cnt + i, done = false, boss = false } end
		if n % 3 == 0 then waves[#waves + 1] = { x = LEN - 380, n = 0, done = false, boss = true } end
		state, stateT = "play", 0
		-- latar kota
		local x = 0
		while x < LEN + W do
			local bw, bh = math.random(40, 90), math.random(60, 170)
			bgParts[#bgParts + 1] = { f = box(bgL, 0, 0, bw, bh, theme.bld), x = x, bw = bw, bh = bh }
			x = x + bw + math.random(0, 20)
		end
		bgParts.ground = box(bgL, 0, GY, W, H - GY, theme.ground)
		bgParts.lines = {}
		for i = 1, math.ceil(W / 40) + 2 do bgParts.lines[i] = box(bgL, 0, GY + 20, 22, 4, theme.line) end
		say("TAHAP " .. n, C(255, 235, 120), 2)
		stLbl.Text = "TAHAP " .. n
	end

	local function spawnEnemy(kind, x)
		local e = { k = kind, x = x, y = GY, vx = 0, vy = 0, face = -1, t = math.random() * 2, st = "walk", hitF = 0, kb = 0 }
		if kind == "grunt" then
			e.hp = 2
			e.f, e.P = buildMan(C(60, 60, 75), C(30, 30, 40), C(20, 20, 25), false, 1, true)
		elseif kind == "gunner" then
			e.hp = 2
			e.f, e.P = buildMan(C(90, 50, 50), C(30, 30, 40), C(20, 20, 25), false, 1, true)
			e.shotT = 1.5
		elseif kind == "brute" then
			e.hp = 6
			e.f, e.P = buildMan(C(120, 40, 40), C(40, 30, 30), C(30, 20, 20), false, 1.4, true)
		else
			e.hp = 22 + 3 * L
			e.f, e.P = buildMan(C(60, 90, 60), C(30, 40, 30), C(30, 30, 20), false, 1.8, true)
		end
		e.fL, e.PL = buildMan(e.k == "gunner" and C(90, 50, 50) or e.k == "brute" and C(120, 40, 40) or e.k == "boss" and C(60, 90, 60) or C(60, 60, 75),
			(e.k == "brute" or e.k == "boss") and C(40, 30, 30) or C(30, 30, 40), C(20, 20, 25), true, e.P.scale, true)
		e.maxHp = e.hp
		E[#E + 1] = e
		return e
	end

	local function drop(x)
		local r = math.random()
		local kind = (r < 0.22) and "heart" or "coin"
		local f = box(objL, 0, 0, 12, 12, kind == "heart" and C(240, 60, 90) or C(255, 205, 40), 1)
		drops[#drops + 1] = { f = f, x = x, y = GY - 8, k = kind, vy = -200, t = 0 }
	end

	local function hurtPlayer(dmg, from)
		if inv > 0 or state ~= "play" then return end
		hp = hp - dmg
		inv, hurtT = 0.9, 0.25
		vx = (px > from) and 160 or -160
		vy = -200
		onGround = false
		g.sfx("hurt")
		if hp <= 0 then
			g.lives = g.lives - 1
			g.setLives()
			if g.lives <= 0 then
				g.finish(score)
				state = "over"
				return
			end
			hp = maxHp
			inv = 2
			say("COBA LAGI!", C(255, 140, 140), 1.2)
		end
	end

	local function damageEnemy(e, dmg, kb)
		e.hp = e.hp - dmg
		e.hitF = 0.18
		e.kb = (e.x > px and 1 or -1) * kb
		e.st = "hit"
		e.t = 0
		superM = math.min(100, superM + dmg * 6)
		score = score + 10 * dmg
		g.sfx("hit")
		if e.hp <= 0 then
			e.dead = true
			kills = kills + 1
			score = score + ((e.k == "boss") and 1000 or e.k == "brute" and 200 or 100)
			drop(e.x)
			if e.k == "brute" or e.k == "boss" then drop(e.x + 14) end
			g.sfx("boom")
		end
	end

	loadLevel(1)

	g.tick(function(dt)
		if state == "over" then return end
		if inv > 0 then inv = inv - dt end
		if hurtT > 0 then hurtT = hurtT - dt end
		if bannerT > 0 then
			bannerT = bannerT - dt
			if bannerT <= 0 then banner.Text = "" end
		end
		local d = g.dir()
		local jDown = jumpBtn.down or UIS:IsKeyDown(KC.Space) or UIS:IsKeyDown(KC.W) or UIS:IsKeyDown(KC.Up) or padBtn(KC.ButtonA)
		local a1Down = g.a1.down or UIS:IsKeyDown(KC.F) or UIS:IsKeyDown(KC.J) or padBtn(KC.ButtonX)
		local a2Down = g.a2.down or UIS:IsKeyDown(KC.G) or UIS:IsKeyDown(KC.K) or padBtn(KC.ButtonB)
		local a3Down = g.a3.down or UIS:IsKeyDown(KC.Q) or UIS:IsKeyDown(KC.L) or padBtn(KC.ButtonY)
		local jP, a1P, a2P, a3P = jDown and not prevJ, a1Down and not prevA1, a2Down and not prevA2, a3Down and not prevA3
		prevJ, prevA1, prevA2, prevA3 = jDown, a1Down, a2Down, a3Down
		if hurtT > 0 or state ~= "play" then d, jP, a1P, a2P, a3P = 0, false, false, false, false end

		-- gerak pemain
		if atkT <= 0 or not onGround then
			if d ~= 0 then
				face = d
				vx = vx + (d * 360 - vx) * math.min(1, 10 * dt)
			else
				vx = vx * (1 - math.min(1, 10 * dt))
			end
		else
			vx = vx * (1 - math.min(1, 8 * dt))
		end
		if jP and onGround then
			vy = -460
			onGround = false
			g.sfx("jump")
		end
		vy = vy + 1250 * dt
		px = px + vx * dt
		py = py + vy * dt
		if py >= GY then
			py, vy = GY, 0
			onGround = true
		end
		local minX = (lockX and (lockX - W * 0.5 - 20)) or (camX + 10)
		px = math.clamp(px, math.max(10, camX + 14), (lockX and (camX + W - 14)) or (LEN + 100))

		-- serangan
		if atkT > 0 then atkT = atkT - dt end
		if comboT > 0 then comboT = comboT - dt else comboI = 0 end
		if a1P and atkT <= 0 then
			comboI = (comboT > 0) and (comboI % 3 + 1) or 1
			atkKind, atkT, comboT = "punch", 0.26, 0.55
			hitDone = {}
			g.sfx("shoot")
			if onGround then vx = vx + face * 90 end
		elseif a2P and atkT <= 0 then
			atkKind, atkT = "kick", onGround and 0.34 or 0.4
			comboI = 0
			hitDone = {}
			g.sfx("shoot")
			if not onGround then vx = face * 330 end
		elseif a3P and superM >= 100 then
			superM = 0
			g.sfx("boom")
			inv = math.max(inv, 0.6)
			for _, e in ipairs(E) do
				if not e.dead and math.abs(e.x - px) < 130 then damageEnemy(e, 3, 220) end
			end
			for i = #shots, 1, -1 do
				shots[i].f:Destroy()
				table.remove(shots, i)
			end
			local ring = box(objL, 0, 0, 30, 30, Color3.new(1, 1, 1), 1)
			ring.BackgroundTransparency = 0.5
			fx[#fx + 1] = { f = ring, x = px, y = py - 20, t = 0, d = 0.35, grow = 260 }
		end
		if atkT > 0 and atkKind then
			local el = (atkKind == "punch") and (0.26 - atkT) or ((atkKind == "kick" and 0.34 or 0.4) - atkT)
			if el > 0.06 and el < 0.2 then
				local reach = (atkKind == "kick") and 54 or 40
				for _, e in ipairs(E) do
					if not e.dead and not hitDone[e] then
						local dx = (e.x - px) * face
						if dx > -8 and dx < reach + 10 * e.P.scale and math.abs(e.y - py) < 36 then
							hitDone[e] = true
							local dmg = (atkKind == "kick") and 2 or ((comboI == 3) and 2 or 1)
							local kbk = (comboI == 3 or atkKind == "kick") and 230 or 90
							damageEnemy(e, dmg, kbk)
							if e.k == "boss" then e.kb = e.kb * 0.2 end
						end
					end
				end
			end
		end

		-- gelombang
		for _, wv in ipairs(waves) do
			if not wv.done and not wv.started and px >= wv.x - 120 then
				wv.started = true
				lockX = wv.x + 60
				if wv.boss then
					spawnEnemy("boss", camX + W + 40)
					say("GEN. RAGEOUS!", C(255, 120, 90), 2)
				else
					for i = 1, wv.n do
						local kind = "grunt"
						local r = math.random()
						if r < 0.22 + 0.02 * L then kind = "gunner" end
						if r > 0.9 - 0.02 * L then kind = "brute" end
						local side = (i % 2 == 0) and 1 or -1
						spawnEnemy(kind, (side == 1) and (camX + W + 30 + i * 36) or (camX - 30 - i * 36))
					end
				end
			end
			if wv.started and not wv.done then
				local alive = 0
				for _, e in ipairs(E) do
					if not e.dead then alive = alive + 1 end
				end
				if alive == 0 then
					wv.done = true
					lockX = nil
					goT = 3
				end
			end
		end

		-- musuh
		for i = #E, 1, -1 do
			local e = E[i]
			if e.dead then
				e.t = e.t + dt
				e.f.Visible, e.fL.Visible = false, false
				e.f:Destroy()
				e.fL:Destroy()
				table.remove(E, i)
			else
				e.t = e.t + dt
				if e.hitF > 0 then e.hitF = e.hitF - dt end
				local dx = px - e.x
				local dist = math.abs(dx)
				e.face = (dx >= 0) and 1 or -1
				local spd = (e.k == "brute") and 48 or (e.k == "boss") and 70 or 62
				if e.st == "hit" then
					e.x = e.x + e.kb * dt
					e.kb = e.kb * (1 - math.min(1, 6 * dt))
					if e.t > 0.3 then e.st = "walk" e.t = 0 end
				elseif e.k == "gunner" then
					local want = 170
					if dist > want + 30 then e.x = e.x + e.face * spd * dt elseif dist < want - 40 then e.x = e.x - e.face * spd * dt end
					e.shotT = e.shotT - dt
					if e.shotT <= 0 and dist < 360 then
						e.shotT = 2.2
						local f = box(objL, 0, 0, 10, 5, C(255, 220, 60), 0.5)
						shots[#shots + 1] = { f = f, x = e.x + e.face * 16, y = e.y - 26, vx = e.face * 230, t = 0 }
						g.sfx("shoot")
					end
				elseif e.k == "boss" then
					if e.st == "walk" then
						if dist > 50 then e.x = e.x + e.face * spd * dt end
						if dist < 120 and e.t > 1.8 then e.st, e.t = "wind", 0 end
					elseif e.st == "wind" then
						if e.t > 0.6 then
							e.st, e.t = "slam", 0
							g.sfx("boom")
							if math.abs(px - e.x) < 90 and py > GY - 30 then hurtPlayer(26, e.x) end
							local ring = box(objL, 0, 0, 20, 10, C(255, 200, 80), 0.5)
							ring.BackgroundTransparency = 0.5
							fx[#fx + 1] = { f = ring, x = e.x, y = GY - 5, t = 0, d = 0.3, grow = 200 }
						end
					else
						if e.t > 0.5 then e.st, e.t = "walk", 0 end
					end
				else
					if e.st == "walk" then
						if dist > 34 then e.x = e.x + e.face * spd * dt else e.st, e.t = "wind", 0 end
					elseif e.st == "wind" then
						if e.t > ((e.k == "brute") and 0.55 or 0.4) then
							e.st, e.t = "hit2", 0
							if math.abs(px - e.x) < 44 and math.abs(py - e.y) < 34 then hurtPlayer((e.k == "brute") and 16 or 8, e.x) end
						end
					else
						if e.t > 0.45 then e.st, e.t = "walk", 0 end
					end
				end
				-- gambar musuh
				local cur = (e.face >= 0) and e.f or e.fL
				local oth = (e.face >= 0) and e.fL or e.f
				oth.Visible = false
				cur.Visible = true
				cur.Position = UDim2.fromOffset(e.x - camX, e.y)
				dressPose((e.face >= 0) and e.P or e.PL, e.st == "hit2" or e.st == "slam", false, e.t * 8, false)
			end
		end

		-- peluru musuh
		for i = #shots, 1, -1 do
			local s = shots[i]
			s.t = s.t + dt
			s.x = s.x + s.vx * dt
			s.f.Position = UDim2.fromOffset(s.x - camX, s.y)
			if math.abs(s.x - px) < 12 and math.abs(s.y - (py - 22)) < 24 then
				s.f:Destroy()
				table.remove(shots, i)
				hurtPlayer(9, s.x - s.vx)
			elseif s.t > 3 then
				s.f:Destroy()
				table.remove(shots, i)
			end
		end
		-- barang jatuh
		for i = #drops, 1, -1 do
			local dr = drops[i]
			dr.t = dr.t + dt
			dr.vy = dr.vy + 800 * dt
			dr.y = dr.y + dr.vy * dt
			if dr.y > GY - 8 then dr.y, dr.vy = GY - 8, 0 end
			dr.f.Position = UDim2.fromOffset(dr.x - camX, dr.y)
			if dr.t > 0.3 and math.abs(dr.x - px) < 20 and math.abs(dr.y - (py - 12)) < 30 then
				if dr.k == "coin" then
					score = score + 50
					coinsN = coinsN + 1
					g.sfx("coin")
				else
					hp = math.min(maxHp, hp + 25)
					g.sfx("win")
				end
				dr.f:Destroy()
				table.remove(drops, i)
			elseif dr.t > 12 then
				dr.f:Destroy()
				table.remove(drops, i)
			end
		end
		-- efek
		for i = #fx, 1, -1 do
			local e = fx[i]
			e.t = e.t + dt
			local k = e.t / e.d
			local sz = 30 + e.grow * k
			e.f.Size = UDim2.fromOffset(sz, (e.grow > 0 and sz * 0.35 or sz))
			e.f.Position = UDim2.fromOffset(e.x - camX - sz / 2, e.y - sz * 0.17)
			e.f.BackgroundTransparency = 0.4 + 0.6 * k
			if k >= 1 then
				e.f:Destroy()
				table.remove(fx, i)
			end
		end
		if goT > 0 then
			goT = goT - dt
			goLbl.Visible = math.floor(goT * 3) % 2 == 0
		else
			goLbl.Visible = false
		end

		-- akhir tahap
		if state == "play" and px >= LEN and not lockX then
			local pending = false
			for _, wv in ipairs(waves) do
				if not wv.done then pending = true end
			end
			if not pending then
				state, stateT = "clear", 0
				say("TAHAP SELESAI!\nBONUS +" .. (200 + 50 * L), C(255, 235, 120), 3)
				score = score + 200 + 50 * L
				g.sfx("win")
			end
		end
		if state == "clear" then
			stateT = stateT + dt
			if stateT > 3.2 then loadLevel(L + 1) end
		end

		-- kamera
		local tx = px - W * 0.35
		if lockX then tx = math.min(tx, lockX - W * 0.5) end
		camX = math.max(camX, 0)
		if not lockX then
			camX = camX + (tx - camX) * math.min(1, 6 * dt)
			camX = math.clamp(camX, 0, math.max(0, LEN - W * 0.5))
		else
			camX = camX + (lockX - W * 0.5 - camX) * math.min(1, 4 * dt)
		end

		-- gambar pemain & latar
		local cur = (face >= 0) and pR or pL
		local oth = (face >= 0) and pL or pR
		oth.Visible = false
		local blink = inv > 0 and math.floor(inv * 14) % 2 == 0
		cur.Visible = not blink
		cur.Position = UDim2.fromOffset(px - camX, py)
		dressPose((face >= 0) and PR or PL, atkT > 0 and atkKind == "punch", atkT > 0 and atkKind == "kick", (px / 14), not onGround)
		for _, b in ipairs(bgParts) do
			b.f.Position = UDim2.fromOffset(b.x - camX * 0.5, GY - b.bh)
		end
		bgParts.ground.Size = UDim2.fromOffset(W, H - GY)
		local off = camX % 40
		for i, ln in ipairs(bgParts.lines) do ln.Position = UDim2.fromOffset((i - 1) * 40 - off, GY + 20) end
		hpFill.Size = UDim2.fromScale(math.clamp(hp / maxHp, 0, 1), 1)
		suFill.Size = UDim2.fromScale(superM / 100, 1)
		suFill.BackgroundColor3 = (superM >= 100) and C(255, 230, 80) or C(170, 90, 230)
		g.setScore(score)
	end)
end

