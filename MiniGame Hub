				dmg = math.max(1, hero.atk + math.random(-2, 3) - en.def)
			elseif mage then
				hero.mp = hero.mp - 5
				dmg = math.floor(hero.atk * 2.5) + math.random(0, 5)
			else
				hero.mp = hero.mp - 4
				dmg = math.max(1, math.floor(hero.atk * 2.1) + math.random(0, 4) - en.def)
			end
			en.hp = math.max(0, en.hp - dmg)
			shakeT = 0.35
			popup("-" .. dmg, W * 0.72, gyR - en.h - 36, C(255, 90, 90))
		elseif act == 3 then
			defend = true
			hero.mp = math.min(hero.maxmp, hero.mp + 3)
			popup("+3 MP", W * 0.2, gyR - hh - 44, C(120, 190, 255))
		else
			local heal = math.floor(hero.maxhp * 0.4)
			hero.hp = math.min(hero.maxhp, hero.hp + heal)
			hero.pot = hero.pot - 1
			popup("+" .. heal, W * 0.2, gyR - hh - 44, C(120, 255, 140))
		end
	end

	local function onWin()
		score = score + 10 + (en.boss and 20 or 0)
		g.setScore(score)
		hero.xp = hero.xp + 8 + 4 * stage
		hero.pot = math.min(5, hero.pot + 1)
		local up = false
		while hero.xp >= hero.lvl * 15 do
			hero.xp = hero.xp - hero.lvl * 15
			hero.lvl = hero.lvl + 1
			hero.maxhp = hero.maxhp + 10
			hero.atk = hero.atk + 2
			hero.maxmp = hero.maxmp + 1
			if hero.lvl % 2 == 0 then hero.dfn = hero.dfn + 1 end
			hero.hp = math.min(hero.maxhp, hero.hp + math.floor(hero.maxhp * 0.3))
			up = true
		end
		if up then msg.Text = "NAIK LEVEL " .. hero.lvl .. "!" end
	end

	local function doAction(i)
		if st ~= "menu" then return end
		local cost = mage and 5 or 4
		if i == 2 and hero.mp < cost then
			msg.Text = "MP KURANG!"
			return
		end
		if i == 4 and hero.pot <= 0 then
			msg.Text = "OBAT HABIS!"
			return
		end
		act = i
		st, t, applied = "pAct", 0, false
		local texts = { "KAMU MENYERANG!", mage and "SIHIR!" or "TEBASAN KUAT!", "BERTAHAN!", "MINUM OBAT!" }
		msg.Text = texts[i]
	end

	local btns = menuRow(g, { "SERANG", mage and "SIHIR" or "TEBAS", "TAHAN", "OBAT" }, function(i)
		sel = i
		doAction(i)
	end)

	g.tick(function(dt)
		t = t + dt
		local idx
		sel, idx = menuNav(g, nav, sel, 4)
		if idx then doAction(idx) end

		lunge, eLunge = 0, 0
		if st == "pAct" then
			if t >= 0.3 and not applied then
				applied = true
				heroHit()
			end
			if act <= 2 then lunge = math.sin(math.clamp(t / 0.7, 0, 1) * math.pi) * 60 end
			if t >= 0.7 then
				if en.hp <= 0 then
					st, t = "win", 0
					msg.Text = en.name .. " KALAH!"
					onWin()
				else
					st, t, applied = "eAct", 0, false
				end
			end
		elseif st == "eAct" then
			if t >= 0.3 and not applied then
				applied = true
				local strong = en.boss and math.random() < 0.3
				local dmg = math.max(1, en.atk + math.random(-2, 2) - hero.dfn)
				if strong then dmg = math.floor(dmg * 1.6) end
				if defend then
					dmg = math.floor(dmg / 2)
					defend = false
				end
				hero.hp = math.max(0, hero.hp - dmg)
				heroShake = 0.3
				popup("-" .. dmg, W * 0.2, gyR - hh - 44, C(255, 140, 70))
				if strong then msg.Text = "NAPAS API!" else msg.Text = en.name .. " MENYERANG!" end
			end
			eLunge = -math.sin(math.clamp(t / 0.7, 0, 1) * math.pi) * 50
			if t >= 0.7 then
				if hero.hp <= 0 then
					g.lives = g.lives - 1
					g.setLives()
					if g.lives <= 0 then
						g.finish(score)
						return
					end
					hero.hp = math.floor(hero.maxhp * 0.6)
					msg.Text = "KAMU BANGKIT LAGI!"
				else
					msg.Text = "PILIH AKSI"
				end
				st, t = "menu", 0
			end
		elseif st == "win" then
			if t >= 1.4 then
				stage = stage + 1
				spawn()
				st, t = "menu", 0
				msg.Text = "STAGE " .. stage .. (en.boss and " - BOS!" or "")
			end
		end

		-- gambar
		heroShake = math.max(0, heroShake - dt)
		shakeT = math.max(0, shakeT - dt)
		local hx = W * 0.2 - hw / 2 + lunge + (heroShake > 0 and math.random(-3, 3) or 0)
		local hy = gyR - hh + 2
		hbox.Position = UDim2.fromOffset(hx, hy)
		local ex = W * 0.72 - en.w / 2 + eLunge + (shakeT > 0 and math.random(-4, 4) or 0)
		local ey = gyR - en.h + 2
		en.box.Position = UDim2.fromOffset(ex, ey)
		en.box.Visible = st ~= "win" and (shakeT <= 0 or math.floor(shakeT * 20) % 2 == 0)

		hpBg.Position = UDim2.fromOffset(W * 0.2 - 45, hy - 24)
		mpBg.Position = UDim2.fromOffset(W * 0.2 - 45, hy - 13)
		hpFill.Size = UDim2.fromScale(math.clamp(hero.hp / hero.maxhp, 0, 1), 1)
		mpFill.Size = UDim2.fromScale(math.clamp(hero.mp / hero.maxmp, 0, 1), 1)
		ehBg.Position = UDim2.fromOffset(W * 0.72 - 45, ey - 16)
		ehFill.Size = UDim2.fromScale(math.clamp(en.hp / en.maxhp, 0, 1), 1)
		enameL.Position = UDim2.fromOffset(W * 0.72 - 65, ey - 32)
		enameL.Text = en.name
		info.Text = string.format("LV %d   HP %d/%d   MP %d/%d   OBAT %d   STAGE %d", hero.lvl, hero.hp, hero.maxhp, hero.mp, hero.maxmp, hero.pot, stage)

		for i = 1, 4 do
			local on = (i == sel and st == "menu")
			btns[i].BackgroundColor3 = on and C(70, 140, 240) or C(40, 90, 170)
		end
		for i = #popups, 1, -1 do
			local p = popups[i]
			p.t = p.t - dt
			p.y = p.y - 40 * dt
			p.l.Position = UDim2.fromOffset(p.x - 40, p.y)
			if p.t <= 0 then
				p.l:Destroy()
				table.remove(popups, i)
			end
		end
	end)
end

