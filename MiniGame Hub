	local msg = label(g.hud, "PILIH AKSI", 14, UDim2.new(0.5, -160, 0, 28), UDim2.fromOffset(320, 20), Color3.new(1, 1, 0.7), Enum.TextXAlignment.Center)
	outline(msg)
