			else
				turnLbl.Text = "GILIRAN LAWAN\nTUNGGU LAWAN\nJALAN DULU..."
				turnLbl.TextColor3 = C(255, 190, 90)
			end
		end
	end

	local function finishGame(outcome, reason)
		if over then return end
		over = true
		promoPending = nil
		promoRow.Visible = false
		resignBtn.Visible = false
		local txt = (outcome == "win") and "KAMU MENANG!" or (outcome == "lose") and "KAMU KALAH" or "SERI"
		if reason then txt = txt .. "\n" .. reason end
		turnLbl.Text = txt
		local rw = botCfg and botCfg.reward or { 10, 5, 1 }
		score = (outcome == "win") and rw[1] or (outcome == "draw") and rw[2] or rw[3]
		refresh()
		task.delay(2.6, function()
			if g.alive then g.finish(score) end
		end)
	end

	local function checkEnd()
		local res = CHESS.result(st, legalList)
		if not res then
			local hnow, cnt = posHist[#posHist], 0
			for i = 1, #posHist do
				if posHist[i] == hnow then cnt = cnt + 1 end
			end
			if cnt >= 3 then
				finishGame("draw", "PENGULANGAN 3X")
				return true
			end
			return false
		end
		if res == "mate" then
			finishGame((st.turn == myColor) and "lose" or "win", "SKAKMAT")
		elseif res == "stalemate" then
			finishGame("draw", "STALEMATE")
		else
			finishGame("draw", "SERI")
		end
		return true
	end

	local botTurn
	local function applyMove(m, remote)
		local from, to, pr = m % 64, (m // 64) % 64, (m // 4096) % 8
		local isCap = st.b[to] ~= 0 or (m // 32768) == 1
		CHESS.make(st, m)
		g.sfx(isCap and "hit" or "move")
		lastFrom, lastTo = from, to
		sel, hints = nil, {}
		promoPending = nil
		promoRow.Visible = false
		legalList = CHESS.legal(st)
		posHist[#posHist + 1] = CHESS.hash(st)
		if CHESS.inCheck(st) then g.sfx("boom") end
		local ended = checkEnd()
		refresh()
		if not ended and mode == "bot" and st.turn ~= myColor then botTurn() end
	end

	botTurn = function()
		thinking = true
		refresh()
		task.spawn(function()
			task.wait(0.3)
			local m = CHESS.choose(st, botCfg.bot, g, posHist)
			thinking = false
			if m and g.alive and not over and mode == "bot" then
				applyMove(m, true)
			end
		end)
	end

	local function findMove(from, to, pr)
		for _, m in ipairs(legalList) do
			if m % 64 == from and (m // 64) % 64 == to and (m // 4096) % 8 == (pr or 0) then return m end
		end
		return nil
	end

	local function tryMove(from, to)
		local cands = {}
		for _, m in ipairs(legalList) do
			if m % 64 == from and (m // 64) % 64 == to then cands[#cands + 1] = m end
		end
		if #cands == 0 then
			sel, hints = nil, {}
		elseif #cands == 1 then
			applyMove(cands[1], false)
			return
		else
			promoPending = { from = from, to = to }
			promoRow.Visible = true
		end
		refresh()
	end

	for _, it in ipairs(promoBtns) do
		it.btn.Activated:Connect(function()
			if not promoPending then return end
			local m = findMove(promoPending.from, promoPending.to, it.pt)
			if m then applyMove(m, false) end
		end)
	end

	local function onSquare(sq)
		if mode == "menu" or over or promoPending then return end
		-- SETELAH JALAN, TIDAK BISA JALAN LAGI SAMPAI LAWAN JALAN
		if thinking or st.turn ~= myColor then
			turnLbl.TextColor3 = C(255, 90, 90)
			turnLbl.Text = "BELUM GILIRANMU!\nTUNGGU LAWAN\nJALAN DULU"
			task.delay(0.7, function()
				if g.alive and not over then refresh() end
			end)
			return
		end
		local p = st.b[sq]
		if sel == nil then
			if p ~= 0 and p * myColor > 0 and #movesFrom(sq) > 0 then
				sel = sq
				setHints()
			end
		elseif sq == sel then
			sel, hints = nil, {}
		elseif p ~= 0 and p * myColor > 0 and #movesFrom(sq) > 0 then
			sel = sq
			setHints()
		else
			tryMove(sel, sq)
			return
		end
		refresh()
	end

	for vr = 0, 7 do
		for vc = 0, 7 do
			cells[vr * 8 + vc].b.Activated:Connect(function()
				curR, curC = vr, vc
				onSquare(sqAt(vr, vc))
			end)
		end
	end

	resignBtn.Activated:Connect(function()
		if over then return end
		finishGame("lose", "MENYERAH")
	end)

	------------------------------------------------------------
	-- mulai mode
	------------------------------------------------------------
	local function startBot(entry, sideSel)
		botCfg = entry
		mode = "bot"
		posHist = { CHESS.hash(st) }
		if sideSel == 3 then sideSel = math.random(1, 2) end
		myColor = (sideSel == 2) and -1 or 1
		flip = (myColor == -1)
		curR, curC = 6, 4
		info.Text = "VS BOT:\n" .. entry.name .. "\n" .. entry.tag .. "\nKAMU: " .. ((myColor == 1) and "PUTIH" or "HITAM")
		resignBtn.Visible = true
		paintPromo()
		refresh()
		if st.turn ~= myColor then botTurn() end
	end

	turnLbl.Text = "PILIH BOT LAWAN"
	openBotMenu(g, "CARI BOT", CHESS_BOTS, startBot, true)
	refresh()

	-- kontrol keyboard / controller
	local nav = { l = false, r = false, u = false, d = false, ok = false, no = false }
	g.tick(function()
		if mode == "menu" then return end
		local l, r, u, d = g.dir4()
		local ok = UIS:IsKeyDown(KC.Return) or UIS:IsKeyDown(KC.Space) or padBtn(KC.ButtonA)
		local no = UIS:IsKeyDown(KC.Backspace) or padBtn(KC.ButtonB)
		local moved = false
		if l and not nav.l then
			curC = math.max(0, curC - 1)
			moved = true
		end
		if r and not nav.r then
			curC = math.min(7, curC + 1)
			moved = true
		end
		if u and not nav.u then
			curR = math.max(0, curR - 1)
			moved = true
		end
		if d and not nav.d then
			curR = math.min(7, curR + 1)
			moved = true
		end
		if moved then showCursor = true end
		if ok and not nav.ok then
			showCursor = true
			onSquare(sqAt(curR, curC))
		end
		local cancelled = no and not nav.no
		if cancelled then
			sel, hints, promoPending = nil, {}, nil
			promoRow.Visible = false
		end
		nav.l, nav.r, nav.u, nav.d, nav.ok, nav.no = l, r, u, d, ok, no
		if moved or cancelled then refresh() end
	end)
end

------------------------------------------------------------
-- ENGINE 15: TIC TAC TOE (lawan BOT mudah/sedang/susah atau lawan pemain lain)
------------------------------------------------------------
local TTT_LINES = { { 1, 2, 3 }, { 4, 5, 6 }, { 7, 8, 9 }, { 1, 4, 7 }, { 2, 5, 8 }, { 3, 6, 9 }, { 1, 5, 9 }, { 3, 5, 7 } }
local NUMKEYS = { KC.One, KC.Two, KC.Three, KC.Four, KC.Five, KC.Six, KC.Seven, KC.Eight, KC.Nine }

local function tttWinner(b)
	for _, l in ipairs(TTT_LINES) do
		local a = b[l[1]]
		if a ~= 0 and a == b[l[2]] and a == b[l[3]] then return a, l end
	end
	return 0, nil
end

local function tttMinimax(b, turn, bot, depth)
	local win = tttWinner(b)
	if win == bot then return 10 - depth end
	if win ~= 0 then return depth - 10 end
	local best = (turn == bot) and -100 or 100
	local any = false
	for i = 1, 9 do
		if b[i] == 0 then
			any = true
			b[i] = turn
			local s = tttMinimax(b, 3 - turn, bot, depth + 1)
			b[i] = 0
			if turn == bot then
				if s > best then best = s end
			else
				if s < best then best = s end
			end
		end
	end
	if not any then return 0 end
	return best
end

-- pilih langkah bot (level 1 mudah, 2 sedang, 3 susah)
local function tttBotMove(b, bot, level)
	local free = {}
	for i = 1, 9 do
		if b[i] == 0 then free[#free + 1] = i end
	end
	if #free == 0 then return nil end
	if level == 1 then return free[math.random(#free)] end
	if level == 2 then
		-- menang kalau bisa, blok kalau perlu, selain itu acak (utamakan tengah)
		for _, seat in ipairs({ bot, 3 - bot }) do
			for _, i in ipairs(free) do
				b[i] = seat
				local w = tttWinner(b)
				b[i] = 0
				if w == seat then return i end
			end
		end
		if b[5] == 0 and math.random() < 0.6 then return 5 end
		return free[math.random(#free)]
	end
	-- susah: minimax sempurna (tidak bisa dikalahkan)
	local bestScore, bestMoves = -1000, {}
	for _, i in ipairs(free) do
		b[i] = bot
		local s = tttMinimax(b, 3 - bot, bot, 1)
		b[i] = 0
		if s > bestScore then
			bestScore, bestMoves = s, { i }
		elseif s == bestScore then
			bestMoves[#bestMoves + 1] = i
		end
	end
	return bestMoves[math.random(#bestMoves)]
end

ENG.ttt = function(w, g)
	local cfg, W, H = g.cfg, g.W, g.H
	g.lives = 1
	g.setLives()

	local cs = math.max(40, math.min(84, math.floor((H - 52) / 3)))
	local gap = 4
	local boardPx = cs * 3 + gap * 2
	local bx0 = 14
	local by0 = 30 + math.max(0, math.floor((H - 30 - boardPx) / 2))
	local mine = skc(g)
	local COLX, COLO = mine, C(255, 150, 60)

	local board = { 0, 0, 0, 0, 0, 0, 0, 0, 0 }
	local mode = "menu" -- menu | bot
	local level, mySeat, turn = 2, 1, 1
	local over, thinking = false, false
	local cur, showCursor = 5, false
	local score = 0

	local cells = {}
	for i = 1, 9 do
		local r, c = (i - 1) // 3, (i - 1) % 3
		local b = new("TextButton", {
			Position = UDim2.fromOffset(bx0 + c * (cs + gap), by0 + r * (cs + gap)), Size = UDim2.fromOffset(cs, cs),
			BackgroundColor3 = C(14, 34, 80), BorderSizePixel = 0, Text = "", Font = FONT, TextSize = math.floor(cs * 0.72),
			AutoButtonColor = false, Selectable = false,
		}, w)
		accent(b, 2)
		cells[i] = b
	end
	local cursor = new("Frame", {
		Size = UDim2.fromOffset(cs, cs), BackgroundTransparency = 1, BorderSizePixel = 0, Visible = false, ZIndex = 4,
	}, w)
	new("UIStroke", { Color = Color3.new(1, 1, 1), Thickness = 3 }, cursor)

	local px0 = bx0 + boardPx + 16
	local pw = math.max(100, W - px0 - 8)
	local title = label(w, "TIC TAC TOE", 18, UDim2.fromOffset(px0, 30), UDim2.fromOffset(pw, 22), C(255, 225, 90))
	outline(title)
	local info = label(w, "", 12, UDim2.fromOffset(px0, 56), UDim2.fromOffset(pw, 30), C(170, 210, 255))
	outline(info)
	local turnLbl = label(w, "PILIH MODE MAIN", 14, UDim2.fromOffset(px0, 92), UDim2.fromOffset(pw, 46), Color3.new(1, 1, 1))
	outline(turnLbl)
	local resignBtn = mkBtn(w, "MENYERAH", UDim2.fromOffset(px0, by0 + boardPx - 34), UDim2.fromOffset(math.min(pw, 130), 30), C(190, 50, 50))
	resignBtn.TextSize = 13
	resignBtn.Selectable = false
	resignBtn.Visible = false

	local winLine = nil
	local function refresh()
		for i = 1, 9 do
			local v = board[i]
			cells[i].Text = (v == 1) and "X" or (v == 2) and "O" or ""
			cells[i].TextColor3 = (v == 1) and COLX or COLO
			local hl = false
			if winLine then
				for _, k in ipairs(winLine) do
					if k == i then hl = true end
				end
			end
			cells[i].BackgroundColor3 = hl and C(60, 130, 230) or C(14, 34, 80)
		end
		cursor.Visible = showCursor and mode ~= "menu" and not over
		local r, c = (cur - 1) // 3, (cur - 1) % 3
		cursor.Position = UDim2.fromOffset(bx0 + c * (cs + gap), by0 + r * (cs + gap))
		if mode ~= "menu" and not over then
			if thinking then
				turnLbl.Text = "BOT BERPIKIR..."
			elseif turn == mySeat then
				turnLbl.Text = "GILIRANMU (" .. ((mySeat == 1) and "X" or "O") .. ")"
			else
				turnLbl.Text = "GILIRAN LAWAN"
			end
		end
	end

	local SC = { win = { 8, 20, 60 }, draw = { 3, 8, 25 }, lose = { 1, 2, 3 } }
	local function finishGame(outcome, reason)
		if over then return end
		over = true
		resignBtn.Visible = false
		local txt = (outcome == "win") and "KAMU MENANG!" or (outcome == "lose") and "KAMU KALAH" or "SERI"
		if reason then txt = txt .. "\n" .. reason end
		turnLbl.Text = txt
		score = SC[outcome][level]
		refresh()
		task.delay(2.6, function()
			if g.alive then g.finish(score) end
		end)
	end

	local function resultOf(win)
		if win == 0 then return nil end
		if win == 3 then return "draw" end
		return (win == mySeat) and "win" or "lose"
	end

	local botMove
	local function place(i, seat)
		g.sfx("pop")
		board[i] = seat
		turn = 3 - seat
		local win, line = tttWinner(board)
		winLine = line
		local full = true
		for k = 1, 9 do
			if board[k] == 0 then full = false end
		end
		if win ~= 0 then
			refresh()
			finishGame(resultOf(win))
			return
		elseif full then
			refresh()
			finishGame("draw")
			return
		end
		refresh()
		if mode == "bot" and turn ~= mySeat then botMove() end
	end

	botMove = function()
		thinking = true
		refresh()
		task.spawn(function()
			task.wait(0.45)
			thinking = false
			if g.alive and not over and mode == "bot" then
				local i = tttBotMove(table.clone(board), 3 - mySeat, level)
				if i then place(i, 3 - mySeat) end
			end
		end)
	end

	local function onCell(i)
		if mode == "menu" or over or thinking or turn ~= mySeat or board[i] ~= 0 then return end
		place(i, mySeat)
	end
	for i = 1, 9 do
		cells[i].Activated:Connect(function()
			cur = i
			onCell(i)
		end)
	end

	resignBtn.Activated:Connect(function()
		if over then return end
		finishGame("lose", "MENYERAH")
	end)

	local TTT_BOTS = {
		{ name = "Bot Mudah", sub = "Sering salah langkah", tag = "LV 1", col = C(90, 190, 255), lv = 1 },
		{ name = "Bot Sedang", sub = "Kadang teliti, kadang ceroboh", tag = "LV 2", col = C(240, 220, 90), lv = 2 },
		{ name = "Bot Susah", sub = "Hampir tidak pernah salah", tag = "LV 3", col = C(255, 110, 90), lv = 3 },
	}
	local function startBot(entry)
		level = entry.lv
		mode = "bot"
		mySeat, turn = 1, 1
		info.Text = "VS " .. entry.name:upper() .. "\nKAMU: X (JALAN DULUAN)"
		resignBtn.Visible = true
		refresh()
	end

	turnLbl.Text = "PILIH BOT LAWAN"
	openBotMenu(g, "CARI BOT", TTT_BOTS, startBot, false)
	refresh()

	-- kontrol keyboard / controller
	local nav = { l = false, r = false, u = false, d = false, ok = false, no = false }
	local numDown = {}
	g.tick(function()
		if mode == "menu" then return end
		local l, r, u, d = g.dir4()
		local ok = UIS:IsKeyDown(KC.Return) or UIS:IsKeyDown(KC.Space) or padBtn(KC.ButtonA)
		local moved = false
		local row, col = (cur - 1) // 3, (cur - 1) % 3
		if l and not nav.l then
			col = math.max(0, col - 1)
			moved = true
		end
		if r and not nav.r then
			col = math.min(2, col + 1)
			moved = true
		end
		if u and not nav.u then
			row = math.max(0, row - 1)
			moved = true
		end
		if d and not nav.d then
			row = math.min(2, row + 1)
			moved = true
		end
		cur = row * 3 + col + 1
		if moved then showCursor = true end
		if ok and not nav.ok then
			showCursor = true
			onCell(cur)
		end
		for i = 1, 9 do
			local dn = UIS:IsKeyDown(NUMKEYS[i])
			if dn and not numDown[i] then
				cur = i
				onCell(i)
			end
			numDown[i] = dn
		end
		nav.l, nav.r, nav.u, nav.d, nav.ok = l, r, u, d, ok
		if moved then refresh() end
	end)
end

