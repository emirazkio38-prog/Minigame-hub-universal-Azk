					slope(run, 70)
					local R = rng:NextInteger(66, 84)
					local bx = x
					flat(R * 2 + 170)
					loops[#loops + 1] = { xc = bx + R + 85, y0 = h, R = R }
					for q = 0, 13 do
						local ph = q / 14 * TAU
						add({ k = "ring", x = bx + R + 85 + (R - 22) * math.sin(ph), ay = h - R + (R - 22) * math.cos(ph), ringAbs = true })
					end
					flat(120)
					sinceLoop = 0
				elseif roll < 0.25 then
					local len = rng:NextInteger(150, 300)
					flat(len)
					local pickE = rng:NextNumber()
					if pickE < 0.55 then
						add({ k = "motobug", x = x0 + len * 0.6 })
						if diff > 0.3 and rng:NextNumber() < 0.5 then add({ k = "crab", x = x0 + len * 0.3 }) end
					elseif pickE < 0.8 then
						add({ k = "buzz", x = x0 + len * 0.5, above = rng:NextInteger(70, 110) })
					elseif zi >= 2 or n > 2 then
						for s = 0, 2 do add({ k = "spike", x = x0 + len * 0.5 + s * 22 }) end
						ringLine(x0 + len * 0.5 - 22, 4, 70, 24)
					end
					if rng:NextNumber() < 0.5 then ringLine(x0 + 30, rng:NextInteger(4, 7), 24) end
				elseif roll < 0.55 then
					local len = rng:NextInteger(200, 380)
					local dh = (rng:NextNumber() < 0.5 and -1 or 1) * len * rng:NextNumber() * 0.45 * (0.5 + 0.5 * diff + 0.3)
					if h + dh < -330 or h + dh > 120 then dh = -dh end
					slope(len, dh)
					ringLine(x0 + 40, 5, 24, 30)
					if rng:NextNumber() < 0.4 then add({ k = "motobug", x = x0 + len * 0.5 }) end
				elseif roll < 0.8 then
					-- bukit: naik lalu turun, ring di busur
					local len = rng:NextInteger(200, 280)
					local amp = rng:NextInteger(50, 120)
					slope(len, -amp)
					slope(len, amp)
					for q = 0, 6 do add({ k = "ring", x = x0 + len * 0.5 + q * 52, above = 26 + math.sin(q / 6 * math.pi) * 40 }) end
					if rng:NextNumber() < 0.4 then add({ k = "buzz", x = x0 + len * 1.3, above = 90 }) end
				elseif roll < 0.9 then
					-- spring ke platform ring tinggi
					flat(rng:NextInteger(200, 260))
					add({ k = "spring", x = x0 + 80, power = 760 })
					ringLine(x0 + 55, 7, 150, 24)
				else
					-- tanah bergelombang
					for q = 1, 4 do
						slope(46, -14)
						slope(46, 14)
					end
				end
				sinceLoop = sinceLoop + (x - x0)
				if not cpDone[1] and x > target * 0.4 then
					cpDone[1] = true
					add({ k = "check", x = x + 10 })
				elseif not cpDone[2] and x > target * 0.75 then
					cpDone[2] = true
					add({ k = "check", x = x + 10 })
				end
			end
			flat(260)
			goalX = x - 120
			add({ k = "goal", x = goalX })
			flat(500)
			lenPx = x
		end
		-- jaga agar tanah tidak berakhir
		for i = #hs + 1, math.floor((x + 600) / SON_STEP) + 2 do hs[i] = hs[#hs] end
		hMin, hMax = 1e9, -1e9
		for _, v in ipairs(hs) do
			if v < hMin then hMin = v end
			if v > hMax then hMax = v end
		end
		-- pohon palem / dekorasi
		if zone.palm then
			for px2 = 380, x - 200, 330 do add({ k = "palm", x = px2 + rng:NextInteger(-40, 40) }) end
		end
		table.sort(defs, function(a, b) return a.x < b.x end)
		-- gambar loop
		for _, lo in ipairs(loops) do
			local segs = {}
			for q = 0, 35 do
				local f = box(frontL, 0, 0, 24, 9, C(235, 210, 150))
				f.AnchorPoint = Vector2.new(0.5, 0.5)
				f.ZIndex = 1
				segs[q + 1] = f
			end
			loopF[#loopF + 1] = { lo = lo, segs = segs }
		end
	end

