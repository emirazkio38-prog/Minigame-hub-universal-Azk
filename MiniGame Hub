local GAMES = {}
local function L(s)
	local t = {}
	for p in string.gmatch(s, "[^|]+") do t[#t + 1] = p end
	return t
end
local function add(name, eng, sp, sky, col, skins, weps, o)
	o = o or {}
	o.name, o.eng, o.spr, o.sky, o.col = name, eng, sp, sky, COL[col]
	o.skins = L(skins)
	o.weps = weps and L(weps) or nil
	GAMES[#GAMES + 1] = o
end

