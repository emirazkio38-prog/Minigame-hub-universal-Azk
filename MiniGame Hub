-- ENGINE 8: ULAR (Snake / Nibbles) - D-Pad / stik / tombol layar
------------------------------------------------------------
ENG.snake = function(w, g)
	local cfg, W, H = g.cfg, g.W, g.H
	local cs, top = 18, 36
	local cols = math.floor(W / cs)
	local rows = math.floor((H - top - 6) / cs)
	local ox = math.floor((W - cols * cs) / 2)
	local oy = top
	local board = new("Frame", {
		Position = UDim2.fromOffset(ox, oy), Size = UDim2.fromOffset(cols * cs, rows * cs),
		BackgroundColor3 = Color3.new(0, 0, 0), BackgroundTransparency = 0.5, BorderSizePixel = 0,
	}, w)
	new("UIStroke", { Color = Color3.new(1, 1, 1), Thickness = 2, LineJoinMode = Enum.LineJoinMode.Miter }, board)
	g.mkPad4()
	local col = skc(g)
	g.lives = 1 + g.extra + (g.skin >= 3 and 1 or 0)
	g.setLives()
	local snake, walls = {}, {}
	local dir, nd = { 1, 0 }, { 1, 0 }
	local score, t, bonusT, eaten = 0, 0, 0, 0
	local step = math.max(0.07, 0.15 - 0.008 * g.skin)
	local food, bonus = nil, nil
	local cx0, cy0 = math.floor(cols / 2), math.floor(rows / 2)

	local function cell(x, y, c)
		return new("Frame", {
			Position = UDim2.fromOffset(ox + (x - 1) * cs + 1, oy + (y - 1) * cs + 1),
			Size = UDim2.fromOffset(cs - 2, cs - 2), BackgroundColor3 = c, BorderSizePixel = 0,
		}, w)
	end

	if cfg.walls then
		for _ = 1, 9 do
			local x, y = math.random(2, cols - 1), math.random(2, rows - 1)
			if math.abs(y - cy0) > 1 then
				walls[#walls + 1] = { x = x, y = y, f = cell(x, y, C(150, 150, 160)) }
			end
		end
	end

	local function occupied(x, y)
		for _, s in ipairs(snake) do
			if s.x == x and s.y == y then return true end
		end
		for _, wall in ipairs(walls) do
			if wall.x == x and wall.y == y then return true end
		end
		if food and food.x == x and food.y == y then return true end
		if bonus and bonus.x == x and bonus.y == y then return true end
		return false
	end
	local function randFree()
		for _ = 1, 300 do
			local x, y = math.random(1, cols), math.random(1, rows)
			if not occupied(x, y) then return x, y end
		end
		return 1, 1
	end
	local function spawnItem(name)
		local x, y = randFree()
		local f = spr(w, name, 2)
		f.Position = UDim2.fromOffset(ox + (x - 1) * cs + 2, oy + (y - 1) * cs + 2)
		return { x = x, y = y, f = f }
	end
	local function reset()
		for _, s in ipairs(snake) do s.f:Destroy() end
		snake = {}
		for i = 0, 2 do
			snake[#snake + 1] = { x = cx0 - i, y = cy0, f = cell(cx0 - i, cy0, i == 0 and shade(col, 1.25) or col) }
		end
		dir, nd = { 1, 0 }, { 1, 0 }
	end
	reset()
	food = spawnItem("apple")

	g.tick(function(dt)
		local l, r, u, d = g.dir4()
		if l and dir[1] ~= 1 then
			nd = { -1, 0 }
		elseif r and dir[1] ~= -1 then
			nd = { 1, 0 }
		elseif u and dir[2] ~= 1 then
			nd = { 0, -1 }
		elseif d and dir[2] ~= -1 then
			nd = { 0, 1 }
		end

		if bonus then
			bonusT = bonusT - dt
			if bonusT <= 0 then
				bonus.f:Destroy()
				bonus = nil
			end
		end

		t = t + dt
		if t < step then return end
		t = t - step
		dir = nd
		local hx, hy = snake[1].x + dir[1], snake[1].y + dir[2]
		local dead = false
		if cfg.wrap then
			if hx < 1 then hx = cols elseif hx > cols then hx = 1 end
			if hy < 1 then hy = rows elseif hy > rows then hy = 1 end
		elseif hx < 1 or hx > cols or hy < 1 or hy > rows then
			dead = true
		end
		if not dead then
			for i = 1, #snake - 1 do
				if snake[i].x == hx and snake[i].y == hy then dead = true end
			end
			for _, wall in ipairs(walls) do
				if wall.x == hx and wall.y == hy then dead = true end
			end
		end
		if dead then
			g.lives = g.lives - 1
			g.setLives()
			if g.lives <= 0 then
				g.finish(score)
				return
			end
			reset()
			return
		end

		local ate = food and hx == food.x and hy == food.y
		local ateB = bonus and hx == bonus.x and hy == bonus.y
		table.insert(snake, 1, { x = hx, y = hy, f = cell(hx, hy, shade(col, 1.25)) })
		snake[2].f.BackgroundColor3 = col
		if ate then
			score = score + 1
			eaten = eaten + 1
			step = math.max(0.06, step - 0.002)
			food.f:Destroy()
			food = spawnItem("apple")
			if eaten % 5 == 0 and not bonus then
				bonus = spawnItem("star")
				bonusT = 6
			end
		elseif ateB then
			score = score + 3
			bonus.f:Destroy()
			bonus = nil
		else
			local tail = table.remove(snake)
			tail.f:Destroy()
		end
		g.setScore(score)
	end)
end

