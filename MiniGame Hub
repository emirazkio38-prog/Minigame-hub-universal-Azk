	local BOOK = {}
	local function sqOf(s) return (8 - tonumber(s:sub(2, 2))) * 8 + (s:byte(1) - 97) end
	local function buildBook()
		for _, line in ipairs(BOOK_LINES) do
			local st = newState()
			for tok in string.gmatch(line, "%S+") do
				local from, to = sqOf(tok:sub(1, 2)), sqOf(tok:sub(3, 4))
				local found
				local lm = legal(st)
				for _, m in ipairs(lm) do
					if m % 64 == from and (m // 64) % 64 == to and (m // 4096) % 8 == 0 then found = m break end
				end
				if not found then break end
				local h = hashOf(st)
				local list = BOOK[h]
				if not list then
					list = {}
					BOOK[h] = list
				end
				local dup = false
				for _, x in ipairs(list) do
					if x == found then dup = true end
				end
				if not dup then list[#list + 1] = found end
				make(st, found)
			end
		end
	end
	buildBook()

	local function bookMove(st)
		local list = BOOK[hashOf(st)]
		if not list then return nil end
		local lm = legal(st)
		local ok = {}
		for _, m in ipairs(list) do
			for _, x in ipairs(lm) do
				if x == m then ok[#ok + 1] = m break end
			end
		end
		if #ok == 0 then return nil end
		return ok[rnd(#ok)]
	end

	------------------------------------------------------------
	-- pilih langkah. bot = { mode, depth, time, noise, blunder, book, w = {...} }
	-- HARUS dipanggil di thread terpisah (task.spawn). hist = daftar hash posisi sebelumnya
	------------------------------------------------------------
	local function choose(st0, bot, g, hist)
		if type(bot) == "number" then
			bot = (bot == 1) and { mode = "random" } or (bot == 2) and { depth = 2, time = 1.6, noise = 12 } or { depth = 3, time = 4 }
		end
		local st = copy(st0)
		local moves = legal(st)
		if #moves == 0 then return nil end
		if #moves == 1 then return moves[1] end
		if bot.mode == "random" then
			if rnd() < 0.3 then
				local bestM, bestV = nil, 0
				for _, m in ipairs(moves) do
					local v = abs(st.b[(m // 64) % 64])
					if v > bestV then bestM, bestV = m, v end
				end
				if bestM then return bestM end
			end
			return moves[rnd(#moves)]
		end
		if bot.book then
			local bm = bookMove(st)
			if bm then return bm end
		end
		if bot.blunder and rnd() < bot.blunder then
			return moves[rnd(#moves)]
		end

		if lastBot ~= bot then
			lastBot = bot
			tk, td, tv, tf, tm, tg = {}, {}, {}, {}, {}, {}
		end
		genCount = genCount + 1
		local now = os.clock()
		local ctx = {
			nodes = 0, deadline = now + (bot.time or 2), stop = false, g = g, slice = now, gen = genCount,
			W = bot.w or DEFW, rep = {}, k1 = {}, k2 = {}, hist = {},
		}
		for _, hh in ipairs(hist or {}) do ctx.rep[hh] = (ctx.rep[hh] or 0) + 1 end
		local h0 = hashOf(st)
		local maxDepth = bot.depth or 4
		local noise = bot.noise or 0
		local softLimit = (bot.time or 2) * 0.42
		local color = st.turn

		-- urutan awal langkah akar
		local B = st.b
		for i = 1, #moves do
			local m = moves[i]
			local v = abs(B[(m // 64) % 64])
			moves[i] = { m = m, s = (v ~= 0) and (10 * VAL[v] - VAL[abs(B[m % 64])] / 10) or 0 }
		end
		table.sort(moves, function(a, b) return a.s > b.s end)

		local best = moves[1].m
		local startT = os.clock()
		for depth = 1, maxDepth do
			local alpha = -INF
			local iterBest, iterScore = nil, nil
			for i = 1, #moves do
				local e = moves[i]
				local m = e.m
				local nh = nextHash(st, m, h0)
				local u = make(st, m)
				ctx.rep[nh] = (ctx.rep[nh] or 0) + 1
				local score
				if i == 1 or noise > 0 then
					score = -search(st, depth - 1, -INF, (noise > 0) and INF or -alpha, 1, nh, ctx, true)
					if noise == 0 then
						-- jendela penuh hanya untuk langkah pertama
					end
				else
					score = -search(st, depth - 1, -alpha - 1, -alpha, 1, nh, ctx, true)
					if score > alpha then
						score = -search(st, depth - 1, -INF, -alpha, 1, nh, ctx, true)
					end
				end
				ctx.rep[nh] = ctx.rep[nh] - 1
				unmake(st, m, u)
				if ctx.stop then break end
				e.s = score
				if noise > 0 then score = score + rnd(-noise, noise) end
				if iterScore == nil or score > iterScore then
					iterBest, iterScore = m, score
					if score > alpha then alpha = score end
				end
			end
			if iterBest and (not ctx.stop or iterScore ~= nil) then
				best = iterBest
			end
			if ctx.stop then break end
			-- urutkan: terbaik di depan untuk iterasi berikutnya
			table.sort(moves, function(a, b) return a.s > b.s end)
			if iterBest then
				for i = 1, #moves do
					if moves[i].m == iterBest then
						local e = table.remove(moves, i)
						table.insert(moves, 1, e)
						break
					end
				end
			end
			if iterScore and iterScore >= MATE - 100 then break end
			if os.clock() - startT > softLimit then break end
		end
		return best
	end

	local function sameMoveList(a, b) return a == b end

	return {
		newState = newState, copy = copy, legal = legal, make = make, unmake = unmake,
		inCheck = inCheck, result = result, choose = choose, attacked = attacked,
		hash = hashOf, evaluate = evaluate, gen = gen, nextHash = nextHash,
	}
end)()

