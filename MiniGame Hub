------------------------------------------------------------
ENG.tap = function(w, g)
	local cfg, W, H = g.cfg, g.W, g.H
	local fly = cfg.mode == "fly"
	local timeLeft, score, spawnT = 40, 0, 0.4
	local R = g.weapon * 18
	local ents, occ, holes = {}, {}, {}
	if fly then
		ground(w, g, 20)
		g.lives = 5 + g.extra
		g.setLives()
	else
		for r = 1, 3 do
			for c = 1, 3 do
				local cx, cy = W * c / 4, H * (0.38 + 0.2 * r)
				new("Frame", {
					Position = UDim2.fromOffset(cx - 26, cy - 6), Size = UDim2.fromOffset(52, 14),
					BackgroundColor3 = C(30, 20, 15), BorderSizePixel = 0,
				}, w)
				holes[#holes + 1] = { x = cx, y = cy }
			end
		end
		g.lives = 0
		g.setLives()
	end
	local tl = label(g.hud, "", 16, UDim2.new(0.5, -60, 0, 8), UDim2.fromOffset(120, 20), Color3.new(1, 1, 1), Enum.TextXAlignment.Center)
	outline(tl)

	local cross = new("Frame", { Size = UDim2.fromOffset(26, 26), AnchorPoint = Vector2.new(0.5, 0.5), BackgroundTransparency = 1, Visible = false }, g.hud)
	new("Frame", { Size = UDim2.new(1, 0, 0, 2), Position = UDim2.new(0, 0, 0.5, -1), BackgroundColor3 = C(255, 60, 60), BorderSizePixel = 0 }, cross)
	new("Frame", { Size = UDim2.new(0, 2, 1, 0), Position = UDim2.new(0.5, -1, 0, 0), BackgroundColor3 = C(255, 60, 60), BorderSizePixel = 0 }, cross)

	g.onPress(function()
		local px, py = g.ptr.x, g.ptr.y
		for i = #ents, 1, -1 do
			local e = ents[i]
			if px > e.x - R and px < e.x + e.w + R and py > e.y - R and py < e.y + e.h + R then
				if e.hole then occ[e.hole] = nil end
				e.f:Destroy()
				table.remove(ents, i)
				score = score + 1
				g.setScore(score)
			end
		end
	end)

	g.tick(function(dt)
		local csx, csy = padStick()
		local mvx = csx + (padBtn(KC.DPadRight) and 1 or 0) - (padBtn(KC.DPadLeft) and 1 or 0)
		local mvy = -csy + (padBtn(KC.DPadDown) and 1 or 0) - (padBtn(KC.DPadUp) and 1 or 0)
		if mvx ~= 0 or mvy ~= 0 then
			g.padCur = true
			g.ptr.x = math.clamp(g.ptr.x + mvx * 360 * dt, 0, W)
			g.ptr.y = math.clamp(g.ptr.y + mvy * 360 * dt, 0, H)
		end
		if g.padCur then
			cross.Visible = true
			cross.Position = UDim2.fromOffset(g.ptr.x, g.ptr.y)
		end
		timeLeft = timeLeft - dt
		tl.Text = "WAKTU: " .. math.max(0, math.ceil(timeLeft))
		spawnT = spawnT - dt
		if spawnT <= 0 then
			if fly then
				spawnT = math.max(0.5, 1.2 - score * 0.02)
				local f, ew, eh = spr(w, cfg.spr, 4, skc(g))
				local dirn = math.random() < 0.5 and 1 or -1
				ents[#ents + 1] = {
					f = f, w = ew, h = eh, x = dirn == 1 and -ew or W, y = math.random(30, math.max(31, math.floor(H * 0.55))),
					vx = dirn * (110 + math.random(0, 90) + score * 3), life = 99,
				}
			else
				spawnT = math.max(0.4, 0.8 - score * 0.01)
				local free = {}
				for i = 1, #holes do
					if not occ[i] then free[#free + 1] = i end
				end
				if #free > 0 then
					local hi = free[math.random(#free)]
					occ[hi] = true
					local f, ew, eh = spr(w, cfg.spr, 4, skc(g))
					ents[#ents + 1] = { f = f, w = ew, h = eh, x = holes[hi].x - ew / 2, y = holes[hi].y - eh + 6, vx = 0, life = 1.1, hole = hi }
				end
			end
		end
		for i = #ents, 1, -1 do
			local e = ents[i]
			e.x = e.x + e.vx * dt
			e.life = e.life - dt
			e.f.Position = UDim2.fromOffset(e.x, e.y)
			local gone = false
			if fly then
				if e.x > W + 10 or e.x < -e.w - 10 then
					gone = true
					g.lives = g.lives - 1
					g.setLives()
				end
			elseif e.life <= 0 then
				gone = true
				occ[e.hole] = nil
			end
			if gone then
				e.f:Destroy()
				table.remove(ents, i)
			end
		end
		if timeLeft <= 0 or (fly and g.lives <= 0) then g.finish(score) end
	end)
end

