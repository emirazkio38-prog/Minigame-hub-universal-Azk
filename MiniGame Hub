-- ULAR TANGGA
------------------------------------------------------------
local SNL_LADDER = { [3] = 22, [8] = 30, [21] = 42, [28] = 76, [50] = 67, [71] = 92, [80] = 99 }
local SNL_SNAKE = { [32] = 10, [36] = 6, [48] = 26, [62] = 18, [88] = 24, [95] = 56, [97] = 78 }

ENG.ladder = function(w, g)
	local W, H = g.W, g.H
	g.noLives = true
	g.setLives()
	local cs = math.max(14, math.floor(math.min(H - 52, W - 160) / 10))
	local bs = cs * 10
	local ox = math.floor((W - bs) / 2)            -- papan di tengah
	local oy = math.max(46, math.floor((H + 40 - bs) / 2))
	local boardF = new("Frame", { Position = UDim2.fromOffset(ox, oy), Size = UDim2.fromOffset(bs, bs), BackgroundColor3 = C(250, 245, 225), BorderSizePixel = 0 }, w)
	new("UIStroke", { Color = C(30, 30, 40), Thickness = 3, LineJoinMode = Enum.LineJoinMode.Miter }, boardF)

	local function cellXY(n)
		local r = (n - 1) // 10
		local c = (n - 1) % 10
		if r % 2 == 1 then c = 9 - c end
		return c * cs + cs / 2, (9 - r) * cs + cs / 2
	end
	for n = 1, 100 do
		local cx, cy = cellXY(n)
		local alt = ((n - 1) // 10 + (n - 1) % 10) % 2 == 0
		local col = alt and C(255, 240, 200) or C(200, 235, 210)
		if n == 100 then col = C(255, 210, 90) end
		local f = new("Frame", { Position = UDim2.fromOffset(cx - cs / 2, cy - cs / 2), Size = UDim2.fromOffset(cs, cs), BackgroundColor3 = col, BorderSizePixel = 0 }, boardF)
		label(f, tostring(n), math.max(8, cs // 3), UDim2.fromOffset(2, 1), UDim2.fromOffset(cs - 2, 12), C(90, 90, 100))
	end

	local function bar(x0, y0, x1, y1, thick, col, z)
		local dx, dy = x1 - x0, y1 - y0
		local len = math.sqrt(dx * dx + dy * dy)
		return new("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromOffset((x0 + x1) / 2, (y0 + y1) / 2), Size = UDim2.fromOffset(len, thick),
			Rotation = math.deg(atan2(dy, dx)), BackgroundColor3 = col, BorderSizePixel = 0, ZIndex = z or 2,
		}, boardF)
	end
	local function dot(x, y, d, col, z)
		local f = new("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromOffset(x, y), Size = UDim2.fromOffset(d, d), BackgroundColor3 = col, BorderSizePixel = 0, ZIndex = z or 3 }, boardF)
		new("UICorner", { CornerRadius = UDim.new(1, 0) }, f)
		return f
	end

	-- tangga: dua rel kayu yang menyambung + anak tangga
	for a, b in pairs(SNL_LADDER) do
		local x0, y0 = cellXY(a)
		local x1, y1 = cellXY(b)
		local dx, dy = x1 - x0, y1 - y0
		local len = math.sqrt(dx * dx + dy * dy)
		local ux, uy = dx / len, dy / len
		local nx, ny = -uy * cs * 0.2, ux * cs * 0.2
		bar(x0 + nx, y0 + ny, x1 + nx, y1 + ny, math.max(3, cs * 0.12), C(140, 90, 45), 2)
		bar(x0 - nx, y0 - ny, x1 - nx, y1 - ny, math.max(3, cs * 0.12), C(140, 90, 45), 2)
		local steps = math.max(3, math.floor(len / (cs * 0.55)))
		for s = 1, steps - 1 do
			local t = s / steps
			local mx, my = x0 + dx * t, y0 + dy * t
			bar(mx + nx, my + ny, mx - nx, my - ny, math.max(2, cs * 0.09), C(190, 140, 80), 2)
		end
	end
	-- ular: badan manyambung dari bola-bola kecil yang tumpang tindih, mengecil ke ekor
	local SNCOL = { C(60, 160, 70), C(210, 70, 70), C(150, 80, 200), C(235, 150, 40), C(50, 150, 200), C(200, 80, 150), C(90, 170, 60) }
	local sIdx = 0
	for a, b in pairs(SNL_SNAKE) do
		sIdx = sIdx + 1
		local x0, y0 = cellXY(a)
		local x1, y1 = cellXY(b)
		local dx, dy = x1 - x0, y1 - y0
		local len = math.sqrt(dx * dx + dy * dy)
		local px, py = -dy / len, dx / len
		local col = SNCOL[(sIdx - 1) % #SNCOL + 1]
		local dark = Color3.new(col.R * 0.7, col.G * 0.7, col.B * 0.7)
		local N = math.max(16, math.floor(len / (cs * 0.12)))
		local waves = math.max(2, math.floor(len / (cs * 1.8)))
		for k = N, 0, -1 do
			local t = k / N
			local wob = math.sin(t * math.pi * 2 * waves) * cs * 0.35 * math.sin(t * math.pi)
			local x, y = x0 + dx * t + px * wob, y0 + dy * t + py * wob
			local d = cs * (0.4 - 0.26 * t)
			dot(x, y, d, (k % 4 < 2) and col or dark, 3)
		end
		-- kepala
		local head = dot(x0, y0, cs * 0.52, col, 4)
		new("UIStroke", { Color = C(20, 20, 30), Thickness = 1.5 }, head)
		for _, ex in ipairs({ 0.2, 0.62 }) do
			local eye = new("Frame", { Position = UDim2.fromScale(ex, 0.2), Size = UDim2.fromScale(0.22, 0.22), BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0, ZIndex = 5 }, head)
			new("UICorner", { CornerRadius = UDim.new(1, 0) }, eye)
			new("Frame", { Position = UDim2.fromScale(0.3, 0.3), Size = UDim2.fromScale(0.4, 0.4), BackgroundColor3 = Color3.new(0, 0, 0), BorderSizePixel = 0, ZIndex = 6 }, eye)
		end
		new("Frame", { Position = UDim2.fromScale(0.4, 0.62), Size = UDim2.fromScale(0.2, 0.3), BackgroundColor3 = C(235, 40, 60), BorderSizePixel = 0, ZIndex = 5 }, head)
	end

	local COLP = { C(225, 65, 65), C(65, 115, 225), C(245, 205, 55), C(65, 175, 85) }
	local NAMES = { "KAMU", "BOT 1", "BOT 2", "BOT 3" }
	local pos, tok = {}, {}
	local nP = 2
	local cur, st, tm = 1, "menu", 0
	local curV, sixes, mv = 0, 0, nil
	local rollWanted, score = false, 0
	local statusLbl, diceF, diceL, rollBtn
	local errLbl = label(g.hud, "", 12, UDim2.fromOffset(8, 70), UDim2.new(1, -16, 0, 40), C(255, 120, 120))

	local function place()
		for p = 1, nP do
			local n = math.max(1, pos[p])
			local cx, cy = cellXY(n)
			local off = ({ { -0.22, -0.18 }, { 0.22, -0.18 }, { -0.22, 0.22 }, { 0.22, 0.22 } })[p]
			tok[p].Position = UDim2.fromOffset(cx + off[1] * cs, cy + off[2] * cs - 2)
		end
	end
	local function setStatus(t, col)
		statusLbl.Text = t
		if col then statusLbl.TextColor3 = col end
	end
	local function beginTurn()
		setStatus((cur == 1) and "GILIRANMU: tekan KOCOK" or ("GILIRAN " .. NAMES[cur]), COLP[cur])
		st = "roll_wait"
		rollWanted = false
		tm = (cur == 1 and not g.autoplay) and 99999 or 0.7
		rollBtn.Visible = (cur == 1 and not g.autoplay)
	end
	local function nextTurn()
		if curV == 6 and sixes < 3 then
			beginTurn()
		else
			sixes = 0
			cur = cur % nP + 1
			beginTurn()
		end
	end

	local function start(entry)
		nP = entry.n
		for p = 1, nP do
			pos[p] = 0
			local t = spr(boardF, "pawn2", math.max(1, math.floor(cs * 0.62 / 8)), COLP[p])
			t.AnchorPoint = Vector2.new(0.5, 0.5)
			t.ZIndex = 8
			tok[p] = t
		end
		local px = ox + bs + 10
		local pw = math.max(70, W - px - 6)
		statusLbl = label(g.hud, "", 13, UDim2.fromOffset(6, oy + 4), UDim2.fromOffset(math.max(60, ox - 12), 80), Color3.new(1, 1, 1))
		statusLbl.TextWrapped = true
		outline(statusLbl)
		diceF = new("Frame", { Position = UDim2.fromOffset(px + 4, oy + 54), Size = UDim2.fromOffset(52, 52), BackgroundColor3 = C(250, 250, 250), BorderSizePixel = 0 }, g.hud)
		new("UICorner", { CornerRadius = UDim.new(0.2, 0) }, diceF)
		new("UIStroke", { Color = C(30, 30, 40), Thickness = 3 }, diceF)
		diceL = label(diceF, "?", 30, UDim2.fromScale(0, 0), UDim2.fromScale(1, 1), C(30, 30, 40), Enum.TextXAlignment.Center)
		diceL.TextYAlignment = Enum.TextYAlignment.Center
		rollBtn = mkBtn(g.hud, "KOCOK", UDim2.fromOffset(px, oy + 116), UDim2.fromOffset(math.min(100, pw), 36), C(40, 150, 70))
		rollBtn.Selectable = false
		rollBtn.Visible = false
		rollBtn.Activated:Connect(function()
			if st == "roll_wait" then rollWanted = true end
		end)
		place()
		cur, sixes, curV = 1, 0, 0
		beginTurn()
	end
	openBotMenu(g, "ULAR TANGGA", {
		{ name = "LAWAN 1 BOT", sub = "2 pemain", tag = "2P", col = C(110, 220, 130), n = 2 },
		{ name = "LAWAN 2 BOT", sub = "3 pemain", tag = "3P", col = C(240, 220, 90), n = 3 },
		{ name = "LAWAN 3 BOT", sub = "4 pemain", tag = "4P", col = C(255, 150, 80), n = 4 },
	}, function(e)
		local ok, err = pcall(start, e)
		if not ok then
			errLbl.Text = "ERROR: " .. tostring(err)
			warn("[UlarTangga] " .. tostring(err))
		end
	end, false)

	local diceT = 0
	g.tick(function(dt)
		if st == "menu" or not statusLbl then return end
		if st == "roll_wait" then
			if cur == 1 and not g.autoplay then
				if rollWanted then
					rollWanted = false
					rollBtn.Visible = false
					st, tm = "rolling", 0
				end
			else
				tm = tm - dt
				if tm <= 0 then st, tm = "rolling", 0 end
			end
		elseif st == "rolling" then
			tm = tm + dt
			diceT = diceT - dt
			if diceT <= 0 then
				diceT = 0.07
				diceL.Text = tostring(math.random(1, 6))
				g.sfx("click")
			end
			if tm >= 0.55 then
				curV = math.random(1, 6)
				diceL.Text = tostring(curV)
				diceF.BackgroundColor3 = COLP[cur]
				if curV == 6 then sixes = sixes + 1 end
				if pos[cur] + curV <= 100 then
					mv = { from = pos[cur], to = pos[cur] + curV, k = 0, t = 0 }
					st = "moving"
				else
					setStatus("HARUS PAS KE 100", COLP[cur])
					st, tm = "pass", 0.9
				end
			end
		elseif st == "moving" then
			mv.t = mv.t + dt
			if mv.t >= 0.1 then
				mv.t = 0
				mv.k = mv.k + 1
				pos[cur] = mv.from + mv.k
				place()
				g.sfx("move")
				if pos[cur] >= mv.to then
					mv = nil
					local jump = SNL_LADDER[pos[cur]] or SNL_SNAKE[pos[cur]]
					if jump then
						setStatus(SNL_LADDER[pos[cur]] and "NAIK TANGGA!" or "TERGIGIT ULAR!", COLP[cur])
						g.sfx(SNL_LADDER[pos[cur]] and "win" or "hurt")
						mv = { jump = jump }
						st, tm = "jump", 0.6
					else
						st, tm = "after", 0.3
					end
				end
			end
		elseif st == "jump" then
			tm = tm - dt
			if tm <= 0 then
				pos[cur] = mv.jump
				mv = nil
				place()
				st, tm = "after", 0.5
			end
		elseif st == "after" or st == "pass" then
			tm = tm - dt
			if tm <= 0 then
				if pos[cur] == 100 then
					st, tm = "end", 1.8
					setStatus((cur == 1) and "KAMU MENANG!" or (NAMES[cur] .. " MENANG"), COLP[cur])
					g.sfx((cur == 1) and "win" or "lose")
					score = (cur == 1) and (30 + nP * 15) or 4
				else
					nextTurn()
				end
			end
		elseif st == "end" then
			tm = tm - dt
			if tm <= 0 then
				st = "done"
				g.finish(score)
			end
		end
		g.setScore(score)
	end)
end

------------------------------------------------------------
-- ENGINE: ROTATE RINGS (cincin berbentuk C saling terkunci oleh pasak; putar cincin sampai celahnya pas, pasak lepas, cincin pecah)
------------------------------------------------------------
local RING_COLORS = {
	C(55, 150, 235), C(240, 135, 40), C(140, 75, 215), C(225, 65, 75), C(60, 185, 95),
	C(35, 170, 160), C(70, 195, 245), C(40, 95, 220), C(240, 200, 60), C(235, 105, 175),
}

-- susun gugus cincin (pohon): tiap cincin menempel pada induknya lewat satu pasak di titik singgung
local function ringLayout(k, rng)
	for attempt = 1, 300 do
		local rings = { { x = 0, y = 0, r = (k >= 8) and 1.2 or 1, full = (k >= 8), edges = 0 } }
		local edges = {}
		local ok = true
		for i = 2, k do
			local placed = false
			for tryP = 1, 60 do
				local pi = rng:NextInteger(1, #rings)
				local par = rings[pi]
				local maxE = par.full and 5 or 3
				if par.edges < maxE then
					local r = 0.82 + rng:NextNumber() * 0.3
					local ang = rng:NextNumber() * math.pi * 2
					local d = (par.r + r) * 0.97
					local nx, ny = par.x + math.cos(ang) * d, par.y + math.sin(ang) * d
					local clash = false
					for j, o in ipairs(rings) do
						if j ~= pi then
							local dx, dy = nx - o.x, ny - o.y
							if math.sqrt(dx * dx + dy * dy) < (o.r + r) * 0.97 then clash = true break end
						end
					end
					-- jangan terlalu dekat dengan arah pasak lain pada induk
					if not clash then
						for _, e in ipairs(edges) do
							if e.a == pi or e.b == pi then
								local other = (e.a == pi) and rings[e.b] or rings[e.a]
								local oang = math.atan2 and math.atan2(other.y - par.y, other.x - par.x) or math.atan(other.y - par.y, other.x - par.x)
								local diff = math.abs((ang - oang + math.pi) % (math.pi * 2) - math.pi)
								if diff < 1.0 then clash = true break end
							end
						end
					end
					if not clash then
						rings[#rings + 1] = { x = nx, y = ny, r = r, full = false, edges = 1 }
						par.edges = par.edges + 1
						edges[#edges + 1] = { a = pi, b = #rings }
						placed = true
						break
					end
				end
			end
			if not placed then ok = false break end
		end
		if ok then return rings, edges end
	end
	return nil
end

ENG.rings = function(w, g)
	local W, H = g.W, g.H
	local TAU = math.pi * 2
	g.noLives = true
	g.setLives()
	local function atan2(y, x)
		if math.atan2 then return math.atan2(y, x) end
		return math.atan(y, x)
	end
	local function wrap(a) return (a + math.pi) % TAU - math.pi end
	local areaT, areaB = 58, H - 70
	local acx, acy = W / 2, (areaT + areaB) / 2
	local layer = new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = C(236, 222, 196), BorderSizePixel = 0 }, w)
	local level, score = 1, 0
	local rings, edges, chips = {}, {}, {}
	local sel, drag = nil, nil
	local state, stateT = "play", 0
	local combo, comboT = 0, 0
	local GAPW = 1.75

	local lvlLbl = label(g.hud, "Level 1", 14, UDim2.fromOffset(8, 46), UDim2.fromOffset(120, 18), C(140, 90, 60))
	local msg = label(g.hud, "", 24, UDim2.new(0.5, -170, 0, 60), UDim2.fromOffset(340, 30), C(255, 255, 255), Enum.TextXAlignment.Center)
	outline(msg)
	local msgT = 0
	local tut = label(g.hud, "Putar cincin ke posisi yang benar untuk membuka kuncinya", 12, UDim2.new(0.5, -150, 1, -66), UDim2.fromOffset(300, 30), C(140, 90, 60), Enum.TextXAlignment.Center)
	tut.TextWrapped = true
	local function say(t, col, d)
		msg.Text = t
		msg.TextColor3 = col or Color3.new(1, 1, 1)
		msgT = d or 1.4
	end

	local function covers(ring, ang)
		if ring.full then return true end
		return math.abs(wrap(ang - ring.rot)) <= ring.gapW / 2 - 0.1
	end

	local function refreshRing(r)
		local half = r.gapW / 2
		for k, f in ipairs(r.dots) do
			local a = r.dotAng[k]
			local inGap = (not r.full) and math.abs(wrap(a - r.rot)) < half
			f.Visible = not inGap
		end
	end

	local function recolor(r)
		local chosen = (r == sel)
		for _, f in ipairs(r.dots) do
			f.BackgroundColor3 = chosen and r.light or r.col
		end
	end

	local function buildRingFrames(r)
		r.dots, r.dotAng = {}, {}
		local u = r.unit
		local used = {}
		local N = math.max(40, math.floor(TAU * r.R / (u * 0.45)))
		for _, rad in ipairs({ r.R + u * 0.5, r.R - u * 0.5 }) do
			for k = 1, N do
				local a = (k - 0.5) / N * TAU
				local gx = math.floor((r.x + math.cos(a) * rad) / u + 0.5) * u
				local gy = math.floor((r.y + math.sin(a) * rad) / u + 0.5) * u
				local key = gx * 4096 + gy
				if not used[key] then
					used[key] = true
					local f = new("Frame", {
						AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromOffset(gx, gy), Size = UDim2.fromOffset(u + 1, u + 1),
						BackgroundColor3 = r.col, BorderSizePixel = 0, ZIndex = 2,
					}, layer)
					new("UIStroke", { Color = r.dark, Thickness = 1, LineJoinMode = Enum.LineJoinMode.Miter }, f)
					r.dots[#r.dots + 1] = f
					r.dotAng[#r.dots] = atan2(gy - r.y, gx - r.x)
				end
			end
		end
		refreshRing(r)
	end

	local function burst(r)
		g.sfx("win")
		for q = 1, 26 do
			local a = math.random() * TAU
			local sp = math.random(120, 320)
			local f = new("Frame", {
				AnchorPoint = Vector2.new(0.5, 0.5), Size = UDim2.fromOffset(math.random(4, 7), math.random(4, 7)), BackgroundColor3 = (math.random() < 0.5) and r.col or r.light,
				BorderSizePixel = 0, ZIndex = 6, Rotation = math.random(0, 90),
			}, layer)
			local ba = (r.dotAng[math.random(#r.dotAng)])
			chips[#chips + 1] = { f = f, x = r.x + math.cos(ba) * r.R, y = r.y + math.sin(ba) * r.R, vx = math.cos(a) * sp, vy = math.sin(a) * sp - 120, t = 0, rot = math.random(-400, 400) }
		end
		for _, f in ipairs(r.dots) do f:Destroy() end
		r.dots = {}
		r.gone = true
		score = score + 100 + 50 * combo
		combo = combo + 1
		comboT = 2
		if combo >= 3 then say("Excellent!", C(70, 200, 255), 1.2) elseif combo == 2 then say("Great!", C(120, 255, 150), 1.0) end
		if sel == r then sel = nil end
	end

	local function checkEdges()
		for _, e in ipairs(edges) do
			if not e.done then
				local A, B = rings[e.a], rings[e.b]
				if covers(A, e.angA) and covers(B, e.angB) then
					e.done = true
					e.pin:Destroy()
					A.pins = A.pins - 1
					B.pins = B.pins - 1
					g.sfx("coin")
				end
			end
		end
		for _, r in ipairs(rings) do
			if not r.gone and r.pins <= 0 then burst(r) end
		end
		local left = 0
		for _, r in ipairs(rings) do
			if not r.gone then left = left + 1 end
		end
		if left == 0 and state == "play" then
			state, stateT = "clear", 0
			local bonus = 200
			score = score + bonus
			say("You Did It! +" .. bonus, C(255, 235, 120), 2.2)
		end
	end

	local function buildLevel(n)
		for _, f in ipairs(layer:GetChildren()) do f:Destroy() end
		rings, edges, chips = {}, {}, {}
		sel, drag = nil, nil
		local counts = { 2, 3, 4, 6, 8, 10, 12 }
		local k = (n <= #counts) and counts[n] or (12 + math.min(n - #counts, 2))
		local rng = Random.new(n * 131 + 7)
		local lay, eds
		while not lay do
			lay, eds = ringLayout(k, rng)
			if not lay then k = k - 1 end
		end
		-- skala supaya muat
		local minX, maxX, minY, maxY = 1e9, -1e9, 1e9, -1e9
		for _, r in ipairs(lay) do
			minX, maxX = math.min(minX, r.x - r.r), math.max(maxX, r.x + r.r)
			minY, maxY = math.min(minY, r.y - r.r), math.max(maxY, r.y + r.r)
		end
		local sc = math.min((W - 30) / (maxX - minX), (areaB - areaT - 10) / (maxY - minY), 62)
		local midX, midY = (minX + maxX) / 2, (minY + maxY) / 2
		for i, lr in ipairs(lay) do
			local col = RING_COLORS[(i - 1) % #RING_COLORS + 1]
			if lr.full then col = C(140, 75, 215) end
			local R = lr.r * sc
			local thick = math.max(5, math.floor(R * 0.2))
			local unit = math.max(3, math.floor(thick * 0.55))
			local ring = {
				x = acx + (lr.x - midX) * sc, y = acy + (lr.y - midY) * sc, R = R, full = lr.full, thick = thick, unit = unit,
				col = col, dark = Color3.new(col.R * 0.6, col.G * 0.6, col.B * 0.6), light = Color3.new(math.min(1, col.R + 0.35), math.min(1, col.G + 0.35), math.min(1, col.B + 0.35)),
				rot = rng:NextNumber() * TAU, gapW = (n >= 5) and 1.5 or GAPW, pins = 0,
			}
			rings[i] = ring
			buildRingFrames(ring)
		end
		for _, ed in ipairs(eds) do
			local A, B = rings[ed.a], rings[ed.b]
			local ang = atan2(B.y - A.y, B.x - A.x)
			local e = { a = ed.a, b = ed.b, angA = ang, angB = wrap(ang + math.pi), done = false }
			A.pins = A.pins + 1
			B.pins = B.pins + 1
			-- titik singgung antara kedua cincin
			local t = A.R / (A.R + B.R)
			local pxx, pyy = A.x + (B.x - A.x) * t, A.y + (B.y - A.y) * t
			local len = math.max(14, math.min(A.R, B.R) * 0.55)
			local pin = new("Frame", {
				AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromOffset(pxx, pyy), Size = UDim2.fromOffset(len, math.max(5, A.thick * 0.9)),
				Rotation = math.deg(ang), BackgroundColor3 = A.dark, BorderSizePixel = 0, ZIndex = 4,
			}, layer)
			new("UIStroke", { Color = Color3.new(0, 0, 0), Thickness = 1, Transparency = 0.6 }, pin)
			local cap = new("Frame", { Position = UDim2.new(1, -4, 0, -2), Size = UDim2.new(0, 6, 1, 4), BackgroundColor3 = B.col, BorderSizePixel = 0 }, pin)
			new("UIStroke", { Color = Color3.new(0, 0, 0), Thickness = 1, LineJoinMode = Enum.LineJoinMode.Miter }, cap)
			e.pin = pin
			edges[#edges + 1] = e
		end
		-- pastikan tidak ada pasak yang sudah sejajar di awal
		for _, e in ipairs(edges) do
			local A, B = rings[e.a], rings[e.b]
			local guard = 0
			while covers(A, e.angA) and covers(B, e.angB) and guard < 20 do
				B.rot = rng:NextNumber() * TAU
				guard = guard + 1
			end
		end
		for _, r in ipairs(rings) do refreshRing(r) end
		sel = rings[1]
		recolor(sel)
		state, stateT = "play", 0
		combo, comboT = 0, 0
		lvlLbl.Text = "Level " .. n
		tut.Visible = n <= 2
		say("Level " .. n, C(255, 255, 255), 1.2)
	end

	-- kontrol: seret mengelilingi cincin, atau tombol kiri/kanan untuk cincin terpilih
	g.mkPadLR()
	local swBtn = mkBtn(g.hud, "GANTI", UDim2.new(1, -92, 1, -62), UDim2.fromOffset(82, 52), C(60, 110, 200))
	swBtn.Selectable = false
	swBtn.TextSize = 14
	local doneBtn = mkBtn(g.hud, "SELESAI", UDim2.new(1, -250, 0, 6), UDim2.fromOffset(80, 26), C(60, 140, 90))
	doneBtn.Selectable = false
	doneBtn.TextSize = 11
	doneBtn.Activated:Connect(function() g.finish(score) end)

	local function select(r)
		local old = sel
		sel = r
		if old and not old.gone then recolor(old) end
		if r then recolor(r) end
	end
	swBtn.Activated:Connect(function()
		local alive = {}
		for _, r in ipairs(rings) do
			if not r.gone then alive[#alive + 1] = r end
		end
		if #alive == 0 then return end
		local idx = 0
		for i, r in ipairs(alive) do
			if r == sel then idx = i end
		end
		select(alive[idx % #alive + 1])
		g.sfx("click")
	end)

	g.onPress(function()
		if state ~= "play" then return end
		local px, py = g.ptr.x, g.ptr.y
		local best, bd = nil, 1e9
		for _, r in ipairs(rings) do
			if not r.gone then
				local dx, dy = px - r.x, py - r.y
				local d = math.abs(math.sqrt(dx * dx + dy * dy) - r.R)
				if d < bd and d < r.R * 0.55 + r.thick then best, bd = r, d end
			end
		end
		if best then
			select(best)
			drag = { r = best, last = atan2(py - best.y, px - best.x) }
		end
	end)

	buildLevel(level)

	local nextSelCheck = 0
	g.tick(function(dt)
		if msgT > 0 then
			msgT = msgT - dt
			if msgT <= 0 then msg.Text = "" end
		end
		if comboT > 0 then
			comboT = comboT - dt
			if comboT <= 0 then combo = 0 end
		end
		-- serpihan
		for i = #chips, 1, -1 do
			local c = chips[i]
			c.t = c.t + dt
			c.vy = c.vy + 700 * dt
			c.x = c.x + c.vx * dt
			c.y = c.y + c.vy * dt
			c.f.Position = UDim2.fromOffset(c.x, c.y)
			c.f.Rotation = c.f.Rotation + c.rot * dt
			c.f.BackgroundTransparency = math.clamp((c.t - 0.5) / 0.7, 0, 1)
			if c.t > 1.3 then
				c.f:Destroy()
				table.remove(chips, i)
			end
		end
		if state == "play" then
			-- seret
			if drag and g.held and not drag.r.gone then
				local r = drag.r
				local a = atan2(g.ptr.y - r.y, g.ptr.x - r.x)
				local da = wrap(a - drag.last)
				if math.abs(da) > 0.001 then
					r.rot = (r.rot + da) % TAU
					refreshRing(r)
					checkEdges()
				end
				drag.last = a
			elseif not g.held then
				drag = nil
			end
			-- tombol kiri/kanan
			local d = g.dir()
			if d ~= 0 and sel and not sel.gone then
				sel.rot = (sel.rot + d * 2.2 * dt) % TAU
				refreshRing(sel)
				checkEdges()
			end
			if g.autoplay then
				for _, e in ipairs(edges) do
					if not e.done then
						local A, B = rings[e.a], rings[e.b]
						for _, pr in ipairs({ { A, e.angA }, { B, e.angB } }) do
							local r, target = pr[1], pr[2]
							if not r.full then r.rot = target end
							refreshRing(r)
						end
						checkEdges()
						break
					end
				end
			end
		elseif state == "clear" then
			stateT = stateT + dt
			if stateT > 2.4 then
				level = level + 1
				if level > 12 then
					g.finish(score)
					return
				end
				buildLevel(level)
			end
		end
		g.setScore(score)
	end)
end

