ENG.catch = function(w, g)
	local cfg, W, H = g.cfg, g.W, g.H
	local gy = ground(w, g, 18)
	local bf, bw, bh = spr(w, "basket", 4, skc(g))
	g.mkPadLR()
	local bx = W / 2
	local by = gy - bh
	g.lives = 3 + g.extra + (g.skin >= 2 and 1 or 0)
	g.setLives()
	local items, timer, score = {}, 0.6, 0
	local widen = g.skin * 5

	g.tick(function(dt)
		local dir = g.dir()
		if dir ~= 0 then
			bx = bx + dir * 360 * dt
		elseif not g.ptrLock then
			bx = bx + math.clamp(g.ptr.x - bx, -400 * dt, 400 * dt)
		end
		bx = math.clamp(bx, bw / 2, W - bw / 2)
		bf.Position = UDim2.fromOffset(bx - bw / 2, by)

		timer = timer - dt
		if timer <= 0 then
			timer = math.max(0.4, 1.0 - score * 0.012)
			local bad = cfg.bad and math.random() < 0.22
			local name = bad and "bomb" or cfg.good[math.random(#cfg.good)]
			local f, iw, ih = spr(w, name, 3)
			items[#items + 1] = { f = f, x = math.random(10, math.max(11, W - 50)), y = -30, w = iw, h = ih, bad = bad, v = 90 + score * 2.5 + math.random(0, 40) }
		end

		for i = #items, 1, -1 do
			local it = items[i]
			it.y = it.y + it.v * dt
			it.f.Position = UDim2.fromOffset(it.x, it.y)
			local remove = false
			if it.y + it.h >= by and it.y < by + 14 and it.x + it.w > bx - bw / 2 - widen and it.x < bx + bw / 2 + widen then
				remove = true
				if it.bad then
					g.lives = g.lives - 1
					g.setLives()
				else
					score = score + 1
					g.setScore(score)
				end
			elseif it.y > gy then
				remove = true
				if not it.bad then
					g.lives = g.lives - 1
					g.setLives()
				end
			end
			if remove then
				it.f:Destroy()
				table.remove(items, i)
			end
		end
		if g.lives <= 0 then g.finish(score) end
	end)
end

